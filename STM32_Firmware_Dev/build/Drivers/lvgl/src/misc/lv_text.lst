 552:Drivers/lvgl/src/misc/lv_text.c ****     size_t old_len = lv_strlen(txt);
 553:Drivers/lvgl/src/misc/lv_text.c **** 
 554:Drivers/lvgl/src/misc/lv_text.c ****     pos = lv_text_encoded_get_byte_id(txt, pos); /*Convert to byte index instead of letter index*/
 555:Drivers/lvgl/src/misc/lv_text.c ****     if(pos >= old_len) return;
