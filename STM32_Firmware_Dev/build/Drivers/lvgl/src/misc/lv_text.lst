 559:Drivers/lvgl/src/misc/lv_text.c **** 
 560:Drivers/lvgl/src/misc/lv_text.c ****     /*Copy the second part into the end to make place to text to insert*/
 561:Drivers/lvgl/src/misc/lv_text.c ****     uint32_t i;
 562:Drivers/lvgl/src/misc/lv_text.c ****     for(i = pos; i <= old_len - len; i++) {
 563:Drivers/lvgl/src/misc/lv_text.c ****         txt[i] = txt[i + len];
 564:Drivers/lvgl/src/misc/lv_text.c ****     }
 565:Drivers/lvgl/src/misc/lv_text.c **** }
