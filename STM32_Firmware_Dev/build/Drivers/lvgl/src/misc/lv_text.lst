 686:Drivers/lvgl/src/misc/lv_text.c **** /**
 687:Drivers/lvgl/src/misc/lv_text.c ****  * Convert a wide character, e.g. 'Á' little endian to be UTF-8 compatible
 688:Drivers/lvgl/src/misc/lv_text.c ****  * @param c a wide character or a  Little endian number
 689:Drivers/lvgl/src/misc/lv_text.c ****  * @return `c` in big endian
 690:Drivers/lvgl/src/misc/lv_text.c ****  */
 691:Drivers/lvgl/src/misc/lv_text.c **** static uint32_t lv_text_utf8_conv_wc(uint32_t c)
 692:Drivers/lvgl/src/misc/lv_text.c **** {
 693:Drivers/lvgl/src/misc/lv_text.c **** #if LV_BIG_ENDIAN_SYSTEM == 0
 694:Drivers/lvgl/src/misc/lv_text.c ****     /*Swap the bytes (UTF-8 is big endian, but the MCUs are little endian)*/
 695:Drivers/lvgl/src/misc/lv_text.c ****     if((c & 0x80) != 0) {
 696:Drivers/lvgl/src/misc/lv_text.c ****         uint32_t swapped;
 697:Drivers/lvgl/src/misc/lv_text.c ****         uint8_t c8[4];
 698:Drivers/lvgl/src/misc/lv_text.c ****         lv_memcpy(c8, &c, 4);
 699:Drivers/lvgl/src/misc/lv_text.c ****         swapped = (c8[0] << 24) + (c8[1] << 16) + (c8[2] << 8) + (c8[3]);
 700:Drivers/lvgl/src/misc/lv_text.c ****         uint8_t i;
 701:Drivers/lvgl/src/misc/lv_text.c ****         for(i = 0; i < 4; i++) {
 702:Drivers/lvgl/src/misc/lv_text.c ****             if((swapped & 0xFF) == 0)
 703:Drivers/lvgl/src/misc/lv_text.c ****                 swapped = (swapped >> 8); /*Ignore leading zeros (they were in the end originally)*
 704:Drivers/lvgl/src/misc/lv_text.c ****         }
 705:Drivers/lvgl/src/misc/lv_text.c ****         c = swapped;
 706:Drivers/lvgl/src/misc/lv_text.c ****     }
 707:Drivers/lvgl/src/misc/lv_text.c **** #endif
 708:Drivers/lvgl/src/misc/lv_text.c ****     return c;
 709:Drivers/lvgl/src/misc/lv_text.c **** }
