 167:Drivers/lvgl/src/misc/lv_text_private.h **** 
 168:Drivers/lvgl/src/misc/lv_text_private.h ****     /*Compare the letter to TXT_BREAK_CHARS*/
 169:Drivers/lvgl/src/misc/lv_text_private.h ****     for(i = 0; LV_TXT_BREAK_CHARS[i] != '\0'; i++) {
 170:Drivers/lvgl/src/misc/lv_text_private.h ****         if(letter == (uint32_t)LV_TXT_BREAK_CHARS[i]) {
 171:Drivers/lvgl/src/misc/lv_text_private.h ****             ret = true; /*If match then it is break char*/
 172:Drivers/lvgl/src/misc/lv_text_private.h ****             break;
