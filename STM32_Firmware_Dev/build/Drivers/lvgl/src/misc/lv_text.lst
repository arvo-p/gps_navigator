 242:Drivers/lvgl/src/misc/lv_text_private.h **** /**
 243:Drivers/lvgl/src/misc/lv_text_private.h ****  * Test if character can be treated as marker, and don't need to be rendered.
 244:Drivers/lvgl/src/misc/lv_text_private.h ****  * Note, this is not a full list. Add your findings to the list.
 245:Drivers/lvgl/src/misc/lv_text_private.h ****  *
 246:Drivers/lvgl/src/misc/lv_text_private.h ****  * @param letter a letter
 247:Drivers/lvgl/src/misc/lv_text_private.h ****  * @return true if so
 248:Drivers/lvgl/src/misc/lv_text_private.h ****  */
 249:Drivers/lvgl/src/misc/lv_text_private.h **** static inline bool lv_text_is_marker(uint32_t letter)
 250:Drivers/lvgl/src/misc/lv_text_private.h **** {
 251:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter < 0x20) return true;
 252:Drivers/lvgl/src/misc/lv_text_private.h **** 
 253:Drivers/lvgl/src/misc/lv_text_private.h ****     /*U+061C ARABIC LETTER MARK, see https://www.compart.com/en/unicode/block/U+0600*/
 254:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter == 0x061C) return true;
 255:Drivers/lvgl/src/misc/lv_text_private.h **** 
 256:Drivers/lvgl/src/misc/lv_text_private.h ****     /*U+115F HANGUL CHOSEONG FILLER, See https://www.compart.com/en/unicode/block/U+1100*/
 257:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter == 0x115F) return true;
 258:Drivers/lvgl/src/misc/lv_text_private.h ****     /*U+1160 HANGUL JUNGSEONG FILLER*/
 259:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter == 0x1160) return true;
 260:Drivers/lvgl/src/misc/lv_text_private.h **** 
 261:Drivers/lvgl/src/misc/lv_text_private.h ****     /*See https://www.compart.com/en/unicode/block/U+1800*/
 262:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter >= 0x180B && letter <= 0x180E) return true;
 263:Drivers/lvgl/src/misc/lv_text_private.h **** 
 264:Drivers/lvgl/src/misc/lv_text_private.h ****     /*See https://www.compart.com/en/unicode/block/U+2000*/
 265:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter >= 0x200B && letter <= 0x200F) return true;
 266:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter >= 0x2028 && letter <= 0x202F) return true;
 267:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter >= 0x205F && letter <= 0x206F) return true;
 268:Drivers/lvgl/src/misc/lv_text_private.h **** 
 269:Drivers/lvgl/src/misc/lv_text_private.h ****     /*U+FEFF ZERO WIDTH NO-BREAK SPACE, see https://www.compart.com/en/unicode/block/U+FE70*/
 270:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter == 0xFEFF) return true;
 271:Drivers/lvgl/src/misc/lv_text_private.h **** 
 272:Drivers/lvgl/src/misc/lv_text_private.h ****     if(letter == 0xF8FF) return true; /*LV_SYMBOL_DUMMY*/
 273:Drivers/lvgl/src/misc/lv_text_private.h **** 
 274:Drivers/lvgl/src/misc/lv_text_private.h ****     return false;
 275:Drivers/lvgl/src/misc/lv_text_private.h **** }
