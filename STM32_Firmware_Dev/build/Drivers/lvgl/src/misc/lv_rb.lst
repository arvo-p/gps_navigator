 103:Drivers/lvgl/src/misc/lv_rb.c **** lv_rb_node_t * lv_rb_find(lv_rb_t * tree, const void * key)
 104:Drivers/lvgl/src/misc/lv_rb.c **** {
 105:Drivers/lvgl/src/misc/lv_rb.c ****     LV_ASSERT_NULL(tree);
 106:Drivers/lvgl/src/misc/lv_rb.c ****     if(tree == NULL) {
 107:Drivers/lvgl/src/misc/lv_rb.c ****         return NULL;
 108:Drivers/lvgl/src/misc/lv_rb.c ****     }
 109:Drivers/lvgl/src/misc/lv_rb.c **** 
 110:Drivers/lvgl/src/misc/lv_rb.c ****     lv_rb_node_t * current = tree->root;
 111:Drivers/lvgl/src/misc/lv_rb.c **** 
 112:Drivers/lvgl/src/misc/lv_rb.c ****     while(current != NULL) {
 113:Drivers/lvgl/src/misc/lv_rb.c ****         lv_rb_compare_res_t cmp = tree->compare(key, current->data);
 114:Drivers/lvgl/src/misc/lv_rb.c **** 
 115:Drivers/lvgl/src/misc/lv_rb.c ****         if(cmp == 0) {
 116:Drivers/lvgl/src/misc/lv_rb.c ****             return current;
 117:Drivers/lvgl/src/misc/lv_rb.c ****         }
 118:Drivers/lvgl/src/misc/lv_rb.c ****         else if(cmp < 0) {
 119:Drivers/lvgl/src/misc/lv_rb.c ****             current = current->left;
 120:Drivers/lvgl/src/misc/lv_rb.c ****         }
 121:Drivers/lvgl/src/misc/lv_rb.c ****         else {
 122:Drivers/lvgl/src/misc/lv_rb.c ****             current = current->right;
 123:Drivers/lvgl/src/misc/lv_rb.c ****         }
 124:Drivers/lvgl/src/misc/lv_rb.c ****     }
 125:Drivers/lvgl/src/misc/lv_rb.c **** 
 126:Drivers/lvgl/src/misc/lv_rb.c ****     return NULL;
 127:Drivers/lvgl/src/misc/lv_rb.c **** }
