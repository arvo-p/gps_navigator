 330:Drivers/lvgl/src/misc/lv_anim.c **** int32_t lv_anim_path_bounce(const lv_anim_t * a)
 331:Drivers/lvgl/src/misc/lv_anim.c **** {
 332:Drivers/lvgl/src/misc/lv_anim.c ****     LV_CHECK_ARG(a != NULL, return 0);
 333:Drivers/lvgl/src/misc/lv_anim.c ****     /*Calculate the current step*/
 334:Drivers/lvgl/src/misc/lv_anim.c ****     int32_t t = lv_map(a->act_time, 0, a->duration, 0, LV_BEZIER_VAL_MAX);
 335:Drivers/lvgl/src/misc/lv_anim.c ****     int32_t diff = (a->end_value - a->start_value);
 336:Drivers/lvgl/src/misc/lv_anim.c **** 
 337:Drivers/lvgl/src/misc/lv_anim.c ****     /*3 bounces has 5 parts: 3 down and 2 up. One part is t / 5 long*/
 338:Drivers/lvgl/src/misc/lv_anim.c **** 
 339:Drivers/lvgl/src/misc/lv_anim.c ****     if(t < 408) {
 340:Drivers/lvgl/src/misc/lv_anim.c ****         /*Go down*/
 341:Drivers/lvgl/src/misc/lv_anim.c ****         t = (t * 2500) >> LV_BEZIER_VAL_SHIFT; /*[0..1024] range*/
 342:Drivers/lvgl/src/misc/lv_anim.c ****         t = LV_BEZIER_VAL_MAX - t;
 343:Drivers/lvgl/src/misc/lv_anim.c ****     }
 344:Drivers/lvgl/src/misc/lv_anim.c ****     else if(t >= 408 && t < 614) {
 345:Drivers/lvgl/src/misc/lv_anim.c ****         /*First bounce back*/
 346:Drivers/lvgl/src/misc/lv_anim.c ****         t -= 408;
 347:Drivers/lvgl/src/misc/lv_anim.c ****         t    = t * 5; /*to [0..1024] range*/
 348:Drivers/lvgl/src/misc/lv_anim.c ****         diff = diff / 20;
 349:Drivers/lvgl/src/misc/lv_anim.c ****     }
 350:Drivers/lvgl/src/misc/lv_anim.c ****     else if(t >= 614 && t < 819) {
 351:Drivers/lvgl/src/misc/lv_anim.c ****         /*Fall back*/
 352:Drivers/lvgl/src/misc/lv_anim.c ****         t -= 614;
 353:Drivers/lvgl/src/misc/lv_anim.c ****         t    = t * 5; /*to [0..1024] range*/
 354:Drivers/lvgl/src/misc/lv_anim.c ****         t    = LV_BEZIER_VAL_MAX - t;
 355:Drivers/lvgl/src/misc/lv_anim.c ****         diff = diff / 20;
 356:Drivers/lvgl/src/misc/lv_anim.c ****     }
 357:Drivers/lvgl/src/misc/lv_anim.c ****     else if(t >= 819 && t < 921) {
 358:Drivers/lvgl/src/misc/lv_anim.c ****         /*Second bounce back*/
 359:Drivers/lvgl/src/misc/lv_anim.c ****         t -= 819;
 360:Drivers/lvgl/src/misc/lv_anim.c ****         t    = t * 10; /*to [0..1024] range*/
 361:Drivers/lvgl/src/misc/lv_anim.c ****         diff = diff / 40;
 362:Drivers/lvgl/src/misc/lv_anim.c ****     }
 363:Drivers/lvgl/src/misc/lv_anim.c ****     else if(t >= 921 && t <= LV_BEZIER_VAL_MAX) {
 364:Drivers/lvgl/src/misc/lv_anim.c ****         /*Fall back*/
 365:Drivers/lvgl/src/misc/lv_anim.c ****         t -= 921;
 366:Drivers/lvgl/src/misc/lv_anim.c ****         t    = t * 10; /*to [0..1024] range*/
 367:Drivers/lvgl/src/misc/lv_anim.c ****         t    = LV_BEZIER_VAL_MAX - t;
 368:Drivers/lvgl/src/misc/lv_anim.c ****         diff = diff / 40;
 369:Drivers/lvgl/src/misc/lv_anim.c ****     }
 370:Drivers/lvgl/src/misc/lv_anim.c **** 
 371:Drivers/lvgl/src/misc/lv_anim.c ****     if(t > LV_BEZIER_VAL_MAX) t = LV_BEZIER_VAL_MAX;
 372:Drivers/lvgl/src/misc/lv_anim.c ****     if(t < 0) t = 0;
