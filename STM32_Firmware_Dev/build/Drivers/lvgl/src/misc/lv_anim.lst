 373:Drivers/lvgl/src/misc/lv_anim.c ****     int32_t step = lv_bezier3(t, 0, 500, 800, LV_BEZIER_VAL_MAX);
 374:Drivers/lvgl/src/misc/lv_anim.c **** 
 375:Drivers/lvgl/src/misc/lv_anim.c ****     int32_t new_value;
 376:Drivers/lvgl/src/misc/lv_anim.c ****     new_value = step * diff;
 377:Drivers/lvgl/src/misc/lv_anim.c ****     new_value = new_value >> LV_BEZIER_VAL_SHIFT;
 378:Drivers/lvgl/src/misc/lv_anim.c ****     new_value = a->end_value - new_value;
 379:Drivers/lvgl/src/misc/lv_anim.c **** 
 380:Drivers/lvgl/src/misc/lv_anim.c ****     return new_value;
 381:Drivers/lvgl/src/misc/lv_anim.c **** }
