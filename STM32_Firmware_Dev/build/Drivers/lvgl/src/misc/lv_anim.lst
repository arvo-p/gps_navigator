 193:Drivers/lvgl/src/misc/lv_anim.c ****                                        the linked list*/
 194:Drivers/lvgl/src/misc/lv_anim.c ****             del_any = true;
 195:Drivers/lvgl/src/misc/lv_anim.c ****             del = true;
