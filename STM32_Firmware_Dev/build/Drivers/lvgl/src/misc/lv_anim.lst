 128:Drivers/lvgl/src/misc/lv_anim.c ****     /*Add the new animation to the animation linked list*/
 129:Drivers/lvgl/src/misc/lv_anim.c ****     lv_anim_t * new_anim = lv_ll_ins_head(anim_ll_p);
 130:Drivers/lvgl/src/misc/lv_anim.c ****     LV_ASSERT_MALLOC(new_anim);
 131:Drivers/lvgl/src/misc/lv_anim.c ****     if(new_anim == NULL) return NULL;
 132:Drivers/lvgl/src/misc/lv_anim.c **** 
 133:Drivers/lvgl/src/misc/lv_anim.c ****     /*Initialize the animation descriptor*/
 134:Drivers/lvgl/src/misc/lv_anim.c ****     lv_memcpy(new_anim, a, sizeof(lv_anim_t));
 135:Drivers/lvgl/src/misc/lv_anim.c ****     if(a->var == a) new_anim->var = new_anim;
 136:Drivers/lvgl/src/misc/lv_anim.c ****     new_anim->run_round = state.anim_run_round;
 137:Drivers/lvgl/src/misc/lv_anim.c ****     new_anim->last_timer_run = lv_tick_get();
 138:Drivers/lvgl/src/misc/lv_anim.c ****     new_anim->is_paused = false;
 139:Drivers/lvgl/src/misc/lv_anim.c **** 
 140:Drivers/lvgl/src/misc/lv_anim.c ****     /*Set the start value*/
 141:Drivers/lvgl/src/misc/lv_anim.c ****     if(new_anim->early_apply) {
 142:Drivers/lvgl/src/misc/lv_anim.c ****         if(new_anim->get_value_cb) {
 143:Drivers/lvgl/src/misc/lv_anim.c ****             int32_t v_ofs = new_anim->get_value_cb(new_anim);
