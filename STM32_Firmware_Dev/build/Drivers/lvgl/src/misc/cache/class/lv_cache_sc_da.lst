 433:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c **** 
 434:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****     LV_ASSERT_NULL(da);
 435:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****     /*
 436:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * We iterate twice to handle the complexity introduced by reference counting
 437:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * in the second chance algorithm:
 438:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          *
 439:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * First iteration: Clear second chance bits and look for victims (entries with
 440:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * sec_chance=0 AND refs=0). Some entries may have sec_chance=0 but refs>0,
 441:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * making them unavailable for eviction despite being marked for removal.
 442:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          *
 443:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * Second iteration: Now that all second chance bits are cleared from the first
 444:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * pass, we can find entries that are truly available for eviction (refs=0).
 445:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * We can't assume the first entry will be the victim after the first round
 446:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * because reference counts may prevent eviction of otherwise eligible entries.
 447:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          *
 448:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * This ensures we give all entries a proper second chance while respecting
 449:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          * active references that prevent immediate eviction.
 450:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****          */
 451:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****     for(size_t i = 0; i < 2; ++i) {
 452:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****         for(size_t j = 0; j < da->cache.size; ++j) {
 453:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****             lv_cache_entry_t * victim = get_possible_victim(da, j);
 454:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****             if(victim) {
 455:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****                 return victim;
 456:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****             }
 457:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****         }
 458:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****     }
 459:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c ****     return NULL;
 460:Drivers/lvgl/src/misc/cache/class/lv_cache_sc_da.c **** }
