 334:Drivers/lvgl/src/misc/lv_timer.c **** /**
 335:Drivers/lvgl/src/misc/lv_timer.c ****  * Execute timer if its remaining time is zero
 336:Drivers/lvgl/src/misc/lv_timer.c ****  * @param timer pointer to lv_timer
 337:Drivers/lvgl/src/misc/lv_timer.c ****  * @return true: execute, false: not executed
 338:Drivers/lvgl/src/misc/lv_timer.c ****  */
 339:Drivers/lvgl/src/misc/lv_timer.c **** static bool lv_timer_exec(lv_timer_t * timer)
 340:Drivers/lvgl/src/misc/lv_timer.c **** {
 341:Drivers/lvgl/src/misc/lv_timer.c ****     if(timer->paused) return false;
 342:Drivers/lvgl/src/misc/lv_timer.c **** 
 343:Drivers/lvgl/src/misc/lv_timer.c ****     bool exec = false;
 344:Drivers/lvgl/src/misc/lv_timer.c ****     if(lv_timer_time_remaining(timer) == 0) {
 345:Drivers/lvgl/src/misc/lv_timer.c ****         /* Decrement the repeat count before executing the timer_cb.
 346:Drivers/lvgl/src/misc/lv_timer.c ****          * If any timer is deleted `if(timer->repeat_count == 0)` is not executed below
 347:Drivers/lvgl/src/misc/lv_timer.c ****          * but at least the repeat count is zero and the timer can be deleted in the next round*/
 348:Drivers/lvgl/src/misc/lv_timer.c ****         int32_t original_repeat_count = timer->repeat_count;
 349:Drivers/lvgl/src/misc/lv_timer.c ****         if(timer->repeat_count > 0) timer->repeat_count--;
 350:Drivers/lvgl/src/misc/lv_timer.c ****         timer->last_run = lv_tick_get();
 351:Drivers/lvgl/src/misc/lv_timer.c ****         LV_TRACE_TIMER("calling timer callback: %p", *((void **)&timer->timer_cb));
 352:Drivers/lvgl/src/misc/lv_timer.c **** 
 353:Drivers/lvgl/src/misc/lv_timer.c ****         if(timer->timer_cb && original_repeat_count != 0) {
 354:Drivers/lvgl/src/misc/lv_timer.c ****             LV_PROFILER_TIMER_BEGIN_TAG("timer_cb");
 355:Drivers/lvgl/src/misc/lv_timer.c ****             timer->timer_cb(timer);
 356:Drivers/lvgl/src/misc/lv_timer.c ****             LV_PROFILER_TIMER_END_TAG("timer_cb");
 357:Drivers/lvgl/src/misc/lv_timer.c ****         }
 358:Drivers/lvgl/src/misc/lv_timer.c **** 
 359:Drivers/lvgl/src/misc/lv_timer.c ****         if(!state.timer_deleted) {
 360:Drivers/lvgl/src/misc/lv_timer.c ****             LV_TRACE_TIMER("timer callback %p finished", *((void **)&timer->timer_cb));
 361:Drivers/lvgl/src/misc/lv_timer.c ****         }
 362:Drivers/lvgl/src/misc/lv_timer.c ****         else {
 363:Drivers/lvgl/src/misc/lv_timer.c ****             LV_TRACE_TIMER("timer callback finished");
 364:Drivers/lvgl/src/misc/lv_timer.c ****         }
 365:Drivers/lvgl/src/misc/lv_timer.c **** 
 366:Drivers/lvgl/src/misc/lv_timer.c ****         LV_ASSERT_MEM_INTEGRITY();
 367:Drivers/lvgl/src/misc/lv_timer.c ****         exec = true;
 368:Drivers/lvgl/src/misc/lv_timer.c ****     }
 369:Drivers/lvgl/src/misc/lv_timer.c **** 
 370:Drivers/lvgl/src/misc/lv_timer.c ****     if(state.timer_deleted == false) { /*The timer might be deleted by itself as well*/
 371:Drivers/lvgl/src/misc/lv_timer.c ****         if(timer->repeat_count == 0) { /*The repeat count is over, delete the timer*/
 372:Drivers/lvgl/src/misc/lv_timer.c ****             if(timer->auto_delete) {
 373:Drivers/lvgl/src/misc/lv_timer.c ****                 LV_TRACE_TIMER("deleting timer with %p callback because the repeat count is over", 
ARM GAS  /tmp/ccY2ip0Q.s 			page 8


 374:Drivers/lvgl/src/misc/lv_timer.c ****                 lv_timer_delete(timer);
 375:Drivers/lvgl/src/misc/lv_timer.c ****             }
 376:Drivers/lvgl/src/misc/lv_timer.c ****             else {
 377:Drivers/lvgl/src/misc/lv_timer.c ****                 LV_TRACE_TIMER("pausing timer with %p callback because the repeat count is over", *
 378:Drivers/lvgl/src/misc/lv_timer.c ****                 lv_timer_pause(timer);
 379:Drivers/lvgl/src/misc/lv_timer.c ****             }
 380:Drivers/lvgl/src/misc/lv_timer.c ****         }
 381:Drivers/lvgl/src/misc/lv_timer.c ****     }
 382:Drivers/lvgl/src/misc/lv_timer.c **** 
 383:Drivers/lvgl/src/misc/lv_timer.c ****     return exec;
 384:Drivers/lvgl/src/misc/lv_timer.c **** }
