 128:Drivers/lvgl/src/misc/lv_iter.c **** 
 129:Drivers/lvgl/src/misc/lv_iter.c ****     if(c_buf != NULL) iter->peek_offset = 0;
 130:Drivers/lvgl/src/misc/lv_iter.c **** 
 131:Drivers/lvgl/src/misc/lv_iter.c ****     return iter_res;
 132:Drivers/lvgl/src/misc/lv_iter.c **** }
