  78:Drivers/lvgl/src/misc/lv_anim_timeline.c **** 
  79:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     if((!at->reverse && at->act_time == 0) || (at->reverse && at->act_time == playtime)) {
  80:Drivers/lvgl/src/misc/lv_anim_timeline.c ****         for(uint32_t i = 0; i < at->anim_dsc_cnt; i++) {
  81:Drivers/lvgl/src/misc/lv_anim_timeline.c ****             at->anim_dsc[i].is_started   = 0;
  82:Drivers/lvgl/src/misc/lv_anim_timeline.c ****             at->anim_dsc[i].is_completed = 0;
  83:Drivers/lvgl/src/misc/lv_anim_timeline.c ****         }
  84:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     }
  85:Drivers/lvgl/src/misc/lv_anim_timeline.c **** 
  86:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     /*Always animate the whole 0..playtime range in `playtime` ms and seek into it if
  87:Drivers/lvgl/src/misc/lv_anim_timeline.c ****      *the timeline is not at its beginning. Starting the animation at `act_time`
ARM GAS  /tmp/cciZ3WDq.s 			page 3


  88:Drivers/lvgl/src/misc/lv_anim_timeline.c ****      *instead would shorten it, and as a repeat replays the same values, every later
  89:Drivers/lvgl/src/misc/lv_anim_timeline.c ****      *repeat would keep playing only that remaining part.*/
  90:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_t a;
  91:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_init(&a);
  92:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_set_var(&a, at);
  93:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_set_exec_cb(&a, anim_timeline_exec_cb);
  94:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     if(at->reverse) lv_anim_set_values(&a, playtime, 0);
  95:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     else lv_anim_set_values(&a, 0, playtime);
  96:Drivers/lvgl/src/misc/lv_anim_timeline.c **** 
  97:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_set_duration(&a, playtime);
  98:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_set_path_cb(&a, anim_timeline_path_cb);
  99:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_set_repeat_count(&a, at->repeat_count);
 100:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_set_repeat_delay(&a, at->repeat_delay);
 101:Drivers/lvgl/src/misc/lv_anim_timeline.c **** 
 102:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     /*How much of the timeline has already played. A reversed one counts from its end.*/
 103:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     uint32_t elapsed = at->reverse ? playtime - at->act_time : at->act_time;
 104:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     if(elapsed == 0) {
 105:Drivers/lvgl/src/misc/lv_anim_timeline.c ****         /*Apply the delay only if playing from any ends*/
 106:Drivers/lvgl/src/misc/lv_anim_timeline.c ****         lv_anim_set_delay(&a, at->delay);
 107:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     }
 108:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     else {
 109:Drivers/lvgl/src/misc/lv_anim_timeline.c ****         /*`lv_anim_set_delay()` writes act_time as well, so seek after it*/
 110:Drivers/lvgl/src/misc/lv_anim_timeline.c ****         a.act_time = (int32_t)elapsed;
 111:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     }
 112:Drivers/lvgl/src/misc/lv_anim_timeline.c **** 
 113:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     lv_anim_start(&a);
 114:Drivers/lvgl/src/misc/lv_anim_timeline.c **** 
 115:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     return playtime;
 116:Drivers/lvgl/src/misc/lv_anim_timeline.c **** }
