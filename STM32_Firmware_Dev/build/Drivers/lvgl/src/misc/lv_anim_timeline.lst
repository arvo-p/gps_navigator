 342:Drivers/lvgl/src/misc/lv_anim_timeline.c ****      *descriptor whose `start_time` falls between two steps from starting.*/
 343:Drivers/lvgl/src/misc/lv_anim_timeline.c ****     return lv_map(a->act_time, 0, a->duration, a->start_value, a->end_value);
 344:Drivers/lvgl/src/misc/lv_anim_timeline.c **** }
