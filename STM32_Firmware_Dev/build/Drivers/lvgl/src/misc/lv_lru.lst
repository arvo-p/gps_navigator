 100:Drivers/lvgl/src/misc/lv_lru.c ****     // free each of the cached items, and the hash table
 101:Drivers/lvgl/src/misc/lv_lru.c ****     lv_lru_item_t * item = NULL, * next = NULL;
 102:Drivers/lvgl/src/misc/lv_lru.c ****     uint32_t i = 0;
 103:Drivers/lvgl/src/misc/lv_lru.c ****     if(cache->items) {
 104:Drivers/lvgl/src/misc/lv_lru.c ****         for(; i < cache->hash_table_size; i++) {
 105:Drivers/lvgl/src/misc/lv_lru.c ****             item = cache->items[i];
 106:Drivers/lvgl/src/misc/lv_lru.c ****             while(item) {
 107:Drivers/lvgl/src/misc/lv_lru.c ****                 next = (lv_lru_item_t *) item->next;
 108:Drivers/lvgl/src/misc/lv_lru.c ****                 cache->value_free(item->value);
 109:Drivers/lvgl/src/misc/lv_lru.c ****                 cache->key_free(item->key);
 110:Drivers/lvgl/src/misc/lv_lru.c ****                 cache->free_memory += item->value_length;
 111:Drivers/lvgl/src/misc/lv_lru.c ****                 lv_free(item);
 112:Drivers/lvgl/src/misc/lv_lru.c ****                 item = next;
 113:Drivers/lvgl/src/misc/lv_lru.c ****             }
 114:Drivers/lvgl/src/misc/lv_lru.c ****         }
 115:Drivers/lvgl/src/misc/lv_lru.c ****         lv_free(cache->items);
 116:Drivers/lvgl/src/misc/lv_lru.c ****     }
 117:Drivers/lvgl/src/misc/lv_lru.c **** 
 118:Drivers/lvgl/src/misc/lv_lru.c ****     if(cache->free_items) {
