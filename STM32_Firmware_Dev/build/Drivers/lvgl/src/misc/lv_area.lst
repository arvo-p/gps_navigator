 100:Drivers/lvgl/src/misc/lv_area.c **** bool lv_area_intersect(lv_area_t * res_p, const lv_area_t * a1_p, const lv_area_t * a2_p)
 101:Drivers/lvgl/src/misc/lv_area.c **** {
 102:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(res_p != NULL, return false);
 103:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a1_p != NULL, return false);
 104:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a2_p != NULL, return false);
 105:Drivers/lvgl/src/misc/lv_area.c ****     /*Get the smaller area from 'a1_p' and 'a2_p'*/
 106:Drivers/lvgl/src/misc/lv_area.c ****     res_p->x1 = LV_MAX(a1_p->x1, a2_p->x1);
 107:Drivers/lvgl/src/misc/lv_area.c ****     res_p->y1 = LV_MAX(a1_p->y1, a2_p->y1);
 108:Drivers/lvgl/src/misc/lv_area.c ****     res_p->x2 = LV_MIN(a1_p->x2, a2_p->x2);
 109:Drivers/lvgl/src/misc/lv_area.c ****     res_p->y2 = LV_MIN(a1_p->y2, a2_p->y2);
 110:Drivers/lvgl/src/misc/lv_area.c **** 
 111:Drivers/lvgl/src/misc/lv_area.c ****     /*If x1 or y1 greater than x2 or y2 then the areas union is empty*/
 112:Drivers/lvgl/src/misc/lv_area.c ****     bool union_ok = true;
 113:Drivers/lvgl/src/misc/lv_area.c ****     if((res_p->x1 > res_p->x2) || (res_p->y1 > res_p->y2)) {
 114:Drivers/lvgl/src/misc/lv_area.c ****         union_ok = false;
 115:Drivers/lvgl/src/misc/lv_area.c ****     }
 116:Drivers/lvgl/src/misc/lv_area.c **** 
 117:Drivers/lvgl/src/misc/lv_area.c ****     return union_ok;
 118:Drivers/lvgl/src/misc/lv_area.c **** }
