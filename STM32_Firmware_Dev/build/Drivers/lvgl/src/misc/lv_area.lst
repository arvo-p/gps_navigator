 188:Drivers/lvgl/src/misc/lv_area.c **** void lv_area_join(lv_area_t * a_res_p, const lv_area_t * a1_p, const lv_area_t * a2_p)
 189:Drivers/lvgl/src/misc/lv_area.c **** {
 190:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a_res_p != NULL, return);
 191:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a1_p != NULL, return);
 192:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a2_p != NULL, return);
