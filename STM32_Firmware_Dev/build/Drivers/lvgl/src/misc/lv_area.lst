 199:Drivers/lvgl/src/misc/lv_area.c **** bool lv_area_is_point_on(const lv_area_t * a_p, const lv_point_t * p_p, int32_t radius)
 200:Drivers/lvgl/src/misc/lv_area.c **** {
 201:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a_p != NULL, return false);
ARM GAS  /tmp/cciRu8Lx.s 			page 5


 202:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(p_p != NULL, return false);
 203:Drivers/lvgl/src/misc/lv_area.c ****     /*First check the basic area*/
 204:Drivers/lvgl/src/misc/lv_area.c ****     bool is_on_rect = false;
 205:Drivers/lvgl/src/misc/lv_area.c ****     if((p_p->x >= a_p->x1 && p_p->x <= a_p->x2) && ((p_p->y >= a_p->y1 && p_p->y <= a_p->y2))) {
 206:Drivers/lvgl/src/misc/lv_area.c ****         is_on_rect = true;
 207:Drivers/lvgl/src/misc/lv_area.c ****     }
 208:Drivers/lvgl/src/misc/lv_area.c ****     if(!is_on_rect)
 209:Drivers/lvgl/src/misc/lv_area.c ****         return false;
 210:Drivers/lvgl/src/misc/lv_area.c ****     /*Now handle potential rounded rectangles*/
 211:Drivers/lvgl/src/misc/lv_area.c ****     if(radius <= 0) {
 212:Drivers/lvgl/src/misc/lv_area.c ****         /*No radius, it is within the rectangle*/
 213:Drivers/lvgl/src/misc/lv_area.c ****         return true;
 214:Drivers/lvgl/src/misc/lv_area.c ****     }
 215:Drivers/lvgl/src/misc/lv_area.c ****     int32_t w = lv_area_get_width(a_p) / 2;
 216:Drivers/lvgl/src/misc/lv_area.c ****     int32_t h = lv_area_get_height(a_p) / 2;
 217:Drivers/lvgl/src/misc/lv_area.c ****     int32_t max_radius = LV_MIN(w, h);
 218:Drivers/lvgl/src/misc/lv_area.c ****     if(radius > max_radius)
 219:Drivers/lvgl/src/misc/lv_area.c ****         radius = max_radius;
 220:Drivers/lvgl/src/misc/lv_area.c **** 
 221:Drivers/lvgl/src/misc/lv_area.c ****     /*Check if it's in one of the corners*/
 222:Drivers/lvgl/src/misc/lv_area.c ****     lv_area_t corner_area;
 223:Drivers/lvgl/src/misc/lv_area.c ****     /*Top left*/
 224:Drivers/lvgl/src/misc/lv_area.c ****     corner_area.x1 = a_p->x1;
 225:Drivers/lvgl/src/misc/lv_area.c ****     corner_area.x2 = a_p->x1 + radius;
 226:Drivers/lvgl/src/misc/lv_area.c ****     corner_area.y1 = a_p->y1;
 227:Drivers/lvgl/src/misc/lv_area.c ****     corner_area.y2 = a_p->y1 + radius;
 228:Drivers/lvgl/src/misc/lv_area.c ****     if(lv_area_is_point_on(&corner_area, p_p, 0)) {
 229:Drivers/lvgl/src/misc/lv_area.c ****         corner_area.x2 += radius;
 230:Drivers/lvgl/src/misc/lv_area.c ****         corner_area.y2 += radius;
 231:Drivers/lvgl/src/misc/lv_area.c ****         return lv_point_within_circle(&corner_area, p_p);
 232:Drivers/lvgl/src/misc/lv_area.c ****     }
 233:Drivers/lvgl/src/misc/lv_area.c ****     /*Bottom left*/
 234:Drivers/lvgl/src/misc/lv_area.c ****     corner_area.y1 = a_p->y2 - radius;
 235:Drivers/lvgl/src/misc/lv_area.c ****     corner_area.y2 = a_p->y2;
 236:Drivers/lvgl/src/misc/lv_area.c ****     if(lv_area_is_point_on(&corner_area, p_p, 0)) {
 237:Drivers/lvgl/src/misc/lv_area.c ****         corner_area.x2 += radius;
 238:Drivers/lvgl/src/misc/lv_area.c ****         corner_area.y1 -= radius;
 239:Drivers/lvgl/src/misc/lv_area.c ****         return lv_point_within_circle(&corner_area, p_p);
