 120:Drivers/lvgl/src/misc/lv_area.c **** int8_t lv_area_diff(lv_area_t res_p[], const lv_area_t * a1_p, const lv_area_t * a2_p)
 121:Drivers/lvgl/src/misc/lv_area.c **** {
 122:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(res_p != NULL, return -1);
 123:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a1_p != NULL, return -1);
 124:Drivers/lvgl/src/misc/lv_area.c ****     LV_CHECK_ARG(a2_p != NULL, return -1);
 125:Drivers/lvgl/src/misc/lv_area.c ****     /*Areas have no common parts*/
 126:Drivers/lvgl/src/misc/lv_area.c ****     if(!lv_area_is_on(a1_p, a2_p)) return -1;
 127:Drivers/lvgl/src/misc/lv_area.c **** 
 128:Drivers/lvgl/src/misc/lv_area.c ****     /*No remaining areas after removing common parts*/
 129:Drivers/lvgl/src/misc/lv_area.c ****     if(lv_area_is_in(a1_p, a2_p, 0)) return 0;
 130:Drivers/lvgl/src/misc/lv_area.c **** 
 131:Drivers/lvgl/src/misc/lv_area.c ****     /*Result counter*/
 132:Drivers/lvgl/src/misc/lv_area.c ****     int8_t res_c = 0;
 133:Drivers/lvgl/src/misc/lv_area.c **** 
 134:Drivers/lvgl/src/misc/lv_area.c ****     /*Get required information*/
 135:Drivers/lvgl/src/misc/lv_area.c ****     lv_area_t n;
 136:Drivers/lvgl/src/misc/lv_area.c ****     int32_t a1_w = lv_area_get_width(a1_p) - 1;
 137:Drivers/lvgl/src/misc/lv_area.c ****     int32_t a1_h = lv_area_get_height(a1_p) - 1;
 138:Drivers/lvgl/src/misc/lv_area.c **** 
 139:Drivers/lvgl/src/misc/lv_area.c ****     /*Compute top rectangle*/
 140:Drivers/lvgl/src/misc/lv_area.c ****     int32_t th = a2_p->y1 - a1_p->y1;
 141:Drivers/lvgl/src/misc/lv_area.c ****     if(th > 0) {
 142:Drivers/lvgl/src/misc/lv_area.c ****         n.x1 = a1_p->x1;
 143:Drivers/lvgl/src/misc/lv_area.c ****         n.y1 = a1_p->y1;
 144:Drivers/lvgl/src/misc/lv_area.c ****         n.x2 = a1_p->x2;
ARM GAS  /tmp/cciRu8Lx.s 			page 4


 145:Drivers/lvgl/src/misc/lv_area.c ****         n.y2 = a1_p->y1 + th - 1;
 146:Drivers/lvgl/src/misc/lv_area.c ****         res_p[res_c++] = n;
 147:Drivers/lvgl/src/misc/lv_area.c ****     }
 148:Drivers/lvgl/src/misc/lv_area.c **** 
 149:Drivers/lvgl/src/misc/lv_area.c ****     /*Compute the bottom rectangle*/
 150:Drivers/lvgl/src/misc/lv_area.c ****     int32_t bh = a1_h - (a2_p->y2 - a1_p->y1);
 151:Drivers/lvgl/src/misc/lv_area.c ****     if(bh > 0 && a2_p->y2 < a1_p->y2) {
 152:Drivers/lvgl/src/misc/lv_area.c ****         n.x1 = a1_p->x1;
 153:Drivers/lvgl/src/misc/lv_area.c ****         n.y1 = a2_p->y2 + 1;
 154:Drivers/lvgl/src/misc/lv_area.c ****         n.x2 = a1_p->x2;
 155:Drivers/lvgl/src/misc/lv_area.c ****         n.y2 = a2_p->y2 + bh;
 156:Drivers/lvgl/src/misc/lv_area.c ****         res_p[res_c++] = n;
 157:Drivers/lvgl/src/misc/lv_area.c ****     }
 158:Drivers/lvgl/src/misc/lv_area.c **** 
 159:Drivers/lvgl/src/misc/lv_area.c ****     /*Compute side height*/
 160:Drivers/lvgl/src/misc/lv_area.c ****     int32_t y1 = a2_p->y1 > a1_p->y1 ? a2_p->y1 : a1_p->y1;
 161:Drivers/lvgl/src/misc/lv_area.c ****     int32_t y2 = a2_p->y2 < a1_p->y2 ? a2_p->y2 : a1_p->y2;
 162:Drivers/lvgl/src/misc/lv_area.c ****     int32_t sh = y2 - y1;
 163:Drivers/lvgl/src/misc/lv_area.c **** 
 164:Drivers/lvgl/src/misc/lv_area.c ****     /*Compute the left rectangle*/
 165:Drivers/lvgl/src/misc/lv_area.c ****     int32_t lw = a2_p->x1 - a1_p->x1;
 166:Drivers/lvgl/src/misc/lv_area.c ****     if(lw > 0 && sh >= 0) {
 167:Drivers/lvgl/src/misc/lv_area.c ****         n.x1 = a1_p->x1;
 168:Drivers/lvgl/src/misc/lv_area.c ****         n.y1 = y1;
 169:Drivers/lvgl/src/misc/lv_area.c ****         n.x2 = a1_p->x1 + lw - 1;
 170:Drivers/lvgl/src/misc/lv_area.c ****         n.y2 = y1 + sh;
 171:Drivers/lvgl/src/misc/lv_area.c ****         res_p[res_c++] = n;
 172:Drivers/lvgl/src/misc/lv_area.c ****     }
 173:Drivers/lvgl/src/misc/lv_area.c **** 
 174:Drivers/lvgl/src/misc/lv_area.c ****     /*Compute the right rectangle*/
 175:Drivers/lvgl/src/misc/lv_area.c ****     int32_t rw = a1_w - (a2_p->x2 - a1_p->x1);
 176:Drivers/lvgl/src/misc/lv_area.c ****     if(rw > 0 && sh >= 0) {
 177:Drivers/lvgl/src/misc/lv_area.c ****         n.x1 = a2_p->x2 + 1;
 178:Drivers/lvgl/src/misc/lv_area.c ****         n.y1 = y1;
 179:Drivers/lvgl/src/misc/lv_area.c ****         n.x2 = a2_p->x2 + rw;
 180:Drivers/lvgl/src/misc/lv_area.c ****         n.y2 = y1 + sh;
 181:Drivers/lvgl/src/misc/lv_area.c ****         res_p[res_c++] = n;
 182:Drivers/lvgl/src/misc/lv_area.c ****     }
 183:Drivers/lvgl/src/misc/lv_area.c **** 
 184:Drivers/lvgl/src/misc/lv_area.c ****     //Return number of results
 185:Drivers/lvgl/src/misc/lv_area.c ****     return res_c;
 186:Drivers/lvgl/src/misc/lv_area.c **** }
