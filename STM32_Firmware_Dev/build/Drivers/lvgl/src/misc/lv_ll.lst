 105:Drivers/lvgl/src/misc/lv_ll.c **** void * lv_ll_ins_tail(lv_ll_t * ll_p)
 106:Drivers/lvgl/src/misc/lv_ll.c **** {
 107:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return NULL);
 108:Drivers/lvgl/src/misc/lv_ll.c **** 
 109:Drivers/lvgl/src/misc/lv_ll.c ****     lv_ll_node_t * n_new;
 110:Drivers/lvgl/src/misc/lv_ll.c **** 
 111:Drivers/lvgl/src/misc/lv_ll.c ****     n_new = lv_malloc(ll_p->n_size + LL_NODE_META_SIZE);
 112:Drivers/lvgl/src/misc/lv_ll.c **** 
 113:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_new != NULL) {
 114:Drivers/lvgl/src/misc/lv_ll.c ****         node_set_next(ll_p, n_new, NULL);       /*No next after the new tail*/
 115:Drivers/lvgl/src/misc/lv_ll.c ****         node_set_prev(ll_p, n_new, ll_p->tail); /*The prev. before new is the old tail*/
 116:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_p->tail != NULL) {                /*If there is old tail then the new comes after it*
 117:Drivers/lvgl/src/misc/lv_ll.c ****             node_set_next(ll_p, ll_p->tail, n_new);
 118:Drivers/lvgl/src/misc/lv_ll.c ****         }
 119:Drivers/lvgl/src/misc/lv_ll.c **** 
 120:Drivers/lvgl/src/misc/lv_ll.c ****         ll_p->tail = n_new;      /*Set the new tail in the dsc.*/
 121:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_p->head == NULL) { /*If there is no head (1. node) set the head too*/
 122:Drivers/lvgl/src/misc/lv_ll.c ****             ll_p->head = n_new;
 123:Drivers/lvgl/src/misc/lv_ll.c ****         }
 124:Drivers/lvgl/src/misc/lv_ll.c ****     }
 125:Drivers/lvgl/src/misc/lv_ll.c **** 
 126:Drivers/lvgl/src/misc/lv_ll.c ****     return n_new;
 127:Drivers/lvgl/src/misc/lv_ll.c **** }
