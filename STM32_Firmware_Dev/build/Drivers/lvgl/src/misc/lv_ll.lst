  42:Drivers/lvgl/src/misc/lv_ll.c **** void lv_ll_init(lv_ll_t * ll_p, uint32_t node_size)
  43:Drivers/lvgl/src/misc/lv_ll.c **** {
  44:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return);
  45:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG_MSG(node_size > 0, return, "cannot initialize a linked list with empty nodes");
  46:Drivers/lvgl/src/misc/lv_ll.c ****     ll_p->head = NULL;
  47:Drivers/lvgl/src/misc/lv_ll.c ****     ll_p->tail = NULL;
  48:Drivers/lvgl/src/misc/lv_ll.c **** #ifdef LV_ARCH_64
  49:Drivers/lvgl/src/misc/lv_ll.c ****     /*Round the size up to 8*/
  50:Drivers/lvgl/src/misc/lv_ll.c ****     node_size = (node_size + 7) & (~0x7);
  51:Drivers/lvgl/src/misc/lv_ll.c **** #else
  52:Drivers/lvgl/src/misc/lv_ll.c ****     /*Round the size up to 4*/
  53:Drivers/lvgl/src/misc/lv_ll.c ****     node_size = (node_size + 3) & (~0x3);
  54:Drivers/lvgl/src/misc/lv_ll.c **** #endif
  55:Drivers/lvgl/src/misc/lv_ll.c **** 
  56:Drivers/lvgl/src/misc/lv_ll.c ****     ll_p->n_size = node_size;
  57:Drivers/lvgl/src/misc/lv_ll.c **** }
  58:Drivers/lvgl/src/misc/lv_ll.c **** 
  59:Drivers/lvgl/src/misc/lv_ll.c **** void * lv_ll_ins_head(lv_ll_t * ll_p)
  60:Drivers/lvgl/src/misc/lv_ll.c **** {
  61:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return NULL);
  62:Drivers/lvgl/src/misc/lv_ll.c **** 
  63:Drivers/lvgl/src/misc/lv_ll.c ****     lv_ll_node_t * n_new;
  64:Drivers/lvgl/src/misc/lv_ll.c **** 
  65:Drivers/lvgl/src/misc/lv_ll.c ****     n_new = lv_malloc(ll_p->n_size + LL_NODE_META_SIZE);
  66:Drivers/lvgl/src/misc/lv_ll.c **** 
  67:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_new != NULL) {
  68:Drivers/lvgl/src/misc/lv_ll.c ****         node_set_prev(ll_p, n_new, NULL);       /*No prev. before the new head*/
  69:Drivers/lvgl/src/misc/lv_ll.c ****         node_set_next(ll_p, n_new, ll_p->head); /*After new comes the old head*/
  70:Drivers/lvgl/src/misc/lv_ll.c **** 
  71:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_p->head != NULL) { /*If there is old head then before it goes the new*/
  72:Drivers/lvgl/src/misc/lv_ll.c ****             node_set_prev(ll_p, ll_p->head, n_new);
  73:Drivers/lvgl/src/misc/lv_ll.c ****         }
  74:Drivers/lvgl/src/misc/lv_ll.c **** 
  75:Drivers/lvgl/src/misc/lv_ll.c ****         ll_p->head = n_new;      /*Set the new head in the dsc.*/
  76:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_p->tail == NULL) { /*If there is no tail (1. node) set the tail too*/
  77:Drivers/lvgl/src/misc/lv_ll.c ****             ll_p->tail = n_new;
  78:Drivers/lvgl/src/misc/lv_ll.c ****         }
  79:Drivers/lvgl/src/misc/lv_ll.c ****     }
  80:Drivers/lvgl/src/misc/lv_ll.c **** 
  81:Drivers/lvgl/src/misc/lv_ll.c ****     return n_new;
  82:Drivers/lvgl/src/misc/lv_ll.c **** }
