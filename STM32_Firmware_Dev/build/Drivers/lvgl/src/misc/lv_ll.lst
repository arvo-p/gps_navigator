  84:Drivers/lvgl/src/misc/lv_ll.c **** void * lv_ll_ins_prev(lv_ll_t * ll_p, void * n_act)
  85:Drivers/lvgl/src/misc/lv_ll.c **** {
  86:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return NULL);
  87:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(n_act != NULL, return NULL);
ARM GAS  /tmp/cc3fQGRJ.s 			page 3


  88:Drivers/lvgl/src/misc/lv_ll.c **** 
  89:Drivers/lvgl/src/misc/lv_ll.c ****     if(lv_ll_get_head(ll_p) == n_act) {
  90:Drivers/lvgl/src/misc/lv_ll.c ****         return lv_ll_ins_head(ll_p);
  91:Drivers/lvgl/src/misc/lv_ll.c ****     }
  92:Drivers/lvgl/src/misc/lv_ll.c ****     lv_ll_node_t * n_new = lv_malloc(ll_p->n_size + LL_NODE_META_SIZE);
  93:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_new == NULL) return NULL;
  94:Drivers/lvgl/src/misc/lv_ll.c **** 
  95:Drivers/lvgl/src/misc/lv_ll.c ****     lv_ll_node_t * n_prev;
  96:Drivers/lvgl/src/misc/lv_ll.c ****     n_prev = lv_ll_get_prev(ll_p, n_act);
  97:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_next(ll_p, n_prev, n_new);
  98:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_prev(ll_p, n_new, n_prev);
  99:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_prev(ll_p, n_act, n_new);
 100:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_next(ll_p, n_new, n_act);
 101:Drivers/lvgl/src/misc/lv_ll.c **** 
 102:Drivers/lvgl/src/misc/lv_ll.c ****     return n_new;
 103:Drivers/lvgl/src/misc/lv_ll.c **** }
