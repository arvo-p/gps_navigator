 213:Drivers/lvgl/src/misc/lv_ll.c ****         node_set_next(ll_new_p, node, NULL);
 214:Drivers/lvgl/src/misc/lv_ll.c **** 
 215:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_new_p->tail != NULL) { /*If there is old tail then after it goes the new*/
 216:Drivers/lvgl/src/misc/lv_ll.c ****             node_set_next(ll_new_p, ll_new_p->tail, node);
 217:Drivers/lvgl/src/misc/lv_ll.c ****         }
 218:Drivers/lvgl/src/misc/lv_ll.c **** 
 219:Drivers/lvgl/src/misc/lv_ll.c ****         ll_new_p->tail = node;       /*Set the new tail in the dsc.*/
 220:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_new_p->head == NULL) { /*If there is no head (first node) set the head too*/
 221:Drivers/lvgl/src/misc/lv_ll.c ****             ll_new_p->head = node;
 222:Drivers/lvgl/src/misc/lv_ll.c ****         }
