 165:Drivers/lvgl/src/misc/lv_ll.c **** void lv_ll_clear_custom(lv_ll_t * ll_p, void(*cleanup)(void *))
 166:Drivers/lvgl/src/misc/lv_ll.c **** {
 167:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return);
 168:Drivers/lvgl/src/misc/lv_ll.c **** 
 169:Drivers/lvgl/src/misc/lv_ll.c ****     void * i;
 170:Drivers/lvgl/src/misc/lv_ll.c ****     void * i_next;
 171:Drivers/lvgl/src/misc/lv_ll.c **** 
 172:Drivers/lvgl/src/misc/lv_ll.c ****     i      = lv_ll_get_head(ll_p);
 173:Drivers/lvgl/src/misc/lv_ll.c ****     i_next = NULL;
 174:Drivers/lvgl/src/misc/lv_ll.c **** 
 175:Drivers/lvgl/src/misc/lv_ll.c ****     while(i != NULL) {
 176:Drivers/lvgl/src/misc/lv_ll.c ****         i_next = lv_ll_get_next(ll_p, i);
 177:Drivers/lvgl/src/misc/lv_ll.c ****         if(cleanup == NULL) {
 178:Drivers/lvgl/src/misc/lv_ll.c ****             lv_ll_remove(ll_p, i);
 179:Drivers/lvgl/src/misc/lv_ll.c ****             lv_free(i);
 180:Drivers/lvgl/src/misc/lv_ll.c ****         }
 181:Drivers/lvgl/src/misc/lv_ll.c ****         else {
 182:Drivers/lvgl/src/misc/lv_ll.c ****             cleanup(i);
 183:Drivers/lvgl/src/misc/lv_ll.c ****         }
 184:Drivers/lvgl/src/misc/lv_ll.c ****         i = i_next;
 185:Drivers/lvgl/src/misc/lv_ll.c ****     }
 186:Drivers/lvgl/src/misc/lv_ll.c **** }
