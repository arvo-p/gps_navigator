 129:Drivers/lvgl/src/misc/lv_ll.c **** void lv_ll_remove(lv_ll_t * ll_p, void * node_p)
 130:Drivers/lvgl/src/misc/lv_ll.c **** {
 131:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return);
 132:Drivers/lvgl/src/misc/lv_ll.c ****     if(!node_p) {
 133:Drivers/lvgl/src/misc/lv_ll.c ****         return;
 134:Drivers/lvgl/src/misc/lv_ll.c ****     }
 135:Drivers/lvgl/src/misc/lv_ll.c **** 
 136:Drivers/lvgl/src/misc/lv_ll.c ****     if(lv_ll_get_head(ll_p) == node_p) {
 137:Drivers/lvgl/src/misc/lv_ll.c ****         /*The new head will be the node after 'node_p'*/
 138:Drivers/lvgl/src/misc/lv_ll.c ****         ll_p->head = lv_ll_get_next(ll_p, node_p);
 139:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_p->head == NULL) {
 140:Drivers/lvgl/src/misc/lv_ll.c ****             ll_p->tail = NULL;
 141:Drivers/lvgl/src/misc/lv_ll.c ****         }
 142:Drivers/lvgl/src/misc/lv_ll.c ****         else {
 143:Drivers/lvgl/src/misc/lv_ll.c ****             node_set_prev(ll_p, ll_p->head, NULL);
 144:Drivers/lvgl/src/misc/lv_ll.c ****         }
ARM GAS  /tmp/cc3fQGRJ.s 			page 4


 145:Drivers/lvgl/src/misc/lv_ll.c ****     }
 146:Drivers/lvgl/src/misc/lv_ll.c ****     else if(lv_ll_get_tail(ll_p) == node_p) {
 147:Drivers/lvgl/src/misc/lv_ll.c ****         /*The new tail will be the node before 'node_p'*/
 148:Drivers/lvgl/src/misc/lv_ll.c ****         ll_p->tail = lv_ll_get_prev(ll_p, node_p);
 149:Drivers/lvgl/src/misc/lv_ll.c ****         if(ll_p->tail == NULL) {
 150:Drivers/lvgl/src/misc/lv_ll.c ****             ll_p->head = NULL;
 151:Drivers/lvgl/src/misc/lv_ll.c ****         }
 152:Drivers/lvgl/src/misc/lv_ll.c ****         else {
 153:Drivers/lvgl/src/misc/lv_ll.c ****             node_set_next(ll_p, ll_p->tail, NULL);
 154:Drivers/lvgl/src/misc/lv_ll.c ****         }
 155:Drivers/lvgl/src/misc/lv_ll.c ****     }
 156:Drivers/lvgl/src/misc/lv_ll.c ****     else {
 157:Drivers/lvgl/src/misc/lv_ll.c ****         lv_ll_node_t * n_prev = lv_ll_get_prev(ll_p, node_p);
 158:Drivers/lvgl/src/misc/lv_ll.c ****         lv_ll_node_t * n_next = lv_ll_get_next(ll_p, node_p);
 159:Drivers/lvgl/src/misc/lv_ll.c **** 
 160:Drivers/lvgl/src/misc/lv_ll.c ****         node_set_next(ll_p, n_prev, n_next);
 161:Drivers/lvgl/src/misc/lv_ll.c ****         node_set_prev(ll_p, n_next, n_prev);
 162:Drivers/lvgl/src/misc/lv_ll.c ****     }
 163:Drivers/lvgl/src/misc/lv_ll.c **** }
