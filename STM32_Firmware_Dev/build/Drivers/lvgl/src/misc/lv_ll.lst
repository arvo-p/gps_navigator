 276:Drivers/lvgl/src/misc/lv_ll.c **** void lv_ll_move_before(lv_ll_t * ll_p, void * n_act, void * n_after)
 277:Drivers/lvgl/src/misc/lv_ll.c **** {
 278:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return);
 279:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(n_act != NULL, return);
 280:Drivers/lvgl/src/misc/lv_ll.c **** 
 281:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_act == n_after) return; /*Can't move before itself*/
 282:Drivers/lvgl/src/misc/lv_ll.c **** 
 283:Drivers/lvgl/src/misc/lv_ll.c ****     void * n_before;
 284:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_after != NULL)
 285:Drivers/lvgl/src/misc/lv_ll.c ****         n_before = lv_ll_get_prev(ll_p, n_after);
 286:Drivers/lvgl/src/misc/lv_ll.c ****     else
 287:Drivers/lvgl/src/misc/lv_ll.c ****         n_before = lv_ll_get_tail(ll_p); /*if `n_after` is NULL `n_act` should be the new tail*/
 288:Drivers/lvgl/src/misc/lv_ll.c **** 
 289:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_act == n_before) return; /*Already before `n_after`*/
 290:Drivers/lvgl/src/misc/lv_ll.c **** 
 291:Drivers/lvgl/src/misc/lv_ll.c ****     /*It's much easier to remove from the list and add again*/
 292:Drivers/lvgl/src/misc/lv_ll.c ****     lv_ll_remove(ll_p, n_act);
 293:Drivers/lvgl/src/misc/lv_ll.c **** 
 294:Drivers/lvgl/src/misc/lv_ll.c ****     /*Add again by setting the prev. and next nodes*/
 295:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_next(ll_p, n_before, n_act);
 296:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_prev(ll_p, n_act, n_before);
 297:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_prev(ll_p, n_after, n_act);
 298:Drivers/lvgl/src/misc/lv_ll.c ****     node_set_next(ll_p, n_act, n_after);
 299:Drivers/lvgl/src/misc/lv_ll.c **** 
 300:Drivers/lvgl/src/misc/lv_ll.c ****     /*If `n_act` was moved before NULL then it become the new tail*/
 301:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_after == NULL) ll_p->tail = n_act;
 302:Drivers/lvgl/src/misc/lv_ll.c **** 
 303:Drivers/lvgl/src/misc/lv_ll.c ****     /*If `n_act` was moved before `NULL` then it's the new head*/
 304:Drivers/lvgl/src/misc/lv_ll.c ****     if(n_before == NULL) ll_p->head = n_act;
 305:Drivers/lvgl/src/misc/lv_ll.c **** }
 306:Drivers/lvgl/src/misc/lv_ll.c **** 
 307:Drivers/lvgl/src/misc/lv_ll.c **** bool lv_ll_is_empty(lv_ll_t * ll_p)
 308:Drivers/lvgl/src/misc/lv_ll.c **** {
 309:Drivers/lvgl/src/misc/lv_ll.c ****     LV_CHECK_ARG(ll_p != NULL, return true);
 310:Drivers/lvgl/src/misc/lv_ll.c **** 
 311:Drivers/lvgl/src/misc/lv_ll.c ****     if(ll_p->head == NULL && ll_p->tail == NULL) return true;
 312:Drivers/lvgl/src/misc/lv_ll.c **** 
 313:Drivers/lvgl/src/misc/lv_ll.c ****     return false;
 314:Drivers/lvgl/src/misc/lv_ll.c **** }
