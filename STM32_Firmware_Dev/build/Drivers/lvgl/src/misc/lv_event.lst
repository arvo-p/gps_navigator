 173:Drivers/lvgl/src/misc/lv_event.c ****     if(event_array_size(list) == 0) {
 174:Drivers/lvgl/src/misc/lv_event.c ****         /*event list hasn't been initialized.*/
 175:Drivers/lvgl/src/misc/lv_event.c ****         res = lv_array_init(&list->array, 1, sizeof(lv_event_dsc_t *));
 176:Drivers/lvgl/src/misc/lv_event.c ****         if(res != LV_RESULT_OK) {
