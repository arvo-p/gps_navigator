 103:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** void lv_arclabel_set_text(lv_obj_t * obj, const char * text)
 104:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** {
 105:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 106:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     lv_arclabel_t * arclabel = (lv_arclabel_t *)obj;
 107:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** 
 108:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     /*If text is NULL then just refresh with the current text*/
 109:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     if(text == NULL) text = arclabel->text;
 110:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     if(text == NULL) {
 111:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         lv_obj_invalidate(obj);
 112:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         return;
 113:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     }
 114:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** 
 115:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     const size_t text_len = lv_strlen(text) + 1;
 116:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** 
 117:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     /*If set its own text then reallocate it (maybe its size changed)*/
 118:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     if(arclabel->text == text && arclabel->static_txt == 0) {
 119:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         arclabel->text = lv_realloc(arclabel->text, text_len);
 120:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         LV_ASSERT_MALLOC(arclabel->text);
 121:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         if(arclabel->text == NULL) return;
 122:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     }
 123:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     else {
 124:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         /*Free the old text*/
 125:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         if(arclabel->text != NULL && arclabel->static_txt == 0) {
 126:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****             lv_free(arclabel->text);
 127:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****             arclabel->text = NULL;
 128:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         }
 129:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** 
 130:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         arclabel->text = lv_malloc(text_len);
 131:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         LV_ASSERT_MALLOC(arclabel->text);
 132:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         if(arclabel->text == NULL) return;
 133:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** 
 134:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         lv_strcpy(arclabel->text, text);
 135:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** 
 136:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         /*Now the text is dynamically allocated*/
 137:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****         arclabel->static_txt = 0;
 138:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     }
 139:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** 
 140:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c ****     lv_obj_invalidate(obj);
 141:Drivers/lvgl/src/widgets/arclabel/lv_arclabel.c **** }
