 119:Drivers/lvgl/src/widgets/chart/lv_chart.c **** void lv_chart_set_type(lv_obj_t * obj, lv_chart_type_t type)
 120:Drivers/lvgl/src/widgets/chart/lv_chart.c **** {
 121:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 122:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
