 172:Drivers/lvgl/src/widgets/chart/lv_chart.c **** void lv_chart_set_axis_min_value(lv_obj_t * obj, lv_chart_axis_t axis, int32_t min)
 173:Drivers/lvgl/src/widgets/chart/lv_chart.c **** {
 174:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 175:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 176:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     lv_chart_t * chart  = (lv_chart_t *)obj;
 177:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 178:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     switch(axis) {
 179:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         case LV_CHART_AXIS_PRIMARY_Y:
 180:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             if(chart->ymin[0] == min) return;
 181:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             chart->ymin[0] = min;
 182:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             break;
 183:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         case LV_CHART_AXIS_SECONDARY_Y:
 184:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             if(chart->ymin[1] == min) return;
 185:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             chart->ymin[1] = min;
 186:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             break;
 187:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         case LV_CHART_AXIS_PRIMARY_X:
 188:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             if(chart->xmin[0] == min) return;
 189:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             chart->xmin[0] = min;
 190:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             break;
 191:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         case LV_CHART_AXIS_SECONDARY_X:
 192:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             if(chart->xmin[1] == min) return;
 193:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             chart->xmin[1] = min;
 194:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             break;
 195:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         default:
 196:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             LV_LOG_WARN("Invalid axis: %d", axis);
 197:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             return;
 198:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     }
 199:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 200:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     lv_chart_refresh(obj);
 201:Drivers/lvgl/src/widgets/chart/lv_chart.c **** }
