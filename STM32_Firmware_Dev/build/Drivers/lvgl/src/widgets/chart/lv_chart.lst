 148:Drivers/lvgl/src/widgets/chart/lv_chart.c **** void lv_chart_set_point_count(lv_obj_t * obj, uint32_t cnt)
 149:Drivers/lvgl/src/widgets/chart/lv_chart.c **** {
 150:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 151:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 152:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     lv_chart_t * chart  = (lv_chart_t *)obj;
 153:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     if(chart->point_cnt == cnt) return;
 154:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 155:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     lv_chart_series_t * ser;
 156:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 157:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     if(cnt < 1) cnt = 1;
 158:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 159:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     LV_LL_READ_BACK(&chart->series_ll, ser) {
 160:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         if(chart->type == LV_CHART_TYPE_SCATTER) {
 161:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             if(!ser->x_ext_buf_assigned) new_points_alloc(obj, ser, cnt, &ser->x_points);
 162:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         }
 163:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         if(!ser->y_ext_buf_assigned) new_points_alloc(obj, ser, cnt, &ser->y_points);
 164:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         ser->start_point = 0;
 165:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     }
 166:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 167:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     chart->point_cnt = cnt;
 168:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 169:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     lv_chart_refresh(obj);
 170:Drivers/lvgl/src/widgets/chart/lv_chart.c **** }
