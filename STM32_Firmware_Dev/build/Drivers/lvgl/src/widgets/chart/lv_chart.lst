 124:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     if(chart->type == type) return;
 125:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 126:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     if(chart->type == LV_CHART_TYPE_SCATTER) {
 127:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         lv_chart_series_t * ser;
 128:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         LV_LL_READ_BACK(&chart->series_ll, ser) {
 129:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             lv_free(ser->x_points);
 130:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             ser->x_points = NULL;
 131:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         }
 132:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     }
 133:Drivers/lvgl/src/widgets/chart/lv_chart.c **** 
 134:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     if(type == LV_CHART_TYPE_SCATTER) {
 135:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         lv_chart_series_t * ser;
 136:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         LV_LL_READ_BACK(&chart->series_ll, ser) {
 137:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             ser->x_points = lv_malloc(sizeof(int32_t) * chart->point_cnt);
 138:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             LV_ASSERT_MALLOC(ser->x_points);
 139:Drivers/lvgl/src/widgets/chart/lv_chart.c ****             if(ser->x_points == NULL) return;
 140:Drivers/lvgl/src/widgets/chart/lv_chart.c ****         }
 141:Drivers/lvgl/src/widgets/chart/lv_chart.c ****     }
