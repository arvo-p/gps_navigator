 170:Drivers/lvgl/src/widgets/roller/lv_roller.c **** void lv_roller_set_selected(lv_obj_t * obj, uint32_t sel_opt, lv_anim_enable_t anim)
 171:Drivers/lvgl/src/widgets/roller/lv_roller.c **** {
 172:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 173:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 174:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     /*Set the value even if it's the same as the current value because
 175:Drivers/lvgl/src/widgets/roller/lv_roller.c ****      *if moving to the next option with an animation which was just deleted in the PRESS Call the a
 176:Drivers/lvgl/src/widgets/roller/lv_roller.c ****      *nothing will continue the animation.*/
 177:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 178:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     lv_roller_t * roller = (lv_roller_t *)obj;
 179:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 180:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     /*In infinite mode interpret the new ID relative to the currently visible "page"*/
 181:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     if(roller->mode == LV_ROLLER_MODE_INFINITE) {
 182:Drivers/lvgl/src/widgets/roller/lv_roller.c ****         uint32_t real_option_cnt = roller->option_cnt / roller->inf_page_cnt;
 183:Drivers/lvgl/src/widgets/roller/lv_roller.c ****         uint32_t current_page = roller->sel_opt_id / real_option_cnt;
 184:Drivers/lvgl/src/widgets/roller/lv_roller.c ****         /*Set by the user to e.g. 0, 1, 2, 3...
 185:Drivers/lvgl/src/widgets/roller/lv_roller.c ****          *Upscale the value to the current page*/
 186:Drivers/lvgl/src/widgets/roller/lv_roller.c ****         if(sel_opt < real_option_cnt) {
 187:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             uint32_t act_opt = roller->sel_opt_id - current_page * real_option_cnt;
 188:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             int32_t sel_opt_signed = sel_opt;
 189:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             /*Huge jump? Probably from last to first or first to last option.*/
 190:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             if((uint32_t)LV_ABS((int16_t)(act_opt - sel_opt)) > real_option_cnt / 2) {
 191:Drivers/lvgl/src/widgets/roller/lv_roller.c ****                 if(act_opt > sel_opt) sel_opt_signed += real_option_cnt;
 192:Drivers/lvgl/src/widgets/roller/lv_roller.c ****                 else sel_opt_signed -= real_option_cnt;
 193:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             }
 194:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             sel_opt = sel_opt_signed + real_option_cnt * current_page;
 195:Drivers/lvgl/src/widgets/roller/lv_roller.c ****         }
 196:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     }
 197:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 198:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     roller->sel_opt_id     = sel_opt < roller->option_cnt ? sel_opt : roller->option_cnt - 1;
 199:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     roller->sel_opt_id_ori = roller->sel_opt_id;
 200:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 201:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     refr_position(obj, anim);
ARM GAS  /tmp/cc0rTld4.s 			page 5


 202:Drivers/lvgl/src/widgets/roller/lv_roller.c **** }
 203:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 204:Drivers/lvgl/src/widgets/roller/lv_roller.c **** bool lv_roller_set_selected_str(lv_obj_t * obj, const char * sel_opt, lv_anim_enable_t anim)
 205:Drivers/lvgl/src/widgets/roller/lv_roller.c **** {
 206:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return false);
 207:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     LV_CHECK_ARG(sel_opt != NULL, return false);
 208:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 209:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     const char * options = lv_roller_get_options(obj);
 210:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     size_t options_len = lv_strlen(options);
 211:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 212:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     bool option_found = false;
 213:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 214:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     uint32_t current_option = 0;
 215:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     size_t line_start = 0;
 216:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 217:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     for(size_t i = 0; i < options_len; i++) {
 218:Drivers/lvgl/src/widgets/roller/lv_roller.c ****         if(options[i] == '\n') {
 219:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             /* See if this is the correct option */
 220:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             if(lv_strncmp(&options[line_start], sel_opt, i - line_start) == 0) {
 221:Drivers/lvgl/src/widgets/roller/lv_roller.c ****                 lv_roller_set_selected(obj, current_option, anim);
 222:Drivers/lvgl/src/widgets/roller/lv_roller.c ****                 option_found = true;
 223:Drivers/lvgl/src/widgets/roller/lv_roller.c ****                 break;
 224:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             }
 225:Drivers/lvgl/src/widgets/roller/lv_roller.c **** 
 226:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             current_option++;
 227:Drivers/lvgl/src/widgets/roller/lv_roller.c ****             line_start = i + 1;
 228:Drivers/lvgl/src/widgets/roller/lv_roller.c ****         }
 229:Drivers/lvgl/src/widgets/roller/lv_roller.c ****     }
