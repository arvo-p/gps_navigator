 379:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** void lv_spinbox_decrement(lv_obj_t * obj)
 380:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** {
 381:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 382:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     lv_spinbox_t * spinbox = (lv_spinbox_t *)obj;
 383:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** 
 384:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     int32_t v = spinbox->value;
 385:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     /* Special mode when zero crossing. E.g 3-10 should be -3, not -7.
 386:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****      * Pretend we are on 7 now.*/
 387:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     if((spinbox->value > 0) && (spinbox->value - spinbox->step) < 0) {
 388:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         v = spinbox->step - spinbox->value;
 389:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 390:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** 
 391:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     if(v - spinbox->step >= spinbox->range_min) {
 392:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         v -= spinbox->step;
 393:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 394:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     else {
 395:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         /*Rollover?*/
 396:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         if((spinbox->rollover) && (spinbox->value == spinbox->range_min))
 397:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****             v = spinbox->range_max;
 398:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         else
 399:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****             v = spinbox->range_min;
 400:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 401:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** 
 402:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     if(v != spinbox->value) {
 403:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         spinbox->value = v;
 404:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         lv_spinbox_updatevalue(obj);
 405:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 406:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** }
