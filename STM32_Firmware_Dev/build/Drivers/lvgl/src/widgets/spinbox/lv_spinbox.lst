 350:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** void lv_spinbox_increment(lv_obj_t * obj)
 351:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** {
 352:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 353:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     lv_spinbox_t * spinbox = (lv_spinbox_t *)obj;
 354:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** 
 355:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     int32_t v = spinbox->value;
 356:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     /* Special mode when zero crossing. E.g -3+10 should be 3, not 7.
 357:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****      * Pretend we are on -7 now.*/
 358:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     if((spinbox->value < 0) && (spinbox->value + spinbox->step) > 0) {
 359:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         v = -(spinbox->step + spinbox->value);
 360:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 361:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** 
 362:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     if(v + spinbox->step <= spinbox->range_max) {
 363:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         v += spinbox->step;
 364:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 365:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     else {
 366:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         /*Rollover?*/
 367:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         if((spinbox->rollover) && (spinbox->value == spinbox->range_max))
 368:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****             v = spinbox->range_min;
ARM GAS  /tmp/ccMi2f0G.s 			page 8


 369:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         else
 370:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****             v = spinbox->range_max;
 371:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 372:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** 
 373:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     if(v != spinbox->value) {
 374:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         spinbox->value = v;
 375:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****         lv_spinbox_updatevalue(obj);
 376:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c ****     }
 377:Drivers/lvgl/src/widgets/spinbox/lv_spinbox.c **** }
