 287:Drivers/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_rotation(lv_obj_t * obj, int32_t rotation)
 288:Drivers/lvgl/src/widgets/arc/lv_arc.c **** {
 289:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
