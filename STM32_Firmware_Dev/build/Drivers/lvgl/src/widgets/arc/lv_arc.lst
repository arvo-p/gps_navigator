 345:Drivers/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_range(lv_obj_t * obj, int32_t min, int32_t max)
 346:Drivers/lvgl/src/widgets/arc/lv_arc.c **** {
 347:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 348:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 349:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 350:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->min_value == min && arc->max_value == max) return;
 351:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 352:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     arc->min_value = min;
 353:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     arc->max_value = max;
 354:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 355:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value < min) {
 356:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         arc->value = min;
 357:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     }
 358:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value > max) {
 359:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         arc->value = max;
 360:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     }
 361:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 362:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     value_update(obj); /*value has changed relative to the new range*/
 363:Drivers/lvgl/src/widgets/arc/lv_arc.c **** }
