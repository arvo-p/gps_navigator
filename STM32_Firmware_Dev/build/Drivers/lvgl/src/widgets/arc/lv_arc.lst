 245:Drivers/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_bg_angles(lv_obj_t * obj, lv_value_precise_t start, lv_value_precise_t end)
 246:Drivers/lvgl/src/widgets/arc/lv_arc.c **** {
 247:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 248:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 249:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 250:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /* start=0, end=360 means full circle, so accept 360*/
 251:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(start > 360) start -= 360;
 252:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(end > 360) end -= 360;
 253:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(start < 0) start += 360;
 254:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(end < 0) end += 360;
 255:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 256:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /*Snapshot for invalidation*/
 257:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t old_start = arc->bg_angle_start;
 258:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t old_end = arc->bg_angle_end;
ARM GAS  /tmp/cciRpcms.s 			page 6


 259:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 260:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /*Apply the change*/
 261:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     arc->bg_angle_start = start;
 262:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     arc->bg_angle_end = end;
 263:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     value_update(obj);
 264:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 265:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /*Invalidation*/
 266:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     if(lv_obj_is_visible(obj)) {
 267:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         /*Area swept by the start angle*/
 268:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t start_old_delta = end - old_start;
 269:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t start_new_delta = end - start;
 270:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(start_old_delta < 0) start_old_delta = 360 + start_old_delta;
 271:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(start_new_delta < 0) start_new_delta = 360 + start_new_delta;
 272:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(LV_ABS(start_new_delta - start_old_delta) > 180) lv_obj_invalidate(obj);
 273:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(start_new_delta < start_old_delta) inv_arc_area(obj, old_start, start, LV_PART_MAIN
 274:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(start_old_delta < start_new_delta) inv_arc_area(obj, start, old_start, LV_PART_MAIN
 275:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 276:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         /*Area swept by the end angle*/
 277:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t end_old_delta = old_end - old_start;
 278:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t end_new_delta = end - old_start;
 279:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(end_old_delta < 0) end_old_delta = 360 + end_old_delta;
 280:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(end_new_delta < 0) end_new_delta = 360 + end_new_delta;
 281:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(LV_ABS(end_new_delta - end_old_delta) > 180) lv_obj_invalidate(obj);
 282:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(end_new_delta < end_old_delta) inv_arc_area(obj, end, old_end, LV_PART_MAIN);
 283:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(end_old_delta < end_new_delta) inv_arc_area(obj, old_end, end, LV_PART_MAIN);
 284:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     }
 285:Drivers/lvgl/src/widgets/arc/lv_arc.c **** }
