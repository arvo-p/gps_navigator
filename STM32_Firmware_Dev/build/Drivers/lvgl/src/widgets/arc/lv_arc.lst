 328:Drivers/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_value(lv_obj_t * obj, int32_t value)
 329:Drivers/lvgl/src/widgets/arc/lv_arc.c **** {
 330:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 331:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 332:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 333:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value == value) return;
 334:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 335:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     int32_t new_value;
 336:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     new_value = value > arc->max_value ? arc->max_value : value;
 337:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     new_value = new_value < arc->min_value ? arc->min_value : new_value;
 338:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 339:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value == new_value) return;
 340:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     arc->value = new_value;
 341:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 342:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     value_update(obj);
 343:Drivers/lvgl/src/widgets/arc/lv_arc.c **** }
