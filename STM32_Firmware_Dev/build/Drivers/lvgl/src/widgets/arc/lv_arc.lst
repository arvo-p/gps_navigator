 177:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 178:Drivers/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_angles(lv_obj_t * obj, lv_value_precise_t start, lv_value_precise_t end)
 179:Drivers/lvgl/src/widgets/arc/lv_arc.c **** {
 180:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 181:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 182:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 183:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /* start=0, end=360 means full circle, so accept 360*/
 184:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(start > 360) start -= 360;
 185:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(end > 360) end -= 360;
 186:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(start < 0) start += 360;
 187:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     while(end < 0) end += 360;
 188:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 189:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     bool visible = lv_obj_is_visible(obj);
 190:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 191:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /*Snapshot for invalidation*/
 192:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t old_start = arc->indic_angle_start;
 193:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t old_end = arc->indic_angle_end;
 194:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     lv_area_t old_knob_area;
 195:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     bool knob_visible = visible && get_knob_inv_area(obj, &old_knob_area);
 196:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 197:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /*Apply the change*/
 198:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     arc->indic_angle_start = start;
 199:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     arc->indic_angle_end = end;
 200:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 201:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     /*Invalidation*/
ARM GAS  /tmp/cciRpcms.s 			page 5


 202:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     if(visible) {
 203:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         /*Area swept by the start angle*/
 204:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t start_old_delta = end - old_start;
 205:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t start_new_delta = end - start;
 206:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(start_old_delta < 0) start_old_delta = 360 + start_old_delta;
 207:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(start_new_delta < 0) start_new_delta = 360 + start_new_delta;
 208:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(LV_ABS(start_new_delta - start_old_delta) > 180) lv_obj_invalidate(obj);
 209:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(start_new_delta < start_old_delta) inv_arc_area(obj, old_start, start, LV_PART_INDI
 210:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(start_old_delta < start_new_delta) inv_arc_area(obj, start, old_start, LV_PART_INDI
 211:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 212:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         /*Area swept by the end angle*/
 213:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t end_old_delta = old_end - old_start;
 214:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         lv_value_precise_t end_new_delta = end - old_start;
 215:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(end_old_delta < 0) end_old_delta = 360 + end_old_delta;
 216:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(end_new_delta < 0) end_new_delta = 360 + end_new_delta;
 217:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(LV_ABS(end_new_delta - end_old_delta) > 180) lv_obj_invalidate(obj);
 218:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(end_new_delta < end_old_delta) inv_arc_area(obj, end, old_end, LV_PART_INDICATOR);
 219:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         else if(end_old_delta < end_new_delta) inv_arc_area(obj, old_end, end, LV_PART_INDICATOR);
 220:Drivers/lvgl/src/widgets/arc/lv_arc.c **** 
 221:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         /*Knob*/
 222:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         if(knob_visible) {
 223:Drivers/lvgl/src/widgets/arc/lv_arc.c ****             lv_obj_invalidate_area(obj, &old_knob_area);
 224:Drivers/lvgl/src/widgets/arc/lv_arc.c ****             inv_knob_area(obj);
 225:Drivers/lvgl/src/widgets/arc/lv_arc.c ****         }
 226:Drivers/lvgl/src/widgets/arc/lv_arc.c ****     }
 227:Drivers/lvgl/src/widgets/arc/lv_arc.c **** }
