 114:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** {
 115:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 116:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** 
 117:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     lv_canvas_t * canvas = (lv_canvas_t *)obj;
 118:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     lv_draw_buf_t * draw_buf = canvas->draw_buf;
 119:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** 
 120:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     if(draw_buf == NULL) return;
 121:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** 
 122:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     lv_color_format_t cf = draw_buf->header.cf;
 123:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     uint8_t * data = lv_draw_buf_goto_xy(draw_buf, x, y);
 124:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     if(data == NULL) return;
 125:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** 
 126:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     if(LV_COLOR_FORMAT_IS_INDEXED(cf)) {
 127:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         uint8_t shift;
 128:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         uint8_t c_int = color.blue;
 129:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         switch(cf) {
 130:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             case LV_COLOR_FORMAT_I1:
 131:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 shift = 7 - (x & 0x7);
 132:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 break;
 133:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             case LV_COLOR_FORMAT_I2:
 134:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 shift = 6 - 2 * (x & 0x3);
 135:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 break;
 136:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             case LV_COLOR_FORMAT_I4:
 137:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 shift = 4 - 4 * (x & 0x1);
 138:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 break;
 139:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             case LV_COLOR_FORMAT_I8:
 140:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 /*Indexed8 format is a easy case, process and return.*/
 141:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 shift = 0;
 142:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 *data = c_int;
 143:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             default:
 144:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****                 return;
ARM GAS  /tmp/cce3P1ZR.s 			page 4


 145:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         }
 146:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** 
 147:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         uint8_t bpp = lv_color_format_get_bpp(cf);
 148:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         uint8_t mask = (1 << bpp) - 1;
 149:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         c_int &= mask;
 150:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         *data = (*data & ~(mask << shift)) | (c_int << shift);
 151:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
 152:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     else if(cf == LV_COLOR_FORMAT_L8) {
 153:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         *data = lv_color_luminance(color);
 154:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
 155:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     else if(cf == LV_COLOR_FORMAT_A8) {
 156:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         *data = opa;
 157:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
 158:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     else if(cf == LV_COLOR_FORMAT_RGB565) {
 159:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         lv_color16_t * buf = (lv_color16_t *)data;
 160:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->red = color.red >> 3;
 161:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->green = color.green >> 2;
 162:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->blue = color.blue >> 3;
 163:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
 164:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     else if(cf == LV_COLOR_FORMAT_RGB888) {
 165:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         data[2] = color.red;
 166:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         data[1] = color.green;
 167:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         data[0] = color.blue;
 168:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
 169:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     else if(cf == LV_COLOR_FORMAT_XRGB8888) {
 170:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         data[2] = color.red;
 171:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         data[1] = color.green;
 172:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         data[0] = color.blue;
 173:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         data[3] = 0xFF;
 174:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
 175:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     else if(cf == LV_COLOR_FORMAT_ARGB8888) {
 176:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         lv_color32_t * buf = (lv_color32_t *)data;
 177:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->red = color.red;
 178:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->green = color.green;
 179:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->blue = color.blue;
 180:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->alpha = opa;
 181:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
 182:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     else if(cf == LV_COLOR_FORMAT_AL88) {
 183:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         lv_color16a_t * buf = (lv_color16a_t *)data;
 184:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->lumi = lv_color_luminance(color);
 185:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         buf->alpha = 255;
 186:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     }
