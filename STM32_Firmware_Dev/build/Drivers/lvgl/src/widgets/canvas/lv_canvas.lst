 214:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** lv_color32_t lv_canvas_get_px(lv_obj_t * obj, int32_t x, int32_t y)
 215:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** {
 216:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     lv_color32_t ret = { 0 };
 217:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return ret);
 218:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     lv_canvas_t * canvas = (lv_canvas_t *)obj;
 219:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     LV_CHECK_ARG(canvas->draw_buf != NULL, return ret);
 220:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     LV_CHECK_ARG(lv_draw_buf_is_position_valid(canvas->draw_buf, x, y), return ret);
 221:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** 
 222:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     lv_image_header_t * header = &canvas->draw_buf->header;
 223:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     const uint8_t * px = lv_draw_buf_goto_xy(canvas->draw_buf, x, y);
 224:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     LV_ASSERT(px != NULL);
 225:Drivers/lvgl/src/widgets/canvas/lv_canvas.c **** 
 226:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****     switch(header->cf) {
 227:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         case LV_COLOR_FORMAT_ARGB8888:
 228:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             ret = *(lv_color32_t *)px;
 229:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             break;
 230:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         case LV_COLOR_FORMAT_RGB888:
 231:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         case LV_COLOR_FORMAT_XRGB8888:
 232:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             ret.red = px[2];
 233:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             ret.green = px[1];
 234:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             ret.blue = px[0];
 235:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             ret.alpha = 0xFF;
 236:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****             break;
 237:Drivers/lvgl/src/widgets/canvas/lv_canvas.c ****         case LV_COLOR_FORMAT_RGB565: {
