 171:Drivers/lvgl/src/widgets/label/lv_label.c **** void lv_label_set_text_static(lv_obj_t * obj, const char * text)
 172:Drivers/lvgl/src/widgets/label/lv_label.c **** {
 173:Drivers/lvgl/src/widgets/label/lv_label.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 174:Drivers/lvgl/src/widgets/label/lv_label.c ****     lv_label_t * label = (lv_label_t *)obj;
 175:Drivers/lvgl/src/widgets/label/lv_label.c ****     if(!text) {
