 179:Drivers/lvgl/src/widgets/label/lv_label.c **** 
 180:Drivers/lvgl/src/widgets/label/lv_label.c ****     remove_translation_tag(obj);
 181:Drivers/lvgl/src/widgets/label/lv_label.c ****     if(label->static_txt == 0 && label->text != NULL) {
 182:Drivers/lvgl/src/widgets/label/lv_label.c ****         lv_free(label->text);
 183:Drivers/lvgl/src/widgets/label/lv_label.c ****         label->text = NULL;
 184:Drivers/lvgl/src/widgets/label/lv_label.c ****     }
 185:Drivers/lvgl/src/widgets/label/lv_label.c **** 
 186:Drivers/lvgl/src/widgets/label/lv_label.c ****     if(text != NULL) {
 187:Drivers/lvgl/src/widgets/label/lv_label.c ****         label->static_txt = 1;
 188:Drivers/lvgl/src/widgets/label/lv_label.c ****         label->text       = (char *)text;
 189:Drivers/lvgl/src/widgets/label/lv_label.c ****     }
 190:Drivers/lvgl/src/widgets/label/lv_label.c **** 
 191:Drivers/lvgl/src/widgets/label/lv_label.c ****     lv_label_mark_need_refr_text(obj);
 192:Drivers/lvgl/src/widgets/label/lv_label.c **** }
