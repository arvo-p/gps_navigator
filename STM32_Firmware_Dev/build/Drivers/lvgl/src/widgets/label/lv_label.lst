  34:Drivers/lvgl/src/widgets/label/../../misc/lv_bidi_private.h ****  * Unicode Bidirectional Algorithm
  35:Drivers/lvgl/src/widgets/label/../../misc/lv_bidi_private.h ****  * @param str_in the text to process
