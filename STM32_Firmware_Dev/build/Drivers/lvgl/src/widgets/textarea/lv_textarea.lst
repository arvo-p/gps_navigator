 202:Drivers/lvgl/src/widgets/textarea/lv_textarea.c **** 
 203:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     /*Add the character one-by-one if not all characters are accepted or there is character limit.*
 204:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     if(lv_textarea_get_accepted_chars(obj) || lv_textarea_get_max_length(obj)) {
 205:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****         if(add_text(obj, txt)) {
 206:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****             lv_obj_send_event(obj, LV_EVENT_VALUE_CHANGED, NULL);
 207:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****         }
