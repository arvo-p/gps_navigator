 226:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****         char * new_buf = lv_realloc(ta->pwd_tmp, realloc_size);
 227:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****         LV_ASSERT_MALLOC(new_buf);
 228:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****         if(!new_buf) return;
