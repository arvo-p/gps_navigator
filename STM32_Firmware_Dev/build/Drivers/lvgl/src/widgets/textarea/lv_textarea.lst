 209:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     }
 210:Drivers/lvgl/src/widgets/textarea/lv_textarea.c **** 
 211:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     lv_result_t res = insert_handler(obj, txt);
 212:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     if(res != LV_RESULT_OK) return;
 213:Drivers/lvgl/src/widgets/textarea/lv_textarea.c **** 
 214:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     /*If the textarea is empty, invalidate it to hide the placeholder*/
 215:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     if(ta->placeholder_txt) {
 216:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****         const char * txt_act = lv_label_get_text(ta->label);
 217:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****         if(txt_act[0] == '\0') lv_obj_invalidate(obj);
 218:Drivers/lvgl/src/widgets/textarea/lv_textarea.c ****     }
