 430:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****  * Get the number of days in a month
 431:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****  * @param year a year
 432:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****  * @param month a month. The range is basically [1..12] but [-11..0] or [13..24] is also
 433:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****  *              supported to handle next/prev. year
 434:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****  * @return [28..31]
 435:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****  */
 436:Drivers/lvgl/src/widgets/calendar/lv_calendar.c **** static uint8_t get_month_length(int32_t year, int32_t month)
 437:Drivers/lvgl/src/widgets/calendar/lv_calendar.c **** {
 438:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****     month--;
 439:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****     if(month < 0) {
 440:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****         year--;             /*Already in the previous year (won't be less than -12 to skip a whole 
 441:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****         month = 12 + month; /*`month` is negative, the result will be < 12*/
 442:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****     }
 443:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****     if(month >= 12) {
 444:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****         year++;
 445:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****         month -= 12;
 446:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****     }
 447:Drivers/lvgl/src/widgets/calendar/lv_calendar.c **** 
 448:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****     /*month == 1 is february*/
 449:Drivers/lvgl/src/widgets/calendar/lv_calendar.c ****     return (month == 1) ? (28 + is_leap_year(year)) : 31 - month % 7 % 2;
 450:Drivers/lvgl/src/widgets/calendar/lv_calendar.c **** }
 451:Drivers/lvgl/src/widgets/calendar/lv_calendar.c **** 
