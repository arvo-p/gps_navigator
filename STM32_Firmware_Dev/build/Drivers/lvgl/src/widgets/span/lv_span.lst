 385:Drivers/lvgl/src/widgets/span/lv_span.c **** lv_span_t * lv_spangroup_get_child(const lv_obj_t * obj, int32_t id)
 386:Drivers/lvgl/src/widgets/span/lv_span.c **** {
 387:Drivers/lvgl/src/widgets/span/lv_span.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return NULL);
 388:Drivers/lvgl/src/widgets/span/lv_span.c ****     lv_spangroup_t * spans = (lv_spangroup_t *)obj;
 389:Drivers/lvgl/src/widgets/span/lv_span.c ****     lv_ll_t * linked_list = &spans->child_ll;
 390:Drivers/lvgl/src/widgets/span/lv_span.c **** 
 391:Drivers/lvgl/src/widgets/span/lv_span.c ****     bool traverse_forwards = (id >= 0);
 392:Drivers/lvgl/src/widgets/span/lv_span.c ****     int32_t cur_idx = 0;
 393:Drivers/lvgl/src/widgets/span/lv_span.c ****     lv_ll_node_t * cur_node = linked_list->head;
 394:Drivers/lvgl/src/widgets/span/lv_span.c **** 
 395:Drivers/lvgl/src/widgets/span/lv_span.c ****     /*If using a negative index, start from the tail and use cur -1 to indicate the end*/
 396:Drivers/lvgl/src/widgets/span/lv_span.c ****     if(!traverse_forwards) {
 397:Drivers/lvgl/src/widgets/span/lv_span.c ****         cur_idx = -1;
 398:Drivers/lvgl/src/widgets/span/lv_span.c ****         cur_node = linked_list->tail;
 399:Drivers/lvgl/src/widgets/span/lv_span.c ****     }
 400:Drivers/lvgl/src/widgets/span/lv_span.c **** 
 401:Drivers/lvgl/src/widgets/span/lv_span.c ****     while(cur_node != NULL) {
 402:Drivers/lvgl/src/widgets/span/lv_span.c ****         if(cur_idx == id) {
 403:Drivers/lvgl/src/widgets/span/lv_span.c ****             return (lv_span_t *) cur_node;
 404:Drivers/lvgl/src/widgets/span/lv_span.c ****         }
 405:Drivers/lvgl/src/widgets/span/lv_span.c ****         if(traverse_forwards) {
 406:Drivers/lvgl/src/widgets/span/lv_span.c ****             cur_node = (lv_ll_node_t *) lv_ll_get_next(linked_list, cur_node);
 407:Drivers/lvgl/src/widgets/span/lv_span.c ****             cur_idx++;
 408:Drivers/lvgl/src/widgets/span/lv_span.c ****         }
 409:Drivers/lvgl/src/widgets/span/lv_span.c ****         else {
 410:Drivers/lvgl/src/widgets/span/lv_span.c ****             cur_node = (lv_ll_node_t *) lv_ll_get_prev(linked_list, cur_node);
 411:Drivers/lvgl/src/widgets/span/lv_span.c ****             cur_idx--;
 412:Drivers/lvgl/src/widgets/span/lv_span.c ****         }
 413:Drivers/lvgl/src/widgets/span/lv_span.c ****     }
 414:Drivers/lvgl/src/widgets/span/lv_span.c **** 
 415:Drivers/lvgl/src/widgets/span/lv_span.c ****     return NULL;
 416:Drivers/lvgl/src/widgets/span/lv_span.c **** }
