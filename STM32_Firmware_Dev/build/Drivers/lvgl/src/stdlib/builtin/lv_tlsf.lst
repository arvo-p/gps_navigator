  82:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
  83:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** tlsf_decl int tlsf_ffs(unsigned int word)
  84:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** {
  85:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     const unsigned int reverse = word & (~word + 1);
  86:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     const int bit = 32 - __builtin_clz(reverse);
  87:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     return bit - 1;
