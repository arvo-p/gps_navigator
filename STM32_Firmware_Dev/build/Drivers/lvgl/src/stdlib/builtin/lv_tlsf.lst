 308:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 309:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /*
 310:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** Block header structure.
 311:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** **
 312:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** There are several implementation subtleties involved:
 313:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** - The prev_phys_block field is only valid if the previous block is free.
 314:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** - The prev_phys_block field is actually stored at the end of the
 315:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** **   previous block. It appears at the beginning of this structure only to
ARM GAS  /tmp/ccTKn2sD.s 			page 7


 316:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** **   simplify the implementation.
 317:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** - The next_free / prev_free fields are only valid if the block is free.
 318:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** */
 319:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** typedef struct block_header_t {
 320:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /* Points to the previous physical block. */
 321:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     struct block_header_t * prev_phys_block;
 322:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 323:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /* The size of this block, excluding the block header. */
 324:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     size_t size;
 325:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 326:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /* Next and previous free blocks. */
 327:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     struct block_header_t * next_free;
 328:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     struct block_header_t * prev_free;
 329:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** } block_header_t;
 330:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 331:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /*
 332:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** Since block sizes are always at least a multiple of 4, the two least
 333:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** significant bits of the size field are used to store the block status:
 334:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** - bit 0: whether block is busy or free
 335:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** - bit 1: whether previous block is busy or free
 336:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** */
 337:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** static const size_t block_header_free_bit = 1 << 0;
 338:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** static const size_t block_header_prev_free_bit = 1 << 1;
 339:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 340:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /*
 341:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** The size of the block header exposed to used blocks is the size field.
 342:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** The prev_phys_block field is stored *inside* the previous free block.
 343:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** */
 344:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** static const size_t block_header_overhead = sizeof(size_t);
 345:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 346:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /* User data starts directly after the size field in a used block. */
 347:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** static const size_t block_start_offset =
 348:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     offsetof(block_header_t, size) + sizeof(size_t);
 349:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 350:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /*
 351:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** A free block must be large enough to store its header minus the size of
 352:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** the prev_phys_block field, and no larger than the number of addressable
 353:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** ** bits for FL_INDEX.
 354:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** */
 355:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** static const size_t block_size_min =
 356:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     sizeof(block_header_t) - sizeof(block_header_t *);
 357:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** static const size_t block_size_max = tlsf_cast(size_t, 1) << FL_INDEX_MAX;
 358:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 359:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /* The TLSF control structure. */
 360:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** typedef struct control_t {
 361:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /* Empty lists point at this block to indicate they are free. */
 362:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     block_header_t block_null;
 363:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 364:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /* Bitmaps for free lists. */
 365:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     unsigned int fl_bitmap;
 366:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     unsigned int sl_bitmap[FL_INDEX_COUNT];
 367:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 368:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /* Head of free lists. */
 369:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     block_header_t * blocks[FL_INDEX_COUNT][SL_INDEX_COUNT];
 370:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** } control_t;
