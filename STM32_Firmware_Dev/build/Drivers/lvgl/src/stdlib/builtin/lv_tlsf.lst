 294:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /* This code has been tested on 32- and 64-bit (LP/LLP) architectures. */
 295:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** tlsf_static_assert(sizeof(int) * CHAR_BIT == 32);
 296:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** tlsf_static_assert(sizeof(size_t) * CHAR_BIT >= 32);
 297:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** tlsf_static_assert(sizeof(size_t) * CHAR_BIT <= 64);
 298:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 299:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /* SL_INDEX_COUNT must be <= number of bits in sl_bitmap's storage type. */
 300:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** tlsf_static_assert(sizeof(unsigned int) * CHAR_BIT >= SL_INDEX_COUNT);
 301:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 302:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** /* Ensure we've properly tuned our sizes. */
 303:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** tlsf_static_assert(ALIGN_SIZE == SMALL_BLOCK_SIZE / SL_INDEX_COUNT);
