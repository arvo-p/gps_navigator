 234:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /* All allocation sizes and addresses are aligned to 4 bytes. */
 235:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ALIGN_SIZE_LOG2 = 2,
 236:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** #endif
 237:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ALIGN_SIZE = (1 << ALIGN_SIZE_LOG2),
 238:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 239:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /*
 240:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** We support allocations of sizes up to (1 << FL_INDEX_MAX) bits.
 241:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** However, because we linearly subdivide the second-level lists, and
 242:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** our minimum size granularity is 4 bytes, it doesn't make sense to
 243:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** create first-level lists for sizes smaller than SL_INDEX_COUNT * 4,
 244:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** or (1 << (SL_INDEX_COUNT_LOG2 + 2)) bytes, as there we will be
 245:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** trying to split size ranges into more slots than we have available.
 246:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** Instead, we calculate the minimum threshold size, and place all
 247:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** blocks below that size into the 0th first-level list.
 248:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     */
 249:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 250:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** #if defined (TLSF_MAX_POOL_SIZE)
 251:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     FL_INDEX_MAX = TLSF_LOG2_CEIL(TLSF_MAX_POOL_SIZE),
 252:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** #elif defined (TLSF_64BIT)
 253:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     /*
 254:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** TODO: We can increase this to support larger sizes, at the expense
 255:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     ** of more overhead in the TLSF structure.
 256:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     */
 257:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     FL_INDEX_MAX = 32,
 258:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** #else
ARM GAS  /tmp/ccTKn2sD.s 			page 6


 259:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     FL_INDEX_MAX = 30,
 260:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** #endif
 261:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     SL_INDEX_COUNT = (1 << SL_INDEX_COUNT_LOG2),
 262:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     FL_INDEX_SHIFT = (SL_INDEX_COUNT_LOG2 + ALIGN_SIZE_LOG2),
 263:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     FL_INDEX_COUNT = (FL_INDEX_MAX - FL_INDEX_SHIFT + 1),
 264:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** 
 265:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c ****     SMALL_BLOCK_SIZE = (1 << FL_INDEX_SHIFT),
 266:Drivers/lvgl/src/stdlib/builtin/lv_tlsf.c **** } tlsf_private;
