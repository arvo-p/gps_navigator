 189:Drivers/lvgl/src/draw/lv_draw_image.c **** 
 190:Drivers/lvgl/src/draw/lv_draw_image.c ****     const uint8_t first_byte = *(const uint8_t *)src;
 191:Drivers/lvgl/src/draw/lv_draw_image.c **** 
 192:Drivers/lvgl/src/draw/lv_draw_image.c ****     /*The first byte shows the type of the image source*/
 193:Drivers/lvgl/src/draw/lv_draw_image.c ****     if(first_byte >= 0x20 && first_byte <= 0x7F) {
 194:Drivers/lvgl/src/draw/lv_draw_image.c ****         return LV_IMAGE_SRC_FILE; /*If it's an ASCII character then it's file name*/
 195:Drivers/lvgl/src/draw/lv_draw_image.c ****     }
 196:Drivers/lvgl/src/draw/lv_draw_image.c **** 
 197:Drivers/lvgl/src/draw/lv_draw_image.c ****     if(first_byte >= 0x80) {
 198:Drivers/lvgl/src/draw/lv_draw_image.c ****         return LV_IMAGE_SRC_SYMBOL; /*Symbols begins after 0x7F*/
 199:Drivers/lvgl/src/draw/lv_draw_image.c ****     }
