 204:Drivers/lvgl/src/draw/lv_draw_image.c ****      */
 205:Drivers/lvgl/src/draw/lv_draw_image.c ****     if(first_byte == LV_IMAGE_HEADER_MAGIC || first_byte == LV_IMAGE_HEADER_LEGACY) {
