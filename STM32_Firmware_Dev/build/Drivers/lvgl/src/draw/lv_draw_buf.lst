 703:Drivers/lvgl/src/draw/lv_draw_buf.c **** /**
 704:Drivers/lvgl/src/draw/lv_draw_buf.c ****  * For given width, height, color format, and stride, calculate the size needed for a new draw buff
 705:Drivers/lvgl/src/draw/lv_draw_buf.c ****  * The result is rounded up to LV_DRAW_BUF_ALIGN so the allocated buffer length is a multiple of th
 706:Drivers/lvgl/src/draw/lv_draw_buf.c ****  * alignment boundary (required, for example, by the ESP32 PPA whose config structure wants the ful
 707:Drivers/lvgl/src/draw/lv_draw_buf.c ****  * allocation size rather than the bytes actually in use).
 708:Drivers/lvgl/src/draw/lv_draw_buf.c ****  */
 709:Drivers/lvgl/src/draw/lv_draw_buf.c **** static uint32_t _calculate_draw_buf_size(uint32_t w, uint32_t h, lv_color_format_t cf, uint32_t str
 710:Drivers/lvgl/src/draw/lv_draw_buf.c **** {
 711:Drivers/lvgl/src/draw/lv_draw_buf.c ****     uint32_t size;
 712:Drivers/lvgl/src/draw/lv_draw_buf.c **** 
 713:Drivers/lvgl/src/draw/lv_draw_buf.c ****     if(stride == 0) stride = lv_draw_buf_width_to_stride(w, cf);
 714:Drivers/lvgl/src/draw/lv_draw_buf.c **** 
 715:Drivers/lvgl/src/draw/lv_draw_buf.c ****     size = stride * h;
 716:Drivers/lvgl/src/draw/lv_draw_buf.c ****     if(cf == LV_COLOR_FORMAT_RGB565A8) {
 717:Drivers/lvgl/src/draw/lv_draw_buf.c ****         size += (stride / 2) * h; /*A8 mask*/
 718:Drivers/lvgl/src/draw/lv_draw_buf.c ****     }
 719:Drivers/lvgl/src/draw/lv_draw_buf.c ****     else if(LV_COLOR_FORMAT_IS_INDEXED(cf)) {
 720:Drivers/lvgl/src/draw/lv_draw_buf.c ****         /*@todo we have to include palette right before image data*/
 721:Drivers/lvgl/src/draw/lv_draw_buf.c ****         size += LV_COLOR_INDEXED_PALETTE_SIZE(cf) * 4;
 722:Drivers/lvgl/src/draw/lv_draw_buf.c ****     }
 723:Drivers/lvgl/src/draw/lv_draw_buf.c **** 
 724:Drivers/lvgl/src/draw/lv_draw_buf.c ****     return LV_ROUND_UP(size, LV_DRAW_BUF_ALIGN);
 725:Drivers/lvgl/src/draw/lv_draw_buf.c **** }
