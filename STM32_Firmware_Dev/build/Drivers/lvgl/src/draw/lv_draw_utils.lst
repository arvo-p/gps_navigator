 158:Drivers/lvgl/src/draw/lv_draw_utils.c **** void lv_draw_rgb565_swap(void * buf, uint32_t buf_size_px)
 159:Drivers/lvgl/src/draw/lv_draw_utils.c **** {
 160:Drivers/lvgl/src/draw/lv_draw_utils.c ****     LV_CHECK_ARG(buf != NULL, return);
 161:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 162:Drivers/lvgl/src/draw/lv_draw_utils.c ****     if(LV_DRAW_RGB565_SWAP(buf, buf_size_px) == LV_RESULT_OK) return;
 163:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 164:Drivers/lvgl/src/draw/lv_draw_utils.c ****     uint16_t * buf16 = buf;
 165:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 166:Drivers/lvgl/src/draw/lv_draw_utils.c ****     /*2 pixels will be processed later, so handle 1 pixel alignment*/
 167:Drivers/lvgl/src/draw/lv_draw_utils.c ****     if((lv_uintptr_t)buf16 & 0x2) {
 168:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf16[0] = ((buf16[0] & 0xff00) >> 8) | ((buf16[0] & 0x00ff) << 8);
 169:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf16++;
 170:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf_size_px--;
 171:Drivers/lvgl/src/draw/lv_draw_utils.c ****     }
 172:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 173:Drivers/lvgl/src/draw/lv_draw_utils.c ****     uint32_t * buf32 = (uint32_t *)buf16;
 174:Drivers/lvgl/src/draw/lv_draw_utils.c ****     uint32_t u32_cnt = buf_size_px / 2;
 175:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 176:Drivers/lvgl/src/draw/lv_draw_utils.c ****     while(u32_cnt >= 8) {
 177:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[0] = ((buf32[0] & 0xff00ff00) >> 8) | ((buf32[0] & 0x00ff00ff) << 8);
 178:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[1] = ((buf32[1] & 0xff00ff00) >> 8) | ((buf32[1] & 0x00ff00ff) << 8);
 179:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[2] = ((buf32[2] & 0xff00ff00) >> 8) | ((buf32[2] & 0x00ff00ff) << 8);
 180:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[3] = ((buf32[3] & 0xff00ff00) >> 8) | ((buf32[3] & 0x00ff00ff) << 8);
 181:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[4] = ((buf32[4] & 0xff00ff00) >> 8) | ((buf32[4] & 0x00ff00ff) << 8);
 182:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[5] = ((buf32[5] & 0xff00ff00) >> 8) | ((buf32[5] & 0x00ff00ff) << 8);
 183:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[6] = ((buf32[6] & 0xff00ff00) >> 8) | ((buf32[6] & 0x00ff00ff) << 8);
 184:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32[7] = ((buf32[7] & 0xff00ff00) >> 8) | ((buf32[7] & 0x00ff00ff) << 8);
 185:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32 += 8;
 186:Drivers/lvgl/src/draw/lv_draw_utils.c ****         u32_cnt -= 8;
 187:Drivers/lvgl/src/draw/lv_draw_utils.c ****     }
 188:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 189:Drivers/lvgl/src/draw/lv_draw_utils.c ****     while(u32_cnt) {
 190:Drivers/lvgl/src/draw/lv_draw_utils.c ****         *buf32 = ((*buf32 & 0xff00ff00) >> 8) | ((*buf32 & 0x00ff00ff) << 8);
 191:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf32++;
 192:Drivers/lvgl/src/draw/lv_draw_utils.c ****         u32_cnt--;
 193:Drivers/lvgl/src/draw/lv_draw_utils.c ****     }
 194:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 195:Drivers/lvgl/src/draw/lv_draw_utils.c ****     /*Process the last pixel if needed*/
 196:Drivers/lvgl/src/draw/lv_draw_utils.c ****     if(buf_size_px & 0x1) {
 197:Drivers/lvgl/src/draw/lv_draw_utils.c ****         uint32_t e = buf_size_px - 1;
 198:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf16[e] = ((buf16[e] & 0xff00) >> 8) | ((buf16[e] & 0x00ff) << 8);
 199:Drivers/lvgl/src/draw/lv_draw_utils.c ****     }
 200:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 201:Drivers/lvgl/src/draw/lv_draw_utils.c **** }
