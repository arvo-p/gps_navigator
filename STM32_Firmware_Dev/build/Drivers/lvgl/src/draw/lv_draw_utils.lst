 202:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 203:Drivers/lvgl/src/draw/lv_draw_utils.c **** void lv_draw_i1_invert(void * buf, uint32_t buf_size)
 204:Drivers/lvgl/src/draw/lv_draw_utils.c **** {
 205:Drivers/lvgl/src/draw/lv_draw_utils.c ****     LV_CHECK_ARG(buf != NULL, return);
 206:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 207:Drivers/lvgl/src/draw/lv_draw_utils.c ****     uint8_t * byte_buf = (uint8_t *)buf;
 208:Drivers/lvgl/src/draw/lv_draw_utils.c ****     uint32_t i;
 209:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 210:Drivers/lvgl/src/draw/lv_draw_utils.c ****     /*Make the buffer aligned*/
 211:Drivers/lvgl/src/draw/lv_draw_utils.c ****     while(((uintptr_t)(byte_buf) & (sizeof(int) - 1)) && buf_size > 0) {
 212:Drivers/lvgl/src/draw/lv_draw_utils.c ****         *byte_buf = ~(*byte_buf);
 213:Drivers/lvgl/src/draw/lv_draw_utils.c ****         byte_buf++;
 214:Drivers/lvgl/src/draw/lv_draw_utils.c ****         buf_size--;
 215:Drivers/lvgl/src/draw/lv_draw_utils.c ****     }
 216:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 217:Drivers/lvgl/src/draw/lv_draw_utils.c ****     if(buf_size >= sizeof(uint32_t)) {
 218:Drivers/lvgl/src/draw/lv_draw_utils.c ****         uint32_t * aligned_addr = (uint32_t *)byte_buf;
 219:Drivers/lvgl/src/draw/lv_draw_utils.c ****         uint32_t word_count = buf_size / 4;
