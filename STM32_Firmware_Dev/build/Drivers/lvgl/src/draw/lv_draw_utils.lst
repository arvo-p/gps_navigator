 135:Drivers/lvgl/src/draw/lv_draw_utils.c **** void lv_draw_i1_to_argb8888(const void * buf_i1, void * buf_argb8888, uint32_t width, uint32_t heig
 136:Drivers/lvgl/src/draw/lv_draw_utils.c ****                             uint32_t buf_i1_stride, uint32_t buf_argb8888_stride, uint32_t index0_c
 137:Drivers/lvgl/src/draw/lv_draw_utils.c **** {
 138:Drivers/lvgl/src/draw/lv_draw_utils.c ****     LV_CHECK_ARG(buf_i1 != NULL, return);
 139:Drivers/lvgl/src/draw/lv_draw_utils.c ****     LV_CHECK_ARG(buf_argb8888 != NULL, return);
 140:Drivers/lvgl/src/draw/lv_draw_utils.c **** 
 141:Drivers/lvgl/src/draw/lv_draw_utils.c ****     /*Extract the bits of I1 px_map and convert them to ARGB8888*/
 142:Drivers/lvgl/src/draw/lv_draw_utils.c ****     const uint8_t * src = buf_i1;
 143:Drivers/lvgl/src/draw/lv_draw_utils.c ****     uint32_t * dst = buf_argb8888;
 144:Drivers/lvgl/src/draw/lv_draw_utils.c ****     uint32_t i1_row_byte_count = width / 8;
ARM GAS  /tmp/ccMRemNS.s 			page 4


 145:Drivers/lvgl/src/draw/lv_draw_utils.c ****     for(uint32_t row = 0; row < height; row++) {
 146:Drivers/lvgl/src/draw/lv_draw_utils.c ****         uint32_t * dst_p = dst;
 147:Drivers/lvgl/src/draw/lv_draw_utils.c ****         for(uint32_t i = 0; i < i1_row_byte_count; i++) {
 148:Drivers/lvgl/src/draw/lv_draw_utils.c ****             /*From MSB to LSB (pixel 0 to pixel 7 in a byte)*/
 149:Drivers/lvgl/src/draw/lv_draw_utils.c ****             for(int32_t bit = 7; bit >= 0; bit--) {
 150:Drivers/lvgl/src/draw/lv_draw_utils.c ****                 *dst_p++ = ((src[i] >> bit) & 1) ? index1_color : index0_color;
 151:Drivers/lvgl/src/draw/lv_draw_utils.c ****             }
 152:Drivers/lvgl/src/draw/lv_draw_utils.c ****         }
 153:Drivers/lvgl/src/draw/lv_draw_utils.c ****         src += buf_i1_stride;
 154:Drivers/lvgl/src/draw/lv_draw_utils.c ****         dst += buf_argb8888_stride / 4;
 155:Drivers/lvgl/src/draw/lv_draw_utils.c ****     }
 156:Drivers/lvgl/src/draw/lv_draw_utils.c **** }
