  35:Drivers/lvgl/src/draw/../../include/lvgl/core/../font/../draw/../stdlib/lv_string.h ****  * @param len Number of bytes to copy.
  36:Drivers/lvgl/src/draw/../../include/lvgl/core/../font/../draw/../stdlib/lv_string.h ****  * @return Pointer to the destination array.
  37:Drivers/lvgl/src/draw/../../include/lvgl/core/../font/../draw/../stdlib/lv_string.h ****  * @note The function does not check for any overlapping of the source and destination memory block
  38:Drivers/lvgl/src/draw/../../include/lvgl/core/../font/../draw/../stdlib/lv_string.h ****  */
  39:Drivers/lvgl/src/draw/../../include/lvgl/core/../font/../draw/../stdlib/lv_string.h **** void * lv_memcpy(void * dst, const void * src, size_t len);
