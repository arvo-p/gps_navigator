 705:Drivers/lvgl/src/draw/lv_draw.c **** 
 706:Drivers/lvgl/src/draw/lv_draw.c ****     /*If t_check is outside of the older tasks then it's independent*/
 707:Drivers/lvgl/src/draw/lv_draw.c ****     while(t && t != t_check) {
 708:Drivers/lvgl/src/draw/lv_draw.c ****         /*It's independent of finished draw tasks, and queued draw tasks of the same draw unit,
 709:Drivers/lvgl/src/draw/lv_draw.c ****          *so no need to check it*/
 710:Drivers/lvgl/src/draw/lv_draw.c ****         if(t->state == LV_DRAW_TASK_STATE_FINISHED ||
 711:Drivers/lvgl/src/draw/lv_draw.c ****            (t->state == LV_DRAW_TASK_STATE_QUEUED && t->preferred_draw_unit_id == draw_unit_id)) {
 712:Drivers/lvgl/src/draw/lv_draw.c ****             t = t->next;
 713:Drivers/lvgl/src/draw/lv_draw.c ****             continue;
 714:Drivers/lvgl/src/draw/lv_draw.c ****         }
