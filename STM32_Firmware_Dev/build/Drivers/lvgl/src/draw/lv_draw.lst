 694:Drivers/lvgl/src/draw/lv_draw.c **** /**
 695:Drivers/lvgl/src/draw/lv_draw.c ****  * Check if there are older draw task overlapping the area of `t_check`
 696:Drivers/lvgl/src/draw/lv_draw.c ****  * @param layer         the draw ctx to search in
 697:Drivers/lvgl/src/draw/lv_draw.c ****  * @param t_check       check this task if it overlaps with the older ones
 698:Drivers/lvgl/src/draw/lv_draw.c ****  * @param draw_unit_id  draw unit ID for which the independence check is called
 699:Drivers/lvgl/src/draw/lv_draw.c ****  * @return              true: `t_check` is not overlapping with older tasks so it's independent
 700:Drivers/lvgl/src/draw/lv_draw.c ****  */
 701:Drivers/lvgl/src/draw/lv_draw.c **** static bool is_independent(lv_layer_t * layer, lv_draw_task_t * t_check, uint8_t draw_unit_id)
 702:Drivers/lvgl/src/draw/lv_draw.c **** {
 703:Drivers/lvgl/src/draw/lv_draw.c ****     LV_PROFILER_DRAW_BEGIN;
