 158:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** /**
 159:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * Test if char is break char or not (a text can broken here or not)
 160:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * @param letter a letter
 161:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * @return false: 'letter' is not break char
 162:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  */
 163:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** static inline bool lv_text_is_break_char(uint32_t letter)
 164:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** {
 165:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     uint8_t i;
 166:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     bool ret = false;
 167:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 168:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     /*Compare the letter to TXT_BREAK_CHARS*/
 169:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     for(i = 0; LV_TXT_BREAK_CHARS[i] != '\0'; i++) {
 170:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****         if(letter == (uint32_t)LV_TXT_BREAK_CHARS[i]) {
 171:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****             ret = true; /*If match then it is break char*/
 172:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****             break;
 173:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****         }
 174:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     }
 175:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 176:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     return ret;
 177:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** }
 178:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 179:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** /**
 180:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * Test if char is white space which may hang out of the end of a line
 181:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * @param letter a letter
 182:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * @return false: 'letter' is not hangable white space
 183:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  */
 184:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** static inline bool lv_text_is_hanging_space(uint32_t letter)
 185:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** {
 186:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     return letter == ' ' || letter == '\n' || letter == '\r';
 187:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** }
 188:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 189:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** /**
 190:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * Test if char is break char or not (a text can broken here or not)
 191:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * @param letter a letter
 192:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  * @return false: 'letter' is not break char
 193:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****  */
 194:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** static inline bool lv_text_is_a_word(uint32_t letter)
 195:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** {
 196:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     /*Cheap check on invalid letter*/
 197:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter == 0) return false;
 198:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 199:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     /*CJK Unified Ideographs*/
 200:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0x4E00 && letter <= 0x9FFF) {
ARM GAS  /tmp/ccTxGZ0Z.s 			page 5


 201:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 202:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     }
 203:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 204:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     /*Fullwidth ASCII variants*/
 205:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0xFF01 && letter <= 0xFF5E) {
 206:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 207:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     }
 208:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 209:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     /*CJK symbols and punctuation*/
 210:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0x3000 && letter <= 0x303F) {
 211:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 212:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     }
 213:Drivers/lvgl/src/draw/../misc/lv_text_private.h **** 
 214:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     /*CJK Radicals Supplement*/
 215:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0x2E80 && letter <= 0x2EFF) {
 216:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 217:Drivers/lvgl/src/draw/../misc/lv_text_private.h ****     }
