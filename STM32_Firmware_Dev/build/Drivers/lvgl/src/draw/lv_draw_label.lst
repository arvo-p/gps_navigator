  48:Drivers/lvgl/src/draw/../misc/lv_bidi_private.h ****  * @return `LV_BASE_DIR_LTR` or `LV_BASE_DIR_RTL`
  49:Drivers/lvgl/src/draw/../misc/lv_bidi_private.h ****  */
