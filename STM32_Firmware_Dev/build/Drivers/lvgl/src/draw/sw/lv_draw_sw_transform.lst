 135:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** 
 136:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** /**
 137:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * Undo the alpha scaling of a premultiplied pixel, giving back a straight color.
 138:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * Shared so the output formats that need it can't drift apart.
 139:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * @param c     a premultiplied pixel
 140:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * @return      the same pixel with straight channels
 141:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  */
 142:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** static inline lv_color32_t LV_ATTRIBUTE_FAST_MEM lv_color32_unpremultiply(lv_color32_t c)
 143:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** {
 144:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     if(c.alpha == 0) {
ARM GAS  /tmp/ccBKHnSv.s 			page 4


 145:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.red = 0;
 146:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.green = 0;
 147:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.blue = 0;
 148:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     }
 149:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     else if(c.alpha != LV_OPA_COVER) {
 150:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t reciprocal = (255u * 256u) / c.alpha;
 151:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t r = (c.red * reciprocal) >> 8;
 152:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t g = (c.green * reciprocal) >> 8;
 153:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t b = (c.blue * reciprocal) >> 8;
 154:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.red = (uint8_t)(r > 255 ? 255 : r);
 155:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.green = (uint8_t)(g > 255 ? 255 : g);
 156:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.blue = (uint8_t)(b > 255 ? 255 : b);
 157:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     }
 158:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** 
