 162:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** /**
 163:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * Luminance of an image pixel for the grayscale and indexed outputs. A premultiplied source
 164:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * has its channels already scaled by its alpha, so undo that first to get the same value a
 165:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * straight source would give.
 166:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * @param c                 the pixel
 167:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * @param premultiplied     true: `c` is premultiplied
 168:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * @return                  the luminance, 0..255
 169:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  */
 170:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** static inline uint8_t LV_ATTRIBUTE_FAST_MEM lv_color32_lumi_of(lv_color32_t c, bool premultiplied)
 171:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** {
 172:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     if(!premultiplied || c.alpha == 0 || c.alpha == LV_OPA_COVER) return lv_color32_luminance(c);
 173:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** 
 174:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     uint32_t lumi = (lv_color32_luminance(c) * ((255u * 256u) / c.alpha)) >> 8;
