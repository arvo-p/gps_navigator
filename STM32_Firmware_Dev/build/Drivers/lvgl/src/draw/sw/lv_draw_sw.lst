 265:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** static int32_t dispatch(lv_draw_unit_t * draw_unit, lv_layer_t * layer)
 266:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** {
 267:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     LV_PROFILER_DRAW_BEGIN;
 268:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     lv_draw_sw_unit_t * draw_sw_unit = (lv_draw_sw_unit_t *) draw_unit;
 269:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
ARM GAS  /tmp/ccYq2CvM.s 			page 8


 270:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** #if LV_USE_OS
 271:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     uint32_t i;
 272:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     uint32_t taken_cnt = 0;
 273:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     /* All idle (couldn't take any tasks): return LV_DRAW_UNIT_IDLE;
 274:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****      * All busy: return 0; as 0 tasks were taken
 275:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****      * Otherwise return taken_cnt;
 276:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****      */
 277:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 278:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     /*If at least one is busy, it's not all idle*/
 279:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     bool all_idle = true;
 280:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     for(i = 0; i < LV_DRAW_SW_DRAW_UNIT_CNT; i++) {
 281:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         if(draw_sw_unit->thread_dscs[i].task_act) {
 282:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****             all_idle = false;
 283:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****             break;
 284:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         }
 285:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     }
 286:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 287:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     lv_draw_task_t * t = NULL;
 288:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     for(i = 0; i < LV_DRAW_SW_DRAW_UNIT_CNT; i++) {
 289:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         lv_draw_sw_thread_dsc_t * thread_dsc = &draw_sw_unit->thread_dscs[i];
 290:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 291:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         /*Do nothing if busy*/
 292:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         if(thread_dsc->task_act) continue;
 293:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 294:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         /*Find an available task. Start from the previously taken task.*/
 295:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         t = lv_draw_get_next_available_task(layer, t, DRAW_UNIT_ID_SW);
 296:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 297:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         /*If there is not available task don't try other threads as there won't be available
 298:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****          *tasks for then either*/
 299:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         if(t == NULL) {
 300:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****             LV_PROFILER_DRAW_END;
 301:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****             if(all_idle) return LV_DRAW_UNIT_IDLE;  /*Couldn't start rendering*/
 302:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****             else return taken_cnt;
 303:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         }
 304:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 305:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         /*Allocate a buffer if not done yet.*/
 306:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         void * buf = lv_draw_layer_alloc_buf(layer);
 307:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         /*Do not return is failed. The other thread might already have a buffer can do something. *
 308:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         if(buf == NULL) {
 309:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****             t->state = LV_DRAW_TASK_STATE_FAILED;
 310:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****             continue;
 311:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         }
 312:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 313:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         /*Take the task*/
 314:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         all_idle = false;
 315:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         taken_cnt++;
 316:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         t->state = LV_DRAW_TASK_STATE_IN_PROGRESS;
 317:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         thread_dsc->task_act = t;
 318:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 319:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         /*Let the render thread work*/
 320:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         lv_thread_sync_signal(&thread_dsc->new_task_sync);
 321:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     }
 322:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 323:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     LV_PROFILER_DRAW_END;
 324:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     if(all_idle) return LV_DRAW_UNIT_IDLE;  /*Couldn't start rendering*/
 325:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     else return taken_cnt;
 326:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
ARM GAS  /tmp/ccYq2CvM.s 			page 9


 327:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** #else
 328:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     /*Return immediately if it's busy with draw task*/
 329:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     if(draw_sw_unit->task_act) {
 330:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         LV_PROFILER_DRAW_END;
 331:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         return 0;
 332:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     }
 333:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 334:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     lv_draw_task_t * t = NULL;
 335:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     t = lv_draw_get_available_task(layer, NULL, DRAW_UNIT_ID_SW);
 336:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     if(t == NULL) {
 337:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         LV_PROFILER_DRAW_END;
 338:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         return LV_DRAW_UNIT_IDLE;  /*Couldn't start rendering*/
 339:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     }
 340:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 341:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     void * buf = lv_draw_layer_alloc_buf(layer);
 342:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     if(buf == NULL) {
 343:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         t->state = LV_DRAW_TASK_STATE_FAILED;
 344:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         LV_PROFILER_DRAW_END;
 345:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****         return LV_DRAW_UNIT_IDLE;  /*Couldn't start rendering*/
 346:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     }
 347:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 348:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     t->state = LV_DRAW_TASK_STATE_IN_PROGRESS;
 349:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     draw_sw_unit->task_act = t;
 350:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 351:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     execute_drawing(t);
 352:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     draw_sw_unit->task_act->state = LV_DRAW_TASK_STATE_FINISHED;
 353:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     draw_sw_unit->task_act = NULL;
 354:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 355:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     /*The draw unit is free now. Request a new dispatching as it can get a new task*/
 356:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     lv_draw_dispatch_request();
 357:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** 
 358:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     LV_PROFILER_DRAW_END;
 359:Drivers/lvgl/src/draw/sw/lv_draw_sw.c ****     return 1;
 360:Drivers/lvgl/src/draw/sw/lv_draw_sw.c **** #endif
