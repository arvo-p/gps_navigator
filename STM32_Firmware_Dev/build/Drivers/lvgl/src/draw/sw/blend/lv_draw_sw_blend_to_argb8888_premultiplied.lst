 155:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.green = (uint8_t)(g > 255 ? 255 : g);
 156:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.blue = (uint8_t)(b > 255 ? 255 : b);
 157:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     }
