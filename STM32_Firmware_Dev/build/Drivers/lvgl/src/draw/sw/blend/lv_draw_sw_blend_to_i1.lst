 125:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     do {                                                                                    \
 126:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t bg_prep_ = LV_COLOR_MIX_16_PREPARE(bg);                                    \
 127:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t mix5_ = ((uint32_t)(mix) + 4) >> 3;                                        \
 128:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t res_ = (((((fg_prep) - bg_prep_) * mix5_) >> 5) + bg_prep_) & 0x07E0F81Fu; \
 129:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         (res) = (uint16_t)((res_ >> 16) | res_);                                            \
 130:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     } while(0)
