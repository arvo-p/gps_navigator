 143:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** {
 144:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     if(c.alpha == 0) {
ARM GAS  /tmp/ccwgcD1o.s 			page 4


 145:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.red = 0;
 146:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.green = 0;
 147:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         c.blue = 0;
 148:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     }
 149:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     else if(c.alpha != LV_OPA_COVER) {
