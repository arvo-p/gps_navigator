 233:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c **** #define RGB565_MASK_FILL_PX(dest_px, mask_val)                                  \
 234:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****     do {                                                                        \
 235:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****         uint32_t a_ = (mask_val);                                               \
 236:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****         if(a_) {                                                                \
 237:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****             if(a_ >= LV_OPA_MAX) (dest_px) = color16;                           \
 238:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****             else LV_COLOR_MIX_16_TO_16_PREPARED(dest_px, fg_prep, dest_px, a_); \
 239:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****         }                                                                       \
 240:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****     } while(0)
