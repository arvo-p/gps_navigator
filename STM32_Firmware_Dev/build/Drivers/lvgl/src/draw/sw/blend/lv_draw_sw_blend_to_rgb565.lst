 105:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** /**
 106:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * Prepare an RGB565 color for mixing: spread it over 32 bits so each channel gets room to
 107:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * grow and a whole pixel can be mixed with one multiplication.
 108:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * See https://stackoverflow.com/a/50012418/1999969
 109:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  */
 110:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** #define LV_COLOR_MIX_16_PREPARE(c) ((((uint32_t)(c)) | (((uint32_t)(c)) << 16)) & 0x07E0F81Fu)
 111:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** 
 112:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** /**
 113:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * Convert RGB888 to RGB565.
 114:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  */
 115:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** #define LV_COLOR_24_TO_16(c1) \
 116:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     ((uint16_t)((((c1)[2] & 0xF8) << 8) + (((c1)[1] & 0xFC) << 3) + (((c1)[0] & 0xF8) >> 3)))
 117:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** 
 118:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** /**
 119:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * Mix a prepared foreground into an RGB565 background. `mix` must be 1..254, the
 120:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * callers handle 0 and 255 themselves. `res` may be the same variable as `bg`.
 121:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * A macro and not a function because -Os inlines neither, and this runs on every pixel.
 122:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  * See https://stackoverflow.com/a/50012418/1999969
 123:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****  */
 124:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** #define LV_COLOR_MIX_16_TO_16_PREPARED(res, fg_prep, bg, mix)                               \
 125:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     do {                                                                                    \
 126:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t bg_prep_ = LV_COLOR_MIX_16_PREPARE(bg);                                    \
 127:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t mix5_ = ((uint32_t)(mix) + 4) >> 3;                                        \
 128:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         uint32_t res_ = (((((fg_prep) - bg_prep_) * mix5_) >> 5) + bg_prep_) & 0x07E0F81Fu; \
 129:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****         (res) = (uint16_t)((res_ >> 16) | res_);                                            \
 130:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h ****     } while(0)
 131:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_private.h **** 
