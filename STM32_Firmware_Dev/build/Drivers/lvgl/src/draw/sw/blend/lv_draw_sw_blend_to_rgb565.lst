 242:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c **** /**
 243:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * One pixel of the opacity only fill, through the cache: a repeat costs a compare, and the
 244:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * result is kept as the pair so the paired loop can store it in one go.
 245:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * A macro because -Os doesn't inline helpers, and this runs on every pixel.
 246:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  */
 247:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c **** #define RGB565_OPA_FILL_PX(dest_px)                                     \
 248:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****     do {                                                                \
 249:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****         uint16_t d_ = (dest_px);                                        \
 250:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****         if(last_dest_color != d_) {                                     \
 251:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****             uint16_t res_ = lv_color_16_16_mix(color16, d_, opa);       \
 252:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****             last_dest_color = d_;                                       \
 253:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****             last_res32_color = (uint32_t)res_ | ((uint32_t)res_ << 16); \
 254:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****         }                                                               \
 255:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****         (dest_px) = (uint16_t)last_res32_color;                         \
 256:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****     } while(0)
 257:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c **** 
 258:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c **** /**
ARM GAS  /tmp/ccenNwPX.s 			page 11


 259:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * Fill an area with a color.
 260:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * Supports normal fill, fill with opacity, fill with mask, and fill with mask and opacity.
 261:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * dest_buf and color have native color depth. (RGB565, RGB888, XRGB8888)
 262:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * The background (dest_buf) cannot have alpha channel
 263:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  * @param dsc            the fill descriptor holding the destination buffer, area and
 264:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  *                       stride, the fill color, the opacity and the optional mask
 265:Drivers/lvgl/src/draw/sw/blend/lv_draw_sw_blend_to_rgb565.c ****  */
