 192:Drivers/lvgl/src/draw/sw/lv_draw_sw_border.c ****     /*Left and right corner together if they are close to each other*/
 193:Drivers/lvgl/src/draw/sw/lv_draw_sw_border.c ****     if(!split_hor) {
 194:Drivers/lvgl/src/draw/sw/lv_draw_sw_border.c ****         /*Calculate the top corner and mirror it to the bottom*/
 195:Drivers/lvgl/src/draw/sw/lv_draw_sw_border.c ****         blend_area.x1 = draw_area.x1;
 196:Drivers/lvgl/src/draw/sw/lv_draw_sw_border.c ****         blend_area.x2 = draw_area.x2;
 197:Drivers/lvgl/src/draw/sw/lv_draw_sw_border.c ****         int32_t max_h = LV_MAX(rout, inner_area->y1 - outer_area->y1);
