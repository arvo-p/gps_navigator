 322:Drivers/lvgl/src/core/lv_obj_scroll.c ****         }
 323:Drivers/lvgl/src/core/lv_obj_scroll.c ****     }
 324:Drivers/lvgl/src/core/lv_obj_scroll.c **** 
 325:Drivers/lvgl/src/core/lv_obj_scroll.c ****     /*Don't let scroll more than naturally possible by the size of the content*/
 326:Drivers/lvgl/src/core/lv_obj_scroll.c ****     int32_t y_current = -lv_obj_get_scroll_y(obj);
 327:Drivers/lvgl/src/core/lv_obj_scroll.c ****     int32_t y_bounded = y_current + dy;
