 239:Drivers/lvgl/src/core/lv_obj_scroll.c **** int32_t lv_obj_get_scroll_right(const lv_obj_t * obj)
 240:Drivers/lvgl/src/core/lv_obj_scroll.c **** {
 241:Drivers/lvgl/src/core/lv_obj_scroll.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return 0);
 242:Drivers/lvgl/src/core/lv_obj_scroll.c **** 
 243:Drivers/lvgl/src/core/lv_obj_scroll.c ****     /*With RTL base dir can't scroll to the object out on the right.
 244:Drivers/lvgl/src/core/lv_obj_scroll.c ****      *So simply use the current scroll position as "right size"*/
 245:Drivers/lvgl/src/core/lv_obj_scroll.c ****     if(lv_obj_get_style_base_dir_internal(obj, LV_PART_MAIN) == LV_BASE_DIR_RTL) {
 246:Drivers/lvgl/src/core/lv_obj_scroll.c ****         if(obj->spec_attr == NULL) return 0;
 247:Drivers/lvgl/src/core/lv_obj_scroll.c ****         return obj->spec_attr->scroll.x;
 248:Drivers/lvgl/src/core/lv_obj_scroll.c ****     }
 249:Drivers/lvgl/src/core/lv_obj_scroll.c **** 
 250:Drivers/lvgl/src/core/lv_obj_scroll.c ****     /*With other base direction (LTR) scrolling to the right is normal so find the right most coord
 251:Drivers/lvgl/src/core/lv_obj_scroll.c ****     int32_t child_res = LV_COORD_MIN;
 252:Drivers/lvgl/src/core/lv_obj_scroll.c ****     uint32_t i;
 253:Drivers/lvgl/src/core/lv_obj_scroll.c ****     uint32_t child_cnt = lv_obj_get_child_count(obj);
 254:Drivers/lvgl/src/core/lv_obj_scroll.c ****     for(i = 0; i < child_cnt; i++) {
 255:Drivers/lvgl/src/core/lv_obj_scroll.c ****         const lv_obj_t * child = obj->spec_attr->children[i];
 256:Drivers/lvgl/src/core/lv_obj_scroll.c ****         if((lv_obj_is_hidden(child) || lv_obj_is_floating(child))) continue;
 257:Drivers/lvgl/src/core/lv_obj_scroll.c **** 
 258:Drivers/lvgl/src/core/lv_obj_scroll.c ****         int32_t tmp_x = child->coords.x2 + lv_obj_get_style_margin_right_internal(child, LV_PART_MA
 259:Drivers/lvgl/src/core/lv_obj_scroll.c ****         child_res = LV_MAX(child_res, tmp_x);
 260:Drivers/lvgl/src/core/lv_obj_scroll.c ****     }
 261:Drivers/lvgl/src/core/lv_obj_scroll.c **** 
 262:Drivers/lvgl/src/core/lv_obj_scroll.c ****     int32_t space_right = lv_obj_get_style_space_right_internal(obj, LV_PART_MAIN);
 263:Drivers/lvgl/src/core/lv_obj_scroll.c ****     int32_t space_left = lv_obj_get_style_space_left_internal(obj, LV_PART_MAIN);
 264:Drivers/lvgl/src/core/lv_obj_scroll.c **** 
 265:Drivers/lvgl/src/core/lv_obj_scroll.c ****     if(child_res != LV_COORD_MIN) {
 266:Drivers/lvgl/src/core/lv_obj_scroll.c ****         child_res -= (obj->coords.x2 - space_right);
 267:Drivers/lvgl/src/core/lv_obj_scroll.c ****     }
 268:Drivers/lvgl/src/core/lv_obj_scroll.c **** 
 269:Drivers/lvgl/src/core/lv_obj_scroll.c ****     int32_t self_w;
 270:Drivers/lvgl/src/core/lv_obj_scroll.c ****     self_w = lv_obj_get_self_width(obj);
 271:Drivers/lvgl/src/core/lv_obj_scroll.c ****     self_w = self_w - (lv_obj_get_width(obj) - space_right - space_left);
 272:Drivers/lvgl/src/core/lv_obj_scroll.c ****     self_w -= lv_obj_get_scroll_x(obj);
 273:Drivers/lvgl/src/core/lv_obj_scroll.c ****     return LV_MAX(child_res, self_w);
 274:Drivers/lvgl/src/core/lv_obj_scroll.c **** }
