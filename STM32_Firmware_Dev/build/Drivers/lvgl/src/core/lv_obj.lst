 392:Drivers/lvgl/src/core/lv_obj.c **** void lv_obj_set_hidden(lv_obj_t * obj, bool en)
 393:Drivers/lvgl/src/core/lv_obj.c **** {
 394:Drivers/lvgl/src/core/lv_obj.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 395:Drivers/lvgl/src/core/lv_obj.c ****     if(obj->hidden == en) return;
 396:Drivers/lvgl/src/core/lv_obj.c **** 
 397:Drivers/lvgl/src/core/lv_obj.c ****     bool was_on_layout = lv_obj_is_layout_positioned(obj);
 398:Drivers/lvgl/src/core/lv_obj.c **** 
 399:Drivers/lvgl/src/core/lv_obj.c ****     /*Invalidate while still visible*/
 400:Drivers/lvgl/src/core/lv_obj.c ****     if(!obj->hidden) lv_obj_invalidate(obj);
 401:Drivers/lvgl/src/core/lv_obj.c **** 
 402:Drivers/lvgl/src/core/lv_obj.c ****     obj->hidden = en;
 403:Drivers/lvgl/src/core/lv_obj.c **** 
 404:Drivers/lvgl/src/core/lv_obj.c ****     /*Invalidate when visible again*/
 405:Drivers/lvgl/src/core/lv_obj.c ****     if(!obj->hidden) lv_obj_invalidate(obj);
 406:Drivers/lvgl/src/core/lv_obj.c **** 
 407:Drivers/lvgl/src/core/lv_obj.c ****     /*Focus the next next item when this one get hidden*/
 408:Drivers/lvgl/src/core/lv_obj.c ****     if(obj->hidden && has_state(obj, LV_STATE_FOCUSED)) {
 409:Drivers/lvgl/src/core/lv_obj.c ****         lv_group_t * group = lv_obj_get_group(obj);
 410:Drivers/lvgl/src/core/lv_obj.c ****         if(group != NULL) {
 411:Drivers/lvgl/src/core/lv_obj.c ****             lv_group_focus_next(group);
 412:Drivers/lvgl/src/core/lv_obj.c ****             lv_obj_t * next_obj = lv_group_get_focused(group);
 413:Drivers/lvgl/src/core/lv_obj.c ****             if(next_obj != NULL) {
 414:Drivers/lvgl/src/core/lv_obj.c ****                 lv_obj_invalidate(next_obj);
 415:Drivers/lvgl/src/core/lv_obj.c ****             }
 416:Drivers/lvgl/src/core/lv_obj.c ****         }
 417:Drivers/lvgl/src/core/lv_obj.c ****     }
 418:Drivers/lvgl/src/core/lv_obj.c **** 
 419:Drivers/lvgl/src/core/lv_obj.c ****     if((was_on_layout != lv_obj_is_layout_positioned(obj))) {
 420:Drivers/lvgl/src/core/lv_obj.c ****         lv_obj_mark_layout_as_dirty(lv_obj_get_parent(obj));
 421:Drivers/lvgl/src/core/lv_obj.c ****         lv_obj_mark_layout_as_dirty(obj);
 422:Drivers/lvgl/src/core/lv_obj.c ****     }
ARM GAS  /tmp/cclsAEoe.s 			page 13


 423:Drivers/lvgl/src/core/lv_obj.c **** }
