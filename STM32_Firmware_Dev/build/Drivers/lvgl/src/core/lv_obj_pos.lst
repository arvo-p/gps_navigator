 322:Drivers/lvgl/src/core/lv_obj_pos.c **** void lv_obj_update_layout(const lv_obj_t * obj)
 323:Drivers/lvgl/src/core/lv_obj_pos.c **** {
 324:Drivers/lvgl/src/core/lv_obj_pos.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 325:Drivers/lvgl/src/core/lv_obj_pos.c **** 
 326:Drivers/lvgl/src/core/lv_obj_pos.c ****     if(update_layout_mutex) {
 327:Drivers/lvgl/src/core/lv_obj_pos.c ****         LV_LOG_TRACE("Already running, returning");
 328:Drivers/lvgl/src/core/lv_obj_pos.c ****         return;
 329:Drivers/lvgl/src/core/lv_obj_pos.c ****     }
 330:Drivers/lvgl/src/core/lv_obj_pos.c ****     LV_PROFILER_LAYOUT_BEGIN;
 331:Drivers/lvgl/src/core/lv_obj_pos.c ****     update_layout_mutex = true;
 332:Drivers/lvgl/src/core/lv_obj_pos.c **** 
 333:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_obj_t * scr = lv_obj_get_screen(obj);
 334:Drivers/lvgl/src/core/lv_obj_pos.c ****     /*Repeat until there are no more layout invalidations*/
 335:Drivers/lvgl/src/core/lv_obj_pos.c ****     uint32_t pass_cnt = 0;
 336:Drivers/lvgl/src/core/lv_obj_pos.c ****     while(scr->scr_layout_inv) {
 337:Drivers/lvgl/src/core/lv_obj_pos.c ****         if(pass_cnt >= LV_OBJ_LAYOUT_UPDATE_MAX_PASSES) {
 338:Drivers/lvgl/src/core/lv_obj_pos.c ****             LV_ASSERT_FORMAT_MSG(false,
 339:Drivers/lvgl/src/core/lv_obj_pos.c ****                                  "Layout of screen %p (class: '%s') didn't settle in %d passes, giv
 340:Drivers/lvgl/src/core/lv_obj_pos.c ****                                  "sizes probably depend on each other circularly. Please report it 
 341:Drivers/lvgl/src/core/lv_obj_pos.c ****                                  (void *)scr, scr->class_p->name, LV_OBJ_LAYOUT_UPDATE_MAX_PASSES);
 342:Drivers/lvgl/src/core/lv_obj_pos.c ****             /*Reached only if the assert handler returns*/
 343:Drivers/lvgl/src/core/lv_obj_pos.c ****             scr->scr_layout_inv = 0;
 344:Drivers/lvgl/src/core/lv_obj_pos.c ****             break;
 345:Drivers/lvgl/src/core/lv_obj_pos.c ****         }
 346:Drivers/lvgl/src/core/lv_obj_pos.c ****         pass_cnt++;
 347:Drivers/lvgl/src/core/lv_obj_pos.c ****         LV_LOG_TRACE("Layout update begin");
 348:Drivers/lvgl/src/core/lv_obj_pos.c ****         scr->scr_layout_inv = 0;
 349:Drivers/lvgl/src/core/lv_obj_pos.c ****         layout_update_core(scr);
 350:Drivers/lvgl/src/core/lv_obj_pos.c ****         LV_LOG_TRACE("Layout update end");
 351:Drivers/lvgl/src/core/lv_obj_pos.c ****     }
 352:Drivers/lvgl/src/core/lv_obj_pos.c **** 
 353:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_display_t * disp = lv_obj_get_display(scr);
 354:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_display_send_event(disp, LV_EVENT_UPDATE_LAYOUT_COMPLETED, NULL);
 355:Drivers/lvgl/src/core/lv_obj_pos.c ****     update_layout_mutex = false;
 356:Drivers/lvgl/src/core/lv_obj_pos.c ****     LV_PROFILER_LAYOUT_END;
 357:Drivers/lvgl/src/core/lv_obj_pos.c **** }
