 891:Drivers/lvgl/src/core/lv_obj_pos.c **** void lv_obj_move_to(lv_obj_t * obj, int32_t x, int32_t y)
 892:Drivers/lvgl/src/core/lv_obj_pos.c **** {
 893:Drivers/lvgl/src/core/lv_obj_pos.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return);
 894:Drivers/lvgl/src/core/lv_obj_pos.c **** 
 895:Drivers/lvgl/src/core/lv_obj_pos.c ****     /*Convert x and y to absolute coordinates*/
 896:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_obj_t * parent = obj->parent;
 897:Drivers/lvgl/src/core/lv_obj_pos.c **** 
 898:Drivers/lvgl/src/core/lv_obj_pos.c ****     if(parent) {
 899:Drivers/lvgl/src/core/lv_obj_pos.c ****         if(lv_obj_is_floating(obj)) {
 900:Drivers/lvgl/src/core/lv_obj_pos.c ****             x += parent->coords.x1;
 901:Drivers/lvgl/src/core/lv_obj_pos.c ****             y += parent->coords.y1;
 902:Drivers/lvgl/src/core/lv_obj_pos.c ****         }
 903:Drivers/lvgl/src/core/lv_obj_pos.c ****         else {
 904:Drivers/lvgl/src/core/lv_obj_pos.c ****             x += parent->coords.x1 - lv_obj_get_scroll_x(parent);
 905:Drivers/lvgl/src/core/lv_obj_pos.c ****             y += parent->coords.y1 - lv_obj_get_scroll_y(parent);
 906:Drivers/lvgl/src/core/lv_obj_pos.c ****         }
 907:Drivers/lvgl/src/core/lv_obj_pos.c **** 
 908:Drivers/lvgl/src/core/lv_obj_pos.c ****         x += lv_obj_get_style_space_left_internal(parent, LV_PART_MAIN);
 909:Drivers/lvgl/src/core/lv_obj_pos.c ****         y += lv_obj_get_style_space_top_internal(parent, LV_PART_MAIN);
 910:Drivers/lvgl/src/core/lv_obj_pos.c ****     }
