1029:Drivers/lvgl/src/core/lv_obj_pos.c **** /*
1030:Drivers/lvgl/src/core/lv_obj_pos.c ****  * Deferred blur invalidation expansion. A blur object samples the pixels
1031:Drivers/lvgl/src/core/lv_obj_pos.c ****  * behind it, so when anything behind it changes the blur object must be
1032:Drivers/lvgl/src/core/lv_obj_pos.c ****  * redrawn too. Once per frame, after all invalidations are collected, walk
1033:Drivers/lvgl/src/core/lv_obj_pos.c ****  * the tree and add the full extent of any blur object overlapping an
1034:Drivers/lvgl/src/core/lv_obj_pos.c ****  * invalidated area. The walk repeats until a pass adds no new areas, which
1035:Drivers/lvgl/src/core/lv_obj_pos.c ****  * catches transitive cases (a blur object overlapping another blur object
1036:Drivers/lvgl/src/core/lv_obj_pos.c ****  * that overlaps an invalidated area).
1037:Drivers/lvgl/src/core/lv_obj_pos.c ****  *
1038:Drivers/lvgl/src/core/lv_obj_pos.c ****  * Each widget's blur status is cached in obj->has_blur and counted globally in
1039:Drivers/lvgl/src/core/lv_obj_pos.c ****  * blur_obj_cnt (see lv_obj_update_blur_status()), so the walk is skipped
1040:Drivers/lvgl/src/core/lv_obj_pos.c ****  * entirely while no widget has blur and costs one bit test per widget when it
1041:Drivers/lvgl/src/core/lv_obj_pos.c ****  * does run.
1042:Drivers/lvgl/src/core/lv_obj_pos.c ****  */
