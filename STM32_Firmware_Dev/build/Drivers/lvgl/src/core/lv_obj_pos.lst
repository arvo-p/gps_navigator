1054:Drivers/lvgl/src/core/lv_obj_pos.c **** 
1055:Drivers/lvgl/src/core/lv_obj_pos.c ****     /*The invalidated areas are in screen coordinates so check the overlap
1056:Drivers/lvgl/src/core/lv_obj_pos.c ****      *against the transformed area*/
ARM GAS  /tmp/ccTcsi73.s 			page 20


1057:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_area_t scr_coords;
1058:Drivers/lvgl/src/core/lv_obj_pos.c ****     scr_coords = obj_coords;
1059:Drivers/lvgl/src/core/lv_obj_pos.c ****     if(is_transformed(obj)) {
1060:Drivers/lvgl/src/core/lv_obj_pos.c ****         lv_obj_get_transformed_area(obj, &scr_coords, LV_OBJ_POINT_TRANSFORM_FLAG_RECURSIVE);
1061:Drivers/lvgl/src/core/lv_obj_pos.c ****     }
1062:Drivers/lvgl/src/core/lv_obj_pos.c **** 
1063:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_display_t * disp = user_data;
1064:Drivers/lvgl/src/core/lv_obj_pos.c ****     uint32_t i;
1065:Drivers/lvgl/src/core/lv_obj_pos.c ****     for(i = 0; i < disp->inv_p; i++) {
