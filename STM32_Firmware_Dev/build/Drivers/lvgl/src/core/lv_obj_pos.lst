 912:Drivers/lvgl/src/core/lv_obj_pos.c ****     /*Calculate and set the movement*/
 913:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_point_t diff;
 914:Drivers/lvgl/src/core/lv_obj_pos.c ****     diff.x = x - obj->coords.x1;
 915:Drivers/lvgl/src/core/lv_obj_pos.c ****     diff.y = y - obj->coords.y1;
 916:Drivers/lvgl/src/core/lv_obj_pos.c **** 
 917:Drivers/lvgl/src/core/lv_obj_pos.c ****     /*Do nothing if the position is not changed*/
 918:Drivers/lvgl/src/core/lv_obj_pos.c ****     /*It is very important else recursive positioning can
 919:Drivers/lvgl/src/core/lv_obj_pos.c ****      *occur without position change*/
 920:Drivers/lvgl/src/core/lv_obj_pos.c ****     if(diff.x == 0 && diff.y == 0) return;
