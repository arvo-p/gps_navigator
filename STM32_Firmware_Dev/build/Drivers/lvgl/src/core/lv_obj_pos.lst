1047:Drivers/lvgl/src/core/lv_obj_pos.c **** 
1048:Drivers/lvgl/src/core/lv_obj_pos.c ****     /*invalidate_area_core() expects untransformed coordinates and applies the
1049:Drivers/lvgl/src/core/lv_obj_pos.c ****      *transform itself*/
1050:Drivers/lvgl/src/core/lv_obj_pos.c ****     lv_area_t obj_coords;
1051:Drivers/lvgl/src/core/lv_obj_pos.c ****     int32_t ext_size = lv_obj_get_ext_draw_size(obj);
1052:Drivers/lvgl/src/core/lv_obj_pos.c ****     obj_coords = obj->coords;
