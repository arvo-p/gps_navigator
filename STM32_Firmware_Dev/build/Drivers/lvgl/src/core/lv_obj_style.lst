1167:Drivers/lvgl/src/core/lv_obj_style.c ****     for(i = 0; i < child_cnt; i++) {
1168:Drivers/lvgl/src/core/lv_obj_style.c ****         lv_obj_t * child = obj->spec_attr->children[i];
1169:Drivers/lvgl/src/core/lv_obj_style.c ****         lv_obj_invalidate(child);
1170:Drivers/lvgl/src/core/lv_obj_style.c ****         lv_obj_send_event(child, LV_EVENT_STYLE_CHANGED, NULL);
1171:Drivers/lvgl/src/core/lv_obj_style.c ****         lv_obj_invalidate(child);
1172:Drivers/lvgl/src/core/lv_obj_style.c **** 
1173:Drivers/lvgl/src/core/lv_obj_style.c ****         refresh_children_style(child); /*Check children too*/
1174:Drivers/lvgl/src/core/lv_obj_style.c ****     }
1175:Drivers/lvgl/src/core/lv_obj_style.c **** }
