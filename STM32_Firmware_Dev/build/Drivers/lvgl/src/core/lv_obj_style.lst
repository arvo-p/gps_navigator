 151:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h **** 
 152:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****     /*The properties are listed in a special order to make caching more effective.
 153:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *Groups are used when LV_OBJ_STYLE_CACHE is enabled.
 154:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *If a property from a groups is set, a bit will be set in
 155:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *obj->style_main_prop_is_set and style_other_prop_is_set
 156:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *to indicate that the property is set.
 157:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *
 158:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *Strategy 1: group related properties. E.g. if no "border" properties are set
 159:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *            they will be skipped quickly.
 160:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *
 161:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *Strategy 2: group common property with rarely used properties. This way
 162:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *            the common property is cached properly and it's rarely affected
 163:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *            by other props. The other props are cached in an sub-optimal way,
 164:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *            but they are used rarely.
 165:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *
 166:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *Strategy 3: group properties they are used rarely together so that caching doesn't
 167:Drivers/lvgl/src/core/../../include/lvgl/core/lv_style.h ****      *            interfere
