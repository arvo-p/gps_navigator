 107:Drivers/lvgl/src/core/lv_obj_tree.c ****         obj->spec_attr->scroll.x = 0;
 108:Drivers/lvgl/src/core/lv_obj_tree.c ****         obj->spec_attr->scroll.y = 0;
 109:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 110:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 111:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(lv_obj_get_child_count(obj) < cnt) {
 112:Drivers/lvgl/src/core/lv_obj_tree.c ****         lv_obj_send_event(obj, LV_EVENT_CHILD_CHANGED, NULL);
 113:Drivers/lvgl/src/core/lv_obj_tree.c ****         lv_obj_send_event(obj, LV_EVENT_CHILD_DELETED, NULL);
