 515:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 516:Drivers/lvgl/src/core/lv_obj_tree.c ****     else {
 517:Drivers/lvgl/src/core/lv_obj_tree.c ****         /*Just use the set name*/
 518:Drivers/lvgl/src/core/lv_obj_tree.c ****         lv_strlcpy(buf, name, buf_size);
