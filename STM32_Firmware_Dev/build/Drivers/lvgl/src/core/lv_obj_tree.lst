 522:Drivers/lvgl/src/core/lv_obj_tree.c **** lv_obj_t * lv_obj_get_child_by_name(const lv_obj_t * parent, const char * path)
 523:Drivers/lvgl/src/core/lv_obj_tree.c **** {
 524:Drivers/lvgl/src/core/lv_obj_tree.c ****     LV_CHECK_OBJ(parent, MY_CLASS, return NULL);
 525:Drivers/lvgl/src/core/lv_obj_tree.c ****     LV_CHECK_ARG(path != NULL, return NULL);
 526:Drivers/lvgl/src/core/lv_obj_tree.c ****     LV_CHECK_ARG(parent->spec_attr != NULL, return NULL);
 527:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 528:Drivers/lvgl/src/core/lv_obj_tree.c ****     while(*path) {
 529:Drivers/lvgl/src/core/lv_obj_tree.c ****         const char * segment = path;
 530:Drivers/lvgl/src/core/lv_obj_tree.c ****         uint32_t len = 0;
 531:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 532:Drivers/lvgl/src/core/lv_obj_tree.c ****         /* Calculate the length of the current segment */
 533:Drivers/lvgl/src/core/lv_obj_tree.c ****         while(path[len] && path[len] != '/')
 534:Drivers/lvgl/src/core/lv_obj_tree.c ****             len++;
 535:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 536:Drivers/lvgl/src/core/lv_obj_tree.c ****         /* Look for a child whose resolved name exactly matches the segment */
 537:Drivers/lvgl/src/core/lv_obj_tree.c ****         lv_obj_t * child = find_by_name_direct(parent, segment, len);
 538:Drivers/lvgl/src/core/lv_obj_tree.c ****         if(!child) return NULL; /*Segment not found*/
 539:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 540:Drivers/lvgl/src/core/lv_obj_tree.c ****         /* Advance to the next segment */
 541:Drivers/lvgl/src/core/lv_obj_tree.c ****         path += len;
 542:Drivers/lvgl/src/core/lv_obj_tree.c ****         if(*path == '/') path++; /* Skip the '/' */
 543:Drivers/lvgl/src/core/lv_obj_tree.c **** 
ARM GAS  /tmp/ccp9DF59.s 			page 11


 544:Drivers/lvgl/src/core/lv_obj_tree.c ****         /* If there is no further segment, we've found the target child */
 545:Drivers/lvgl/src/core/lv_obj_tree.c ****         if(*path == '\0') return child;
 546:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 547:Drivers/lvgl/src/core/lv_obj_tree.c ****         parent = child;
 548:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 549:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 550:Drivers/lvgl/src/core/lv_obj_tree.c ****     return NULL;
 551:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 552:Drivers/lvgl/src/core/lv_obj_tree.c **** }
