 554:Drivers/lvgl/src/core/lv_obj_tree.c **** lv_obj_t * lv_obj_find_by_name(const lv_obj_t * parent, const char * name)
 555:Drivers/lvgl/src/core/lv_obj_tree.c **** {
 556:Drivers/lvgl/src/core/lv_obj_tree.c ****     LV_CHECK_ARG(name != NULL, return NULL);
 557:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 558:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(parent == NULL) parent = lv_display_get_screen_active(lv_display_get_default());
