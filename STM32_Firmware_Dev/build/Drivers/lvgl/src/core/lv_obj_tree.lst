 202:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 203:Drivers/lvgl/src/core/lv_obj_tree.c ****     const uint32_t parent_child_count = lv_obj_get_child_count(parent);
 204:Drivers/lvgl/src/core/lv_obj_tree.c ****     /* old_index only can be 0 or greater, this point cannot be reached if the parent is not null *
 205:Drivers/lvgl/src/core/lv_obj_tree.c ****     const int32_t old_index = lv_obj_get_index(obj);
 206:Drivers/lvgl/src/core/lv_obj_tree.c ****     LV_ASSERT(0 <= old_index);
 207:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 208:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(index < 0) {
 209:Drivers/lvgl/src/core/lv_obj_tree.c ****         index += parent_child_count;
 210:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 211:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 212:Drivers/lvgl/src/core/lv_obj_tree.c ****     /* Index was negative and the absolute value is greater than parent child count */
 213:Drivers/lvgl/src/core/lv_obj_tree.c ****     if((index < 0)
 214:Drivers/lvgl/src/core/lv_obj_tree.c ****        /* Index is same or bigger than parent child count */
 215:Drivers/lvgl/src/core/lv_obj_tree.c ****        || (index >= (int32_t) parent_child_count)
 216:Drivers/lvgl/src/core/lv_obj_tree.c ****        /* If both previous and new index are the same */
 217:Drivers/lvgl/src/core/lv_obj_tree.c ****        || (index == old_index)) {
 218:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 219:Drivers/lvgl/src/core/lv_obj_tree.c ****         return;
 220:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 221:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 222:Drivers/lvgl/src/core/lv_obj_tree.c ****     int32_t i = old_index;
 223:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(index < old_index) {
 224:Drivers/lvgl/src/core/lv_obj_tree.c ****         while(i > index)  {
 225:Drivers/lvgl/src/core/lv_obj_tree.c ****             parent->spec_attr->children[i] = parent->spec_attr->children[i - 1];
 226:Drivers/lvgl/src/core/lv_obj_tree.c ****             i--;
 227:Drivers/lvgl/src/core/lv_obj_tree.c ****         }
 228:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 229:Drivers/lvgl/src/core/lv_obj_tree.c ****     else {
 230:Drivers/lvgl/src/core/lv_obj_tree.c ****         while(i < index) {
 231:Drivers/lvgl/src/core/lv_obj_tree.c ****             parent->spec_attr->children[i] = parent->spec_attr->children[i + 1];
 232:Drivers/lvgl/src/core/lv_obj_tree.c ****             i++;
 233:Drivers/lvgl/src/core/lv_obj_tree.c ****         }
 234:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 235:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 236:Drivers/lvgl/src/core/lv_obj_tree.c ****     parent->spec_attr->children[index] = obj;
 237:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_send_event(parent, LV_EVENT_CHILD_CHANGED, NULL);
 238:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_invalidate(parent);
 239:Drivers/lvgl/src/core/lv_obj_tree.c **** }
