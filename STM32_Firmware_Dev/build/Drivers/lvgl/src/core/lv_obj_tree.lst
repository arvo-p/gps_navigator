 153:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 154:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(obj->parent == NULL) {
 155:Drivers/lvgl/src/core/lv_obj_tree.c ****         LV_LOG_WARN("Can't set the parent of a screen");
 156:Drivers/lvgl/src/core/lv_obj_tree.c ****         return;
 157:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 158:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 159:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(parent == obj->parent) {
 160:Drivers/lvgl/src/core/lv_obj_tree.c ****         return;
 161:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 162:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 163:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(!lv_obj_allocate_spec_attr(parent)) {
 164:Drivers/lvgl/src/core/lv_obj_tree.c ****         return;
 165:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 166:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 167:Drivers/lvgl/src/core/lv_obj_tree.c ****     /*Add the object to the new parents list first*/
 168:Drivers/lvgl/src/core/lv_obj_tree.c ****     if(lv_obj_add_child(parent, obj) != LV_RESULT_OK) {
 169:Drivers/lvgl/src/core/lv_obj_tree.c ****         LV_LOG_WARN("Failed to attach child to parent");
 170:Drivers/lvgl/src/core/lv_obj_tree.c ****         return;
 171:Drivers/lvgl/src/core/lv_obj_tree.c ****     }
 172:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 173:Drivers/lvgl/src/core/lv_obj_tree.c ****     /*Remove the object from the old parent's child list
 174:Drivers/lvgl/src/core/lv_obj_tree.c ****      * This should never fail, thus we do only do it after adding it to the new parent's list*/
 175:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_remove_child(obj->parent, obj);
 176:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 177:Drivers/lvgl/src/core/lv_obj_tree.c ****     /*Notify the original parent because one of its children is lost*/
 178:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_scrollbar_invalidate(obj->parent);
 179:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_send_event(obj->parent, LV_EVENT_CHILD_CHANGED, obj);
 180:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_send_event(obj->parent, LV_EVENT_CHILD_DELETED, NULL);
 181:Drivers/lvgl/src/core/lv_obj_tree.c ****     obj->parent = parent;
 182:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 183:Drivers/lvgl/src/core/lv_obj_tree.c ****     /*Notify the new parent about the child*/
 184:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_send_event(parent, LV_EVENT_CHILD_CHANGED, obj);
 185:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_send_event(parent, LV_EVENT_CHILD_CREATED, NULL);
 186:Drivers/lvgl/src/core/lv_obj_tree.c **** 
 187:Drivers/lvgl/src/core/lv_obj_tree.c ****     lv_obj_mark_layout_as_dirty(obj);
 188:Drivers/lvgl/src/core/lv_obj_tree.c **** 
