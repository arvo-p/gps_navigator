 378:Drivers/lvgl/src/core/lv_obj_draw.c **** int32_t lv_obj_calculate_ext_draw_size(lv_obj_t * obj, lv_part_t part)
 379:Drivers/lvgl/src/core/lv_obj_draw.c **** {
 380:Drivers/lvgl/src/core/lv_obj_draw.c ****     LV_CHECK_OBJ(obj, MY_CLASS, return 0);
 381:Drivers/lvgl/src/core/lv_obj_draw.c **** 
 382:Drivers/lvgl/src/core/lv_obj_draw.c ****     LV_PROFILER_DRAW_BEGIN;
 383:Drivers/lvgl/src/core/lv_obj_draw.c ****     int32_t s = 0;
 384:Drivers/lvgl/src/core/lv_obj_draw.c **** 
 385:Drivers/lvgl/src/core/lv_obj_draw.c ****     int32_t sh_width = lv_obj_get_style_shadow_width_internal(obj, part);
 386:Drivers/lvgl/src/core/lv_obj_draw.c ****     if(sh_width) {
 387:Drivers/lvgl/src/core/lv_obj_draw.c ****         lv_opa_t sh_opa = lv_obj_get_style_shadow_opa_internal(obj, part);
 388:Drivers/lvgl/src/core/lv_obj_draw.c ****         if(sh_opa > LV_OPA_MIN) {
 389:Drivers/lvgl/src/core/lv_obj_draw.c ****             sh_width = sh_width / 2 + 1;    /*The blur adds only half width*/
 390:Drivers/lvgl/src/core/lv_obj_draw.c ****             sh_width += lv_obj_get_style_shadow_spread_internal(obj, part);
 391:Drivers/lvgl/src/core/lv_obj_draw.c ****             int32_t sh_ofs_x = lv_obj_get_style_shadow_offset_x_internal(obj, part);
 392:Drivers/lvgl/src/core/lv_obj_draw.c ****             int32_t sh_ofs_y = lv_obj_get_style_shadow_offset_y_internal(obj, part);
 393:Drivers/lvgl/src/core/lv_obj_draw.c ****             sh_width += LV_MAX(LV_ABS(sh_ofs_x), LV_ABS(sh_ofs_y));
 394:Drivers/lvgl/src/core/lv_obj_draw.c ****             s = LV_MAX(s, sh_width);
 395:Drivers/lvgl/src/core/lv_obj_draw.c ****         }
 396:Drivers/lvgl/src/core/lv_obj_draw.c ****     }
 397:Drivers/lvgl/src/core/lv_obj_draw.c **** 
 398:Drivers/lvgl/src/core/lv_obj_draw.c ****     int32_t outline_width = lv_obj_get_style_outline_width_internal(obj, part);
 399:Drivers/lvgl/src/core/lv_obj_draw.c ****     if(outline_width) {
 400:Drivers/lvgl/src/core/lv_obj_draw.c ****         lv_opa_t outline_opa = lv_obj_get_style_outline_opa_internal(obj, part);
 401:Drivers/lvgl/src/core/lv_obj_draw.c ****         if(outline_opa > LV_OPA_MIN) {
 402:Drivers/lvgl/src/core/lv_obj_draw.c ****             int32_t outline_pad = lv_obj_get_style_outline_pad_internal(obj, part);
 403:Drivers/lvgl/src/core/lv_obj_draw.c ****             s = LV_MAX(s, outline_pad + outline_width);
 404:Drivers/lvgl/src/core/lv_obj_draw.c ****         }
 405:Drivers/lvgl/src/core/lv_obj_draw.c ****     }
 406:Drivers/lvgl/src/core/lv_obj_draw.c **** 
 407:Drivers/lvgl/src/core/lv_obj_draw.c ****     int32_t drop_shadow_size = 0;
 408:Drivers/lvgl/src/core/lv_obj_draw.c ****     if(lv_obj_get_style_drop_shadow_opa_internal(obj, part) > 0) {
 409:Drivers/lvgl/src/core/lv_obj_draw.c ****         drop_shadow_size += LV_MAX(LV_ABS(lv_obj_get_style_drop_shadow_offset_x_internal(obj, part)
 410:Drivers/lvgl/src/core/lv_obj_draw.c ****                                    LV_ABS(lv_obj_get_style_drop_shadow_offset_y_internal(obj, part)
 411:Drivers/lvgl/src/core/lv_obj_draw.c **** 
 412:Drivers/lvgl/src/core/lv_obj_draw.c ****         drop_shadow_size += lv_obj_get_style_drop_shadow_radius_internal(obj, part) + 1;
 413:Drivers/lvgl/src/core/lv_obj_draw.c ****     }
 414:Drivers/lvgl/src/core/lv_obj_draw.c ****     s += drop_shadow_size;
 415:Drivers/lvgl/src/core/lv_obj_draw.c **** 
 416:Drivers/lvgl/src/core/lv_obj_draw.c ****     int32_t w = lv_obj_get_style_transform_width_internal(obj, part);
 417:Drivers/lvgl/src/core/lv_obj_draw.c ****     int32_t h = lv_obj_get_style_transform_height_internal(obj, part);
 418:Drivers/lvgl/src/core/lv_obj_draw.c ****     int32_t wh = LV_MAX(w, h);
 419:Drivers/lvgl/src/core/lv_obj_draw.c ****     if(wh > 0) s += wh;
 420:Drivers/lvgl/src/core/lv_obj_draw.c **** 
 421:Drivers/lvgl/src/core/lv_obj_draw.c ****     LV_PROFILER_DRAW_END;
 422:Drivers/lvgl/src/core/lv_obj_draw.c ****     return s;
 423:Drivers/lvgl/src/core/lv_obj_draw.c **** }
