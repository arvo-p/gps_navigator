 237:Drivers/lvgl/src/indev/lv_indev_scroll.c **** int32_t lv_indev_scroll_throw_predict(lv_indev_t * indev, lv_dir_t dir)
 238:Drivers/lvgl/src/indev/lv_indev_scroll.c **** {
 239:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     if(indev == NULL) return 0;
 240:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     int32_t v;
 241:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     switch(dir) {
 242:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         case LV_DIR_VER:
 243:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             v = indev->pointer.scroll_throw_vect_ori.y;
 244:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             break;
 245:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         case LV_DIR_HOR:
 246:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             v = indev->pointer.scroll_throw_vect_ori.x;
 247:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             break;
 248:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         default:
 249:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             return 0;
 250:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     }
 251:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 252:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     int32_t scroll_throw = indev->scroll_throw;
 253:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     int32_t sum = 0;
 254:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     while(v) {
 255:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         sum += v;
 256:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         v = v * (100 - scroll_throw) / 100;
 257:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     }
 258:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
ARM GAS  /tmp/cckJFy29.s 			page 6


 259:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     return sum;
 260:Drivers/lvgl/src/indev/lv_indev_scroll.c **** }
