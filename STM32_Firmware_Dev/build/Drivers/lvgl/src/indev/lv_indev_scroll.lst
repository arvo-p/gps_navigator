  77:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         scale_y = (scale_y * zoom_act_y) >> 8;
  78:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         parent = lv_obj_get_parent(parent);
  79:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     }
