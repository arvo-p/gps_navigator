 544:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     break;
 545:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 case LV_SCROLL_SNAP_END:
 546:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     x_child = child->coords.x2;
 547:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     x_parent = obj->coords.x2 - pad_right;
 548:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     break;
 549:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 case LV_SCROLL_SNAP_CENTER:
 550:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     x_child = child->coords.x1 + lv_area_get_width(&child->coords) / 2;
 551:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     x_parent = obj->coords.x1 + pad_left + (lv_area_get_width(&obj->coords) - pad_l
 552:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     break;
 553:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 default:
 554:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     continue;
 555:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             }
 556:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 557:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             x_child += ofs;
 558:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             if(x_child >= min && x_child <= max) {
 559:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 int32_t x = x_child -  x_parent;
 560:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 if(LV_ABS(x) < LV_ABS(dist)) dist = x;
 561:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             }
 562:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 563:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     }
 564:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 565:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     return dist == LV_COORD_MAX ? LV_COORD_MAX : -dist;
 566:Drivers/lvgl/src/indev/lv_indev_scroll.c **** }
