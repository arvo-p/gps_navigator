 535:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_obj_t * child = obj->spec_attr->children[i];
 536:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((lv_obj_is_hidden(child) || lv_obj_is_floating(child))) continue;
