 262:Drivers/lvgl/src/indev/lv_indev_scroll.c **** void lv_indev_scroll_get_snap_dist(lv_obj_t * obj, lv_point_t * p)
 263:Drivers/lvgl/src/indev/lv_indev_scroll.c **** {
 264:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     p->x = find_snap_point_x(obj, obj->coords.x1, obj->coords.x2, 0);
 265:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     p->y = find_snap_point_y(obj, obj->coords.y1, obj->coords.y2, 0);
 266:Drivers/lvgl/src/indev/lv_indev_scroll.c **** }
