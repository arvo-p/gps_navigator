 538:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             int32_t x_child = 0;
 539:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             int32_t x_parent = 0;
 540:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             switch(align) {
 541:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 case LV_SCROLL_SNAP_START:
 542:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     x_child = child->coords.x1;
 543:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     x_parent = obj->coords.x1 + pad_left;
