 373:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 374:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*Vertical scroll*/
 375:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t st = 0;
 376:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t sb = 0;
 377:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_scroll_snap_t snap_y = lv_obj_get_scroll_snap_y(obj_act);
 378:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(snap_y == LV_SCROLL_SNAP_NONE) {
 379:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             st = lv_obj_get_scroll_top(obj_act);
 380:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             sb = lv_obj_get_scroll_bottom(obj_act);
 381:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 382:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         else {
 383:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             bool has_start_snap;
 384:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             bool has_end_snap;
 385:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             has_more_snap_points(obj_act, LV_DIR_VER, &has_start_snap, &has_end_snap);
 386:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 387:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             /*Assume scrolling is there are more snap point
 388:Drivers/lvgl/src/indev/lv_indev_scroll.c ****              *Assumed scroll in if there are NO more nap points*/
 389:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             st = has_start_snap ? 1 : -1;
 390:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             sb = has_end_snap ? 1 : -1;
 391:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 392:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 393:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*If this object is scrollable into the current scroll direction then save it as a candidat
 394:Drivers/lvgl/src/indev/lv_indev_scroll.c ****          *It's important only to be scrollable on the current axis (hor/ver) because if the scroll
 395:Drivers/lvgl/src/indev/lv_indev_scroll.c ****          *is propagated to this object it can show at least elastic scroll effect.
 396:Drivers/lvgl/src/indev/lv_indev_scroll.c ****          *But if not hor/ver scrollable do not scroll it at all (so it's not a good candidate)*/
 397:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((st > 0 || sb > 0)  &&
 398:Drivers/lvgl/src/indev/lv_indev_scroll.c ****            ((up_en    && obj_scroll_sum.y >=   scroll_limit) ||
 399:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             (down_en  && obj_scroll_sum.y <= - scroll_limit))) {
 400:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             obj_candidate = obj_act;
 401:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             dir_candidate = LV_DIR_VER;
 402:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 403:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 404:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((sl > 0 || sr > 0)  &&
 405:Drivers/lvgl/src/indev/lv_indev_scroll.c ****            ((left_en   && obj_scroll_sum.x >=   scroll_limit) ||
 406:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             (right_en  && obj_scroll_sum.x <= - scroll_limit))) {
 407:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             obj_candidate = obj_act;
 408:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             dir_candidate = LV_DIR_HOR;
 409:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 410:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 411:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(st <= 0) up_en = false;
 412:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(sb <= 0) down_en = false;
 413:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(sl <= 0) left_en = false;
 414:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(sr <= 0) right_en = false;
 415:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 416:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*If the object really can be scrolled into the current direction then use it.*/
 417:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((left_en  && obj_scroll_sum.x >=   scroll_limit) ||
 418:Drivers/lvgl/src/indev/lv_indev_scroll.c ****            (right_en && obj_scroll_sum.x <= - scroll_limit) ||
 419:Drivers/lvgl/src/indev/lv_indev_scroll.c ****            (up_en    && obj_scroll_sum.y >=   scroll_limit) ||
 420:Drivers/lvgl/src/indev/lv_indev_scroll.c ****            (down_en  && obj_scroll_sum.y <= - scroll_limit)) {
 421:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             indev->pointer.scroll_dir = hor_en ? LV_DIR_HOR : LV_DIR_VER;
 422:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             break;
 423:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 424:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 425:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*If this object don't want to chain the scroll to the parent stop searching*/
 426:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(lv_obj_is_scroll_chain_hor(obj_act) == false && hor_en) break;
 427:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(lv_obj_is_scroll_chain_ver(obj_act) == false && ver_en) break;
 428:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
