 206:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 else if(sb < 0) {
 207:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     lv_obj_scroll_by(scroll_obj, 0, -sb, LV_ANIM_ON);
 208:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     if(indev->reset_query) return;
 209:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 }
 210:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             }
 211:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 212:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 213:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*If horizontally scrollable and not controlled by snap*/
 214:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(align_x == LV_SCROLL_SNAP_NONE) {
 215:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             int32_t sl = lv_obj_get_scroll_left(scroll_obj);
 216:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             int32_t sr = lv_obj_get_scroll_right(scroll_obj);
 217:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             if(sl > 0 || sr > 0) {
 218:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 if(sl < 0) {
 219:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     lv_obj_scroll_by(scroll_obj, sl, 0, LV_ANIM_ON);
 220:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     if(indev->reset_query) return;
 221:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 }
 222:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 else if(sr < 0) {
 223:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     lv_obj_scroll_by(scroll_obj, -sr, 0, LV_ANIM_ON);
 224:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                     if(indev->reset_query) return;
 225:Drivers/lvgl/src/indev/lv_indev_scroll.c ****                 }
 226:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             }
 227:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 228:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 229:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_obj_send_event(scroll_obj, LV_EVENT_SCROLL_END, indev);
 230:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(indev->reset_query) return;
 231:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 232:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         indev->pointer.scroll_dir = LV_DIR_NONE;
 233:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         indev->pointer.scroll_obj = NULL;
