  72:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     while(parent) {
  73:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         angle += lv_obj_get_style_transform_rotation_internal(parent, LV_PART_MAIN);
  74:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t zoom_act_x = lv_obj_get_style_transform_scale_x_safe_internal(parent, LV_PART_MAIN)
  75:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t zoom_act_y = lv_obj_get_style_transform_scale_y_safe_internal(parent, LV_PART_MAIN)
