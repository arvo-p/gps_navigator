 268:Drivers/lvgl/src/indev/lv_indev_scroll.c **** lv_obj_t * lv_indev_find_scroll_obj(lv_indev_t * indev)
 269:Drivers/lvgl/src/indev/lv_indev_scroll.c **** {
 270:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     lv_obj_t * obj_candidate = NULL;
 271:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     lv_dir_t dir_candidate = LV_DIR_NONE;
 272:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     int32_t scroll_limit = indev->scroll_limit;
 273:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 274:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     /*Go until find a scrollable object in the current direction
 275:Drivers/lvgl/src/indev/lv_indev_scroll.c ****      *More precisely:
 276:Drivers/lvgl/src/indev/lv_indev_scroll.c ****      * 1. Check the pressed object and all of its ancestors and try to find an object which is scro
 277:Drivers/lvgl/src/indev/lv_indev_scroll.c ****      * 2. Scrollable means it has some content out of its area
 278:Drivers/lvgl/src/indev/lv_indev_scroll.c ****      * 3. If an object can be scrolled into the current direction then use it ("real match"")
 279:Drivers/lvgl/src/indev/lv_indev_scroll.c ****      * 4. If can be scrolled on the current axis (hor/ver) save it as candidate (at least show an e
 280:Drivers/lvgl/src/indev/lv_indev_scroll.c ****      * 5. Use the last candidate. Always the "deepest" parent or the object from point 3*/
 281:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     lv_obj_t * obj_act = indev->pointer.act_obj;
 282:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 283:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     /*Decide if it's a horizontal or vertical scroll*/
 284:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     bool hor_en = false;
 285:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     bool ver_en = false;
 286:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     indev->pointer.scroll_sum.x += indev->pointer.vect.x;
 287:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     indev->pointer.scroll_sum.y += indev->pointer.vect.y;
 288:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 289:Drivers/lvgl/src/indev/lv_indev_scroll.c ****     while(obj_act) {
 290:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*Get the transformed scroll_sum with this object*/
 291:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int16_t angle = 0;
 292:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t scale_x = 256;
 293:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t scale_y = 256;
 294:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_point_t pivot = { 0, 0 };
 295:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_obj_t * parent = obj_act;
 296:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         while(parent) {
 297:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             angle += lv_obj_get_style_transform_rotation_internal(parent, LV_PART_MAIN);
 298:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             int32_t zoom_act_x = lv_obj_get_style_transform_scale_x_safe_internal(parent, LV_PART_M
 299:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             int32_t zoom_act_y = lv_obj_get_style_transform_scale_y_safe_internal(parent, LV_PART_M
 300:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             scale_x = (scale_x * zoom_act_x) >> 8;
 301:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             scale_y = (scale_y * zoom_act_y) >> 8;
 302:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             parent = lv_obj_get_parent(parent);
 303:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 304:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 305:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(scale_x == 0) {
 306:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             scale_x = 1;
 307:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 308:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 309:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(scale_y == 0) {
 310:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             scale_y = 1;
 311:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 312:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 313:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_point_t obj_scroll_sum = indev->pointer.scroll_sum;
 314:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(angle != 0 || scale_x != LV_SCALE_NONE || scale_y != LV_SCALE_NONE) {
 315:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             angle = -angle;
ARM GAS  /tmp/cckJFy29.s 			page 7


 316:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             scale_x = (256 * 256) / scale_x;
 317:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             scale_y = (256 * 256) / scale_y;
 318:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             lv_point_transform(&obj_scroll_sum, angle, scale_x, scale_y, &pivot, false);
 319:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 320:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 321:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*Determine scroll direction in current object's coordinate system.
 322:Drivers/lvgl/src/indev/lv_indev_scroll.c ****          *Reset both flags each iteration so that a child's transform rotation
 323:Drivers/lvgl/src/indev/lv_indev_scroll.c ****          *does not pollute the direction judgment of its ancestors.*/
 324:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(LV_ABS(obj_scroll_sum.x) > LV_ABS(obj_scroll_sum.y)) {
 325:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             hor_en = true;
 326:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             ver_en = false;
 327:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 328:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         else {
 329:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             ver_en = true;
 330:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             hor_en = false;
 331:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 332:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 333:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(lv_obj_is_scrollable(obj_act) == false) {
 334:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             /*If this object don't want to chain the scroll to the parent stop searching*/
 335:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             if(lv_obj_is_scroll_chain_hor(obj_act) == false && hor_en) break;
 336:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             if(lv_obj_is_scroll_chain_ver(obj_act) == false && ver_en) break;
 337:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 338:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             obj_act = lv_obj_get_parent(obj_act);
 339:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             continue;
 340:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 341:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 342:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*Consider both up-down or left/right scrollable according to the current direction*/
 343:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         bool up_en = ver_en;
 344:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         bool down_en = ver_en;
 345:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         bool left_en = hor_en;
 346:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         bool right_en = hor_en;
 347:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 348:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*The object might have disabled some directions.*/
 349:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_dir_t scroll_dir = lv_obj_get_scroll_dir(obj_act);
 350:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_LEFT) == 0) left_en = false;
 351:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_RIGHT) == 0) right_en = false;
 352:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_TOP) == 0) up_en = false;
 353:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if((scroll_dir & LV_DIR_BOTTOM) == 0) down_en = false;
 354:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 355:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         /*Horizontal scroll*/
 356:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t sl = 0;
 357:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         int32_t sr = 0;
 358:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         lv_scroll_snap_t snap_x = lv_obj_get_scroll_snap_x(obj_act);
 359:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         if(snap_x == LV_SCROLL_SNAP_NONE) {
 360:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             sl = lv_obj_get_scroll_left(obj_act);
 361:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             sr = lv_obj_get_scroll_right(obj_act);
 362:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
 363:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         else {
 364:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             bool has_start_snap;
 365:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             bool has_end_snap;
 366:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             has_more_snap_points(obj_act, LV_DIR_HOR, &has_start_snap, &has_end_snap);
 367:Drivers/lvgl/src/indev/lv_indev_scroll.c **** 
 368:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             /*Assume scrolling is there are more snap point
 369:Drivers/lvgl/src/indev/lv_indev_scroll.c ****              *Assumed scroll in if there are NO more nap points*/
 370:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             sl = has_start_snap ? 1 : -1;
 371:Drivers/lvgl/src/indev/lv_indev_scroll.c ****             sr = has_end_snap ? 1 : -1;
 372:Drivers/lvgl/src/indev/lv_indev_scroll.c ****         }
