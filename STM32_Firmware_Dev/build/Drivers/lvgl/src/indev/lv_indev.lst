 613:Drivers/lvgl/src/indev/lv_indev.c **** lv_obj_t * lv_indev_search_obj(lv_obj_t * obj, lv_point_t * point)
 614:Drivers/lvgl/src/indev/lv_indev.c **** {
 615:Drivers/lvgl/src/indev/lv_indev.c ****     LV_CHECK_ARG(obj != NULL, return NULL);
 616:Drivers/lvgl/src/indev/lv_indev.c ****     LV_CHECK_ARG(point != NULL, return NULL);
 617:Drivers/lvgl/src/indev/lv_indev.c **** 
 618:Drivers/lvgl/src/indev/lv_indev.c ****     lv_obj_t * found_p = NULL;
 619:Drivers/lvgl/src/indev/lv_indev.c **** 
 620:Drivers/lvgl/src/indev/lv_indev.c ****     /*If this obj is hidden the children are hidden too so return immediately*/
 621:Drivers/lvgl/src/indev/lv_indev.c ****     if(lv_obj_is_hidden(obj)) return NULL;
 622:Drivers/lvgl/src/indev/lv_indev.c **** 
 623:Drivers/lvgl/src/indev/lv_indev.c ****     lv_point_t p_trans = *point;
 624:Drivers/lvgl/src/indev/lv_indev.c ****     lv_obj_transform_point(obj, &p_trans, LV_OBJ_POINT_TRANSFORM_FLAG_INVERSE);
 625:Drivers/lvgl/src/indev/lv_indev.c **** 
 626:Drivers/lvgl/src/indev/lv_indev.c ****     bool hit_test_ok = lv_obj_hit_test(obj, &p_trans);
 627:Drivers/lvgl/src/indev/lv_indev.c **** 
 628:Drivers/lvgl/src/indev/lv_indev.c ****     /*If the point is on this object check its children too*/
 629:Drivers/lvgl/src/indev/lv_indev.c ****     lv_area_t obj_coords = obj->coords;
 630:Drivers/lvgl/src/indev/lv_indev.c ****     if(lv_obj_is_overflow_visible(obj)) {
 631:Drivers/lvgl/src/indev/lv_indev.c ****         int32_t ext_draw_size = lv_obj_get_ext_draw_size(obj);
 632:Drivers/lvgl/src/indev/lv_indev.c ****         lv_area_increase(&obj_coords, ext_draw_size, ext_draw_size);
 633:Drivers/lvgl/src/indev/lv_indev.c ****     }
 634:Drivers/lvgl/src/indev/lv_indev.c ****     if(lv_area_is_point_on(&obj_coords, &p_trans, 0)) {
 635:Drivers/lvgl/src/indev/lv_indev.c ****         int32_t i;
 636:Drivers/lvgl/src/indev/lv_indev.c ****         uint32_t child_cnt = lv_obj_get_child_count(obj);
 637:Drivers/lvgl/src/indev/lv_indev.c **** 
 638:Drivers/lvgl/src/indev/lv_indev.c ****         /*If a child matches use it*/
 639:Drivers/lvgl/src/indev/lv_indev.c ****         for(i = child_cnt - 1; i >= 0; i--) {
 640:Drivers/lvgl/src/indev/lv_indev.c ****             lv_obj_t * child = obj->spec_attr->children[i];
 641:Drivers/lvgl/src/indev/lv_indev.c ****             found_p = lv_indev_search_obj(child, &p_trans);
 642:Drivers/lvgl/src/indev/lv_indev.c ****             if(found_p) return found_p;
 643:Drivers/lvgl/src/indev/lv_indev.c ****         }
 644:Drivers/lvgl/src/indev/lv_indev.c ****     }
 645:Drivers/lvgl/src/indev/lv_indev.c **** 
 646:Drivers/lvgl/src/indev/lv_indev.c ****     /*If not return earlier for a clicked child and this obj's hittest was ok use it
 647:Drivers/lvgl/src/indev/lv_indev.c ****      *else return NULL*/
