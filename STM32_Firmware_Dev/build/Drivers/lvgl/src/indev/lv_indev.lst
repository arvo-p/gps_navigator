 165:Drivers/lvgl/src/indev/lv_indev.c **** static void indev_read_core(lv_indev_t * indev, lv_indev_data_t * data)
 166:Drivers/lvgl/src/indev/lv_indev.c **** {
 167:Drivers/lvgl/src/indev/lv_indev.c ****     LV_ASSERT(indev != NULL);
 168:Drivers/lvgl/src/indev/lv_indev.c ****     LV_ASSERT(data != NULL);
 169:Drivers/lvgl/src/indev/lv_indev.c ****     LV_PROFILER_INDEV_BEGIN;
 170:Drivers/lvgl/src/indev/lv_indev.c ****     lv_memzero(data, sizeof(lv_indev_data_t));
 171:Drivers/lvgl/src/indev/lv_indev.c **** 
 172:Drivers/lvgl/src/indev/lv_indev.c ****     /* For touchpad sometimes users don't set the last pressed coordinate on release.
 173:Drivers/lvgl/src/indev/lv_indev.c ****      * So be sure a coordinates are initialized to the last point */
 174:Drivers/lvgl/src/indev/lv_indev.c ****     if(indev->type == LV_INDEV_TYPE_POINTER) {
 175:Drivers/lvgl/src/indev/lv_indev.c ****         data->point.x = indev->pointer.last_raw_point.x;
 176:Drivers/lvgl/src/indev/lv_indev.c ****         data->point.y = indev->pointer.last_raw_point.y;
 177:Drivers/lvgl/src/indev/lv_indev.c ****     }
 178:Drivers/lvgl/src/indev/lv_indev.c ****     /*Similarly set at least the last key in case of the user doesn't set it on release*/
 179:Drivers/lvgl/src/indev/lv_indev.c ****     else if(indev->type == LV_INDEV_TYPE_KEYPAD || indev->type == LV_INDEV_TYPE_ENCODER) {
 180:Drivers/lvgl/src/indev/lv_indev.c ****         data->key = indev->keypad.last_key;
 181:Drivers/lvgl/src/indev/lv_indev.c ****     }
 182:Drivers/lvgl/src/indev/lv_indev.c **** 
 183:Drivers/lvgl/src/indev/lv_indev.c ****     if(indev->read_cb) {
 184:Drivers/lvgl/src/indev/lv_indev.c ****         LV_TRACE_INDEV("calling indev_read_cb");
 185:Drivers/lvgl/src/indev/lv_indev.c ****         indev->read_cb(indev, data);
 186:Drivers/lvgl/src/indev/lv_indev.c **** 
 187:Drivers/lvgl/src/indev/lv_indev.c ****         /*Set the time stamp to the current time is it was not set in the read_cb*/
 188:Drivers/lvgl/src/indev/lv_indev.c ****         if(data->timestamp == 0) data->timestamp = lv_tick_get();
 189:Drivers/lvgl/src/indev/lv_indev.c ****     }
 190:Drivers/lvgl/src/indev/lv_indev.c ****     else {
 191:Drivers/lvgl/src/indev/lv_indev.c ****         LV_LOG_WARN("indev_read_cb is not registered");
 192:Drivers/lvgl/src/indev/lv_indev.c ****     }
 193:Drivers/lvgl/src/indev/lv_indev.c **** 
 194:Drivers/lvgl/src/indev/lv_indev.c ****     LV_PROFILER_INDEV_END;
 195:Drivers/lvgl/src/indev/lv_indev.c **** }
