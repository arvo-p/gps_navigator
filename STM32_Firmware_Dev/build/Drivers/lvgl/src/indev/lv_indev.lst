 202:Drivers/lvgl/src/indev/lv_indev.c **** 
 203:Drivers/lvgl/src/indev/lv_indev.c **** void lv_indev_read(lv_indev_t * indev)
 204:Drivers/lvgl/src/indev/lv_indev.c **** {
 205:Drivers/lvgl/src/indev/lv_indev.c ****     LV_CHECK_ARG(indev != NULL, return);
 206:Drivers/lvgl/src/indev/lv_indev.c **** 
 207:Drivers/lvgl/src/indev/lv_indev.c ****     LV_TRACE_INDEV("begin");
 208:Drivers/lvgl/src/indev/lv_indev.c **** 
 209:Drivers/lvgl/src/indev/lv_indev.c ****     indev_act = indev;
 210:Drivers/lvgl/src/indev/lv_indev.c **** 
 211:Drivers/lvgl/src/indev/lv_indev.c ****     /*Read and process all indevs*/
 212:Drivers/lvgl/src/indev/lv_indev.c ****     if(indev->disp == NULL) return; /*Not assigned to any displays*/
 213:Drivers/lvgl/src/indev/lv_indev.c **** 
 214:Drivers/lvgl/src/indev/lv_indev.c ****     /*Handle reset query before processing the point*/
 215:Drivers/lvgl/src/indev/lv_indev.c ****     indev_proc_reset_query_handler(indev);
 216:Drivers/lvgl/src/indev/lv_indev.c **** 
 217:Drivers/lvgl/src/indev/lv_indev.c ****     if(indev->enabled == 0) return;
 218:Drivers/lvgl/src/indev/lv_indev.c ****     if(indev->disp->prev_scr != NULL) {
 219:Drivers/lvgl/src/indev/lv_indev.c ****         LV_TRACE_INDEV("input blocked while screen animation active");
 220:Drivers/lvgl/src/indev/lv_indev.c ****         return;
 221:Drivers/lvgl/src/indev/lv_indev.c ****     }
 222:Drivers/lvgl/src/indev/lv_indev.c **** 
 223:Drivers/lvgl/src/indev/lv_indev.c ****     LV_PROFILER_INDEV_BEGIN;
 224:Drivers/lvgl/src/indev/lv_indev.c **** 
 225:Drivers/lvgl/src/indev/lv_indev.c ****     bool continue_reading;
 226:Drivers/lvgl/src/indev/lv_indev.c ****     lv_indev_data_t data;
 227:Drivers/lvgl/src/indev/lv_indev.c **** 
 228:Drivers/lvgl/src/indev/lv_indev.c ****     do {
 229:Drivers/lvgl/src/indev/lv_indev.c ****         /*Read the data*/
 230:Drivers/lvgl/src/indev/lv_indev.c ****         indev_read_core(indev, &data);
 231:Drivers/lvgl/src/indev/lv_indev.c ****         continue_reading = indev->mode != LV_INDEV_MODE_EVENT && data.continue_reading;
