 729:Drivers/lvgl/src/display/lv_display.c **** void lv_screen_load_anim(lv_obj_t * scr, lv_screen_load_anim_t anim_type, uint32_t time, uint32_t d
 730:Drivers/lvgl/src/display/lv_display.c ****                          bool auto_del)
 731:Drivers/lvgl/src/display/lv_display.c **** {
 732:Drivers/lvgl/src/display/lv_display.c ****     LV_CHECK_ARG(scr != NULL, return);
 733:Drivers/lvgl/src/display/lv_display.c ****     lv_display_t * d = lv_obj_get_display(scr);
 734:Drivers/lvgl/src/display/lv_display.c ****     lv_obj_t * act_scr = d->act_scr;
 735:Drivers/lvgl/src/display/lv_display.c **** 
 736:Drivers/lvgl/src/display/lv_display.c ****     if(act_scr == scr || d->scr_to_load == scr) {
 737:Drivers/lvgl/src/display/lv_display.c ****         return;
 738:Drivers/lvgl/src/display/lv_display.c ****     }
 739:Drivers/lvgl/src/display/lv_display.c **** 
 740:Drivers/lvgl/src/display/lv_display.c ****     /*If another screen load animation is in progress
 741:Drivers/lvgl/src/display/lv_display.c ****      *make target screen loaded immediately. */
 742:Drivers/lvgl/src/display/lv_display.c ****     if(d->scr_to_load && act_scr != d->scr_to_load) {
 743:Drivers/lvgl/src/display/lv_display.c ****         lv_anim_delete(d->scr_to_load, NULL);
 744:Drivers/lvgl/src/display/lv_display.c ****         lv_obj_set_pos(d->scr_to_load, 0, 0);
 745:Drivers/lvgl/src/display/lv_display.c ****         lv_obj_remove_local_style_prop(d->scr_to_load, LV_STYLE_OPA, 0);
 746:Drivers/lvgl/src/display/lv_display.c **** 
 747:Drivers/lvgl/src/display/lv_display.c ****         d->prev_scr = d->act_scr;
 748:Drivers/lvgl/src/display/lv_display.c ****         act_scr = d->scr_to_load; /*Active screen changed.*/
 749:Drivers/lvgl/src/display/lv_display.c ****         lv_load_screen_result_t res = load_new_screen(d->scr_to_load);
 750:Drivers/lvgl/src/display/lv_display.c ****         if(res == LV_LOAD_SCREEN_RESULT_DISPLAY_DELETED) {
 751:Drivers/lvgl/src/display/lv_display.c ****             return;
 752:Drivers/lvgl/src/display/lv_display.c ****         }
 753:Drivers/lvgl/src/display/lv_display.c ****         if(old_screen_deleted(res)) {
 754:Drivers/lvgl/src/display/lv_display.c ****             d->prev_scr = NULL;
 755:Drivers/lvgl/src/display/lv_display.c ****         }
 756:Drivers/lvgl/src/display/lv_display.c ****         if(new_screen_deleted(res)) {
 757:Drivers/lvgl/src/display/lv_display.c ****             return;
 758:Drivers/lvgl/src/display/lv_display.c ****         }
 759:Drivers/lvgl/src/display/lv_display.c ****     }
 760:Drivers/lvgl/src/display/lv_display.c **** 
 761:Drivers/lvgl/src/display/lv_display.c ****     d->scr_to_load = scr;
 762:Drivers/lvgl/src/display/lv_display.c **** 
 763:Drivers/lvgl/src/display/lv_display.c ****     if(d->prev_scr && d->del_prev) {
 764:Drivers/lvgl/src/display/lv_display.c ****         lv_obj_delete(d->prev_scr);
 765:Drivers/lvgl/src/display/lv_display.c ****     }
 766:Drivers/lvgl/src/display/lv_display.c ****     d->prev_scr = NULL;
 767:Drivers/lvgl/src/display/lv_display.c **** 
 768:Drivers/lvgl/src/display/lv_display.c ****     d->draw_prev_over_act = is_out_anim(anim_type);
 769:Drivers/lvgl/src/display/lv_display.c ****     d->del_prev = auto_del;
 770:Drivers/lvgl/src/display/lv_display.c **** 
 771:Drivers/lvgl/src/display/lv_display.c ****     /*Be sure there is no other animation on the screens*/
ARM GAS  /tmp/ccM3WVFO.s 			page 15


 772:Drivers/lvgl/src/display/lv_display.c ****     lv_anim_delete(scr, NULL);
 773:Drivers/lvgl/src/display/lv_display.c ****     if(act_scr) lv_anim_delete(act_scr, NULL);
 774:Drivers/lvgl/src/display/lv_display.c **** 
 775:Drivers/lvgl/src/display/lv_display.c ****     /*Be sure both screens are in a normal position*/
 776:Drivers/lvgl/src/display/lv_display.c ****     lv_obj_set_pos(scr, 0, 0);
 777:Drivers/lvgl/src/display/lv_display.c ****     if(act_scr) lv_obj_set_pos(act_scr, 0, 0);
 778:Drivers/lvgl/src/display/lv_display.c ****     lv_obj_remove_local_style_prop(scr, LV_STYLE_OPA, 0);
 779:Drivers/lvgl/src/display/lv_display.c ****     if(act_scr) lv_obj_remove_local_style_prop(act_scr, LV_STYLE_OPA, 0);
 780:Drivers/lvgl/src/display/lv_display.c **** 
 781:Drivers/lvgl/src/display/lv_display.c ****     /*Shortcut for immediate load*/
 782:Drivers/lvgl/src/display/lv_display.c ****     if(time == 0 && delay == 0) {
