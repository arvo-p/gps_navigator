 216:Drivers/lvgl/src/layouts/grid/lv_grid.c ****     /*Calculate the grids absolute x and y coordinates.
 217:Drivers/lvgl/src/layouts/grid/lv_grid.c ****      *It will be used as helper during item repositioning to avoid calculating this value for every
 218:Drivers/lvgl/src/layouts/grid/lv_grid.c ****     int32_t pad_left = lv_obj_get_style_space_left_internal(cont, LV_PART_MAIN);
 219:Drivers/lvgl/src/layouts/grid/lv_grid.c ****     int32_t pad_top = lv_obj_get_style_space_top_internal(cont, LV_PART_MAIN);
