 160:Drivers/lvgl/src/fs/lv_fs.c **** lv_result_t lv_fs_get_buffer_from_path(lv_fs_path_ex_t * path, void ** buffer, uint32_t * size)
 161:Drivers/lvgl/src/fs/lv_fs.c **** {
 162:Drivers/lvgl/src/fs/lv_fs.c ****     LV_CHECK_ARG(path != NULL, return LV_RESULT_INVALID);
 163:Drivers/lvgl/src/fs/lv_fs.c ****     LV_CHECK_ARG(buffer != NULL, return LV_RESULT_INVALID);
 164:Drivers/lvgl/src/fs/lv_fs.c ****     LV_CHECK_ARG(size != NULL, return LV_RESULT_INVALID);
 165:Drivers/lvgl/src/fs/lv_fs.c **** 
 166:Drivers/lvgl/src/fs/lv_fs.c ****     *size = 0;
 167:Drivers/lvgl/src/fs/lv_fs.c ****     *buffer = NULL;
 168:Drivers/lvgl/src/fs/lv_fs.c **** 
 169:Drivers/lvgl/src/fs/lv_fs.c ****     if(path->path[0] < 'A' || path->path[0] > 'Z') return LV_RESULT_INVALID;
 170:Drivers/lvgl/src/fs/lv_fs.c ****     if(path->path[1] != ':') return LV_RESULT_INVALID;
 171:Drivers/lvgl/src/fs/lv_fs.c **** 
 172:Drivers/lvgl/src/fs/lv_fs.c ****     uint32_t i;
 173:Drivers/lvgl/src/fs/lv_fs.c ****     lv_uintptr_t adr = 0;
 174:Drivers/lvgl/src/fs/lv_fs.c ****     for(i = 2; path->path[i] != '-' && path->path[i] != '\0' && i < sizeof(path->path); i++) {
 175:Drivers/lvgl/src/fs/lv_fs.c ****         adr = adr * 10;
 176:Drivers/lvgl/src/fs/lv_fs.c ****         adr += path->path[i] - '0';
 177:Drivers/lvgl/src/fs/lv_fs.c ****     }
 178:Drivers/lvgl/src/fs/lv_fs.c **** 
 179:Drivers/lvgl/src/fs/lv_fs.c ****     if(path->path[i] == '\0' || i == sizeof(path->path)) return LV_RESULT_INVALID;
 180:Drivers/lvgl/src/fs/lv_fs.c ****     i++; /*Skip '-'*/
 181:Drivers/lvgl/src/fs/lv_fs.c **** 
 182:Drivers/lvgl/src/fs/lv_fs.c ****     for(; path->path[i] != '.' && path->path[i] != '\0' && i < sizeof(path->path); i++) {
 183:Drivers/lvgl/src/fs/lv_fs.c ****         *size = (*size) * 10;
 184:Drivers/lvgl/src/fs/lv_fs.c ****         *size += path->path[i] - '0';
 185:Drivers/lvgl/src/fs/lv_fs.c ****     }
 186:Drivers/lvgl/src/fs/lv_fs.c **** 
 187:Drivers/lvgl/src/fs/lv_fs.c ****     *buffer = (void *)adr;
 188:Drivers/lvgl/src/fs/lv_fs.c **** 
 189:Drivers/lvgl/src/fs/lv_fs.c ****     return LV_RESULT_OK;
 190:Drivers/lvgl/src/fs/lv_fs.c **** }
