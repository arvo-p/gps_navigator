  20:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** /* File Info : -----------------------------------------------------------------
  21:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****                                    User NOTES
  22:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** 1. How To use this driver:
  23:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** --------------------------
  24:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****    - This driver is used to drive directly an LCD TFT using LTDC controller.
  25:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****    - This driver select dynamically the mounted LCD, ILI9341 240x320 LCD mounted
  26:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****      on MB1075B discovery board, and use the adequate timing and setting for
  27:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****    the specified LCD using device ID of the ILI9341 mounted on MB1075B discovery board
  28:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** 
  29:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** 2. Driver description:
  30:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** ---------------------
ARM GAS  /tmp/ccBAdgKu.s 			page 2


  31:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****   + Initialization steps :
  32:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****      o Initialize the LCD using the LCD_Init() function.
  33:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****      o Apply the Layer configuration using LCD_LayerDefaultInit() function
  34:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****      o Select the LCD layer to be used using LCD_SelectLayer() function.
  35:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****      o Enable the LCD display using LCD_DisplayOn() function.
  36:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** 
  37:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****   + Options
  38:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****      o Configure and enable the color keying functionality using LCD_SetColorKeying()
  39:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****        function.
  40:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****      o Modify in the fly the transparency and/or the frame buffer address
  41:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****        using the following functions :
  42:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****        - LCD_SetTransparency()
  43:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****        - LCD_SetLayerAddress()
  44:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** 
  45:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****   + Display on LCD
  46:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****       o Clear the hole LCD using LCD_Clear() function or only one specified string
  47:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****         line using LCD_ClearStringLine() function.
  48:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****       o Display a character on the specified line and column using LCD_DisplayChar()
  49:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****         function or a complete string line using LCD_DisplayStringAtLine() function.
  50:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****       o Display a string line on the specified position (x,y in pixel) and align mode
  51:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****         using LCD_DisplayStringAtLine() function.
  52:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****       o Draw and fill a basic shapes (dot, line, rectangle, circle, ellipse, .. bitmap)
  53:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c ****         on LCD using the available set of functions
  54:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** 
  55:Drivers/BSP/STM32F429I-Discovery/stm32f429i_discovery_lcd.c **** ------------------------------------------------------------------------------*/
