 779:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 780:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_TSC_CFG, 0x9A); 
 781:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 782:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Configure the Touch FIFO threshold: single point reading */
 783:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_FIFO_TH, 0x01);
 784:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 785:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Clear the FIFO memory content. */
