 844:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Get the touch screen X and Y positions values
 845:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.
 846:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  X: Pointer to X position value
 847:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  Y: Pointer to Y position value   
 848:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @retval None.
 849:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 850:Drivers/BSP/Components/stmpe811/stmpe811.c **** void stmpe811_TS_GetXY(uint16_t DeviceAddr, uint16_t *X, uint16_t *Y)
 851:Drivers/BSP/Components/stmpe811/stmpe811.c **** {
 852:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uint8_t  dataXYZ[4];
 853:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uint32_t uldataXYZ;
 854:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 855:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_ReadMultiple(DeviceAddr, STMPE811_REG_TSC_DATA_NON_INC, dataXYZ, sizeof(dataXYZ)) ;
 856:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 857:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Calculate positions values */
 858:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uldataXYZ = (dataXYZ[0] << 24)|(dataXYZ[1] << 16)|(dataXYZ[2] << 8)|(dataXYZ[3] << 0);     
