 547:Drivers/BSP/Components/stmpe811/stmpe811.c **** /**
 548:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Configure the Edge for which a transition is detectable for the
 549:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *         selected pin.
 550:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.
 551:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  IO_Pin: The IO pin to be configured. This parameter could be any 
 552:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *         combination of the following values:
 553:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *   @arg  STMPE811_PIN_x: Where x can be from 0 to 7.  
 554:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  Edge: The edge which will be detected. This parameter can be one or
 555:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *         a combination of following values: STMPE811_EDGE_FALLING and STMPE811_EDGE_RISING .
 556:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @retval None
 557:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 558:Drivers/BSP/Components/stmpe811/stmpe811.c **** void stmpe811_IO_SetEdgeMode(uint16_t DeviceAddr, uint32_t IO_Pin, uint8_t Edge)
 559:Drivers/BSP/Components/stmpe811/stmpe811.c **** {
 560:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uint8_t tmp1 = 0, tmp2 = 0;   
 561:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 562:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Get the current registers values */
 563:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp1 = IOE_Read(DeviceAddr, STMPE811_REG_IO_FE);
 564:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp2 = IOE_Read(DeviceAddr, STMPE811_REG_IO_RE);
 565:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 566:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Disable the Falling Edge */
 567:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp1 &= ~(uint8_t)IO_Pin;
 568:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 569:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Disable the Falling Edge */
 570:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp2 &= ~(uint8_t)IO_Pin;
 571:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 572:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Enable the Falling edge if selected */
 573:Drivers/BSP/Components/stmpe811/stmpe811.c ****   if (Edge & STMPE811_EDGE_FALLING)
 574:Drivers/BSP/Components/stmpe811/stmpe811.c ****   {
 575:Drivers/BSP/Components/stmpe811/stmpe811.c ****     tmp1 |= (uint8_t)IO_Pin;
 576:Drivers/BSP/Components/stmpe811/stmpe811.c ****   }
 577:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 578:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Enable the Rising edge if selected */
 579:Drivers/BSP/Components/stmpe811/stmpe811.c ****   if (Edge & STMPE811_EDGE_RISING)
 580:Drivers/BSP/Components/stmpe811/stmpe811.c ****   {
 581:Drivers/BSP/Components/stmpe811/stmpe811.c ****     tmp2 |= (uint8_t)IO_Pin;
 582:Drivers/BSP/Components/stmpe811/stmpe811.c ****   }
 583:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 584:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Write back the new registers values */
 585:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_IO_FE, tmp1);
 586:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_IO_RE, tmp2);
 587:Drivers/BSP/Components/stmpe811/stmpe811.c **** }
