 107:Drivers/BSP/Components/stmpe811/stmpe811.c **** /**
 108:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Initialize the stmpe811 and configure the needed hardware resources
 109:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.
 110:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @retval None
 111:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 112:Drivers/BSP/Components/stmpe811/stmpe811.c **** void stmpe811_Init(uint16_t DeviceAddr)
 113:Drivers/BSP/Components/stmpe811/stmpe811.c **** {
 114:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uint8_t instance;
 115:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uint8_t empty;
 116:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 117:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Check if device instance already exists */
 118:Drivers/BSP/Components/stmpe811/stmpe811.c ****   instance = stmpe811_GetInstance(DeviceAddr);
 119:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 120:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* To prevent double initialization */
 121:Drivers/BSP/Components/stmpe811/stmpe811.c ****   if(instance == 0xFF)
 122:Drivers/BSP/Components/stmpe811/stmpe811.c ****   {
 123:Drivers/BSP/Components/stmpe811/stmpe811.c ****     /* Look for empty instance */
 124:Drivers/BSP/Components/stmpe811/stmpe811.c ****     empty = stmpe811_GetInstance(0);
 125:Drivers/BSP/Components/stmpe811/stmpe811.c ****     
 126:Drivers/BSP/Components/stmpe811/stmpe811.c ****     if(empty < STMPE811_MAX_INSTANCE)
 127:Drivers/BSP/Components/stmpe811/stmpe811.c ****     {
 128:Drivers/BSP/Components/stmpe811/stmpe811.c ****       /* Register the current device instance */
 129:Drivers/BSP/Components/stmpe811/stmpe811.c ****       stmpe811[empty] = DeviceAddr;
 130:Drivers/BSP/Components/stmpe811/stmpe811.c ****       
 131:Drivers/BSP/Components/stmpe811/stmpe811.c ****       /* Initialize IO BUS layer */
 132:Drivers/BSP/Components/stmpe811/stmpe811.c ****       IOE_Init(); 
 133:Drivers/BSP/Components/stmpe811/stmpe811.c ****       
 134:Drivers/BSP/Components/stmpe811/stmpe811.c ****       /* Generate stmpe811 Software reset */
 135:Drivers/BSP/Components/stmpe811/stmpe811.c ****       stmpe811_Reset(DeviceAddr);
 136:Drivers/BSP/Components/stmpe811/stmpe811.c ****     }
 137:Drivers/BSP/Components/stmpe811/stmpe811.c ****   }
 138:Drivers/BSP/Components/stmpe811/stmpe811.c **** }
 139:Drivers/BSP/Components/stmpe811/stmpe811.c ****  
 140:Drivers/BSP/Components/stmpe811/stmpe811.c **** /**
 141:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Reset the stmpe811 by Software.
 142:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.  
 143:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @retval None
 144:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
ARM GAS  /tmp/ccijnwSj.s 			page 4


 145:Drivers/BSP/Components/stmpe811/stmpe811.c **** void stmpe811_Reset(uint16_t DeviceAddr)
 146:Drivers/BSP/Components/stmpe811/stmpe811.c **** {
 147:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Power Down the stmpe811 */  
 148:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_SYS_CTRL1, 2);
 149:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 150:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Wait for a delay to ensure registers erasing */
 151:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Delay(10); 
 152:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 153:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Power On the Codec after the power off => all registers are reinitialized */
 154:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_SYS_CTRL1, 0);
 155:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 156:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Wait for a delay to ensure registers erasing */
 157:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Delay(2); 
 158:Drivers/BSP/Components/stmpe811/stmpe811.c **** }
 159:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 160:Drivers/BSP/Components/stmpe811/stmpe811.c **** /**
 161:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Read the stmpe811 IO Expander device ID.
 162:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.  
 163:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @retval The Device ID (two bytes).
 164:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 165:Drivers/BSP/Components/stmpe811/stmpe811.c **** uint16_t stmpe811_ReadID(uint16_t DeviceAddr)
 166:Drivers/BSP/Components/stmpe811/stmpe811.c **** {
 167:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Initialize IO BUS layer */
 168:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Init(); 
 169:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 170:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Return the device ID value */
 171:Drivers/BSP/Components/stmpe811/stmpe811.c ****   return ((IOE_Read(DeviceAddr, STMPE811_REG_CHP_ID_LSB) << 8) |\
 172:Drivers/BSP/Components/stmpe811/stmpe811.c ****           (IOE_Read(DeviceAddr, STMPE811_REG_CHP_ID_MSB)));
 173:Drivers/BSP/Components/stmpe811/stmpe811.c **** }
 174:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 175:Drivers/BSP/Components/stmpe811/stmpe811.c **** /**
 176:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Enable the Global interrupt.
 177:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.       
 178:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @retval None
 179:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 180:Drivers/BSP/Components/stmpe811/stmpe811.c **** void stmpe811_EnableGlobalIT(uint16_t DeviceAddr)
 181:Drivers/BSP/Components/stmpe811/stmpe811.c **** {
 182:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uint8_t tmp = 0;
 183:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 184:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Read the Interrupt Control register  */
 185:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp = IOE_Read(DeviceAddr, STMPE811_REG_INT_CTRL);
 186:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 187:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Set the global interrupts to be Enabled */    
 188:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp |= (uint8_t)STMPE811_GIT_EN;
 189:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 190:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Write Back the Interrupt Control register */
 191:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_INT_CTRL, tmp); 
 192:Drivers/BSP/Components/stmpe811/stmpe811.c **** }
 193:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 194:Drivers/BSP/Components/stmpe811/stmpe811.c **** /**
 195:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Disable the Global interrupt.
 196:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.      
 197:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @retval None
 198:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 199:Drivers/BSP/Components/stmpe811/stmpe811.c **** void stmpe811_DisableGlobalIT(uint16_t DeviceAddr)
 200:Drivers/BSP/Components/stmpe811/stmpe811.c **** {
 201:Drivers/BSP/Components/stmpe811/stmpe811.c ****   uint8_t tmp = 0;
ARM GAS  /tmp/ccijnwSj.s 			page 5


 202:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 203:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Read the Interrupt Control register  */
 204:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp = IOE_Read(DeviceAddr, STMPE811_REG_INT_CTRL);
 205:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 206:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Set the global interrupts to be Disabled */    
 207:Drivers/BSP/Components/stmpe811/stmpe811.c ****   tmp &= ~(uint8_t)STMPE811_GIT_EN;
 208:Drivers/BSP/Components/stmpe811/stmpe811.c ****  
 209:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Write Back the Interrupt Control register */
 210:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_INT_CTRL, tmp);
 211:Drivers/BSP/Components/stmpe811/stmpe811.c ****     
 212:Drivers/BSP/Components/stmpe811/stmpe811.c **** }
 213:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 214:Drivers/BSP/Components/stmpe811/stmpe811.c **** /**
 215:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @brief  Enable the interrupt mode for the selected IT source
 216:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param  DeviceAddr: Device address on communication Bus.  
 217:Drivers/BSP/Components/stmpe811/stmpe811.c ****   * @param Source: The interrupt source to be configured, could be:
 218:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *   @arg  STMPE811_GIT_IO: IO interrupt 
 219:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *   @arg  STMPE811_GIT_ADC : ADC interrupt    
 220:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *   @arg  STMPE811_GIT_FE : Touch Screen Controller FIFO Error interrupt
 221:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *   @arg  STMPE811_GIT_FF : Touch Screen Controller FIFO Full interrupt      
 222:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *   @arg  STMPE811_GIT_FOV : Touch Screen Controller FIFO Overrun interrupt     
 223:Drivers/BSP/Components/stmpe811/stmpe811.c ****   *   @arg  STMPE811_GIT_FTH : Touch Screen Controller FIFO Threshold interrupt   
