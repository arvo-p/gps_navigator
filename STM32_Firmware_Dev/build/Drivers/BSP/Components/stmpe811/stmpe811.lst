 832:Drivers/BSP/Components/stmpe811/stmpe811.c ****   else
 833:Drivers/BSP/Components/stmpe811/stmpe811.c ****   {
 834:Drivers/BSP/Components/stmpe811/stmpe811.c ****     /* Reset FIFO */
