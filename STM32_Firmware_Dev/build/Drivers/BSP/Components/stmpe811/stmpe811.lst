 787:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 788:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Put the FIFO back into operation mode  */
 789:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_FIFO_STA, 0x00);
 790:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 791:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Set the range and accuracy pf the pressure measurement (Z) : 
 792:Drivers/BSP/Components/stmpe811/stmpe811.c ****      - Fractional part :7 
 793:Drivers/BSP/Components/stmpe811/stmpe811.c ****      - Whole part      :1 
 794:Drivers/BSP/Components/stmpe811/stmpe811.c ****   */
 795:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_TSC_FRACT_XYZ, 0x01);
 796:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 797:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Set the driving capability (limit) of the device for TSC pins: 50mA */
 798:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_TSC_I_DRIVE, 0x01);
 799:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 800:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Touch screen control configuration (enable TSC):
