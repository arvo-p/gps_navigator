 758:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 759:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Set the Functionalities to be Enabled */    
 760:Drivers/BSP/Components/stmpe811/stmpe811.c ****   mode &= ~(STMPE811_TS_FCT | STMPE811_ADC_FCT);  
 761:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 762:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Set the new register value */  
 763:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_SYS_CTRL2, mode); 
 764:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 765:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Select Sample Time, bit number and ADC Reference */
 766:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_ADC_CTRL1, 0x49);
 767:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 768:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Wait for 2 ms */
