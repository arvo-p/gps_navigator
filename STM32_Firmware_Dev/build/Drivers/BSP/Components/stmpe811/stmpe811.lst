 752:Drivers/BSP/Components/stmpe811/stmpe811.c ****   
 753:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Write the new register value */  
 754:Drivers/BSP/Components/stmpe811/stmpe811.c ****   IOE_Write(DeviceAddr, STMPE811_REG_SYS_CTRL2, mode); 
 755:Drivers/BSP/Components/stmpe811/stmpe811.c **** 
 756:Drivers/BSP/Components/stmpe811/stmpe811.c ****   /* Select TSC pins in TSC alternate mode */  
