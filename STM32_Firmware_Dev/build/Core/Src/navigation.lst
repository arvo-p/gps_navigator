 219:Core/Src/navigation.c **** 
 220:Core/Src/navigation.c **** NavAction nav_classify_transition(const RouteResult *route, int32_t seg_idx,
 221:Core/Src/navigation.c ****                                   int16_t *out_angle_deg, uint8_t *out_exit_num,
 222:Core/Src/navigation.c ****                                   int32_t *out_next_seg_idx) {
 223:Core/Src/navigation.c ****     if (out_angle_deg)    *out_angle_deg = 0;
 224:Core/Src/navigation.c ****     if (out_exit_num)     *out_exit_num = 0;
 225:Core/Src/navigation.c ****     if (out_next_seg_idx) *out_next_seg_idx = seg_idx + 1;
 226:Core/Src/navigation.c **** 
 227:Core/Src/navigation.c ****     if (!route || !route->found || seg_idx < 0 || seg_idx >= route->segment_count) {
 228:Core/Src/navigation.c ****         return NAV_NONE;
 229:Core/Src/navigation.c ****     }
 230:Core/Src/navigation.c **** 
 231:Core/Src/navigation.c ****     /* End of the final segment -> Arrive at destination */
 232:Core/Src/navigation.c ****     if (seg_idx == route->segment_count - 1) {
 233:Core/Src/navigation.c ****         return NAV_ARRIVE;
 234:Core/Src/navigation.c ****     }
 235:Core/Src/navigation.c **** 
 236:Core/Src/navigation.c ****     const RouteSegment *curr_seg = &route->segments[seg_idx];
 237:Core/Src/navigation.c ****     const RouteSegment *next_seg = &route->segments[seg_idx + 1];
 238:Core/Src/navigation.c **** 
 239:Core/Src/navigation.c ****     /* 1. Roundabout Detection:
 240:Core/Src/navigation.c ****      *    Triggered when approaching a roundabout node from a non-roundabout segment,
 241:Core/Src/navigation.c ****      *    or already on the entry node of a roundabout. */
 242:Core/Src/navigation.c ****     bool entering_rbt = (!is_roundabout_segment(curr_seg)) &&
 243:Core/Src/navigation.c ****                         ((curr_seg->end_node_flags & FLAG_ROUNDABOUT) != 0 ||
 244:Core/Src/navigation.c ****                          is_roundabout_segment(next_seg));
 245:Core/Src/navigation.c **** 
 246:Core/Src/navigation.c ****     if (entering_rbt) {
 247:Core/Src/navigation.c ****         uint8_t exits_passed = 0;
 248:Core/Src/navigation.c ****         int32_t k = seg_idx + 1;
 249:Core/Src/navigation.c **** 
 250:Core/Src/navigation.c ****         while (k < route->segment_count) {
 251:Core/Src/navigation.c ****             const RouteSegment *rseg = &route->segments[k];
 252:Core/Src/navigation.c ****             bool on_ring = ((rseg->start_node_flags & FLAG_ROUNDABOUT) != 0) &&
 253:Core/Src/navigation.c ****                            ((rseg->end_node_flags   & FLAG_ROUNDABOUT) != 0);
 254:Core/Src/navigation.c ****             if (!on_ring) {
 255:Core/Src/navigation.c ****                 /* Segment k leaves the roundabout ring (this is the exit we take) */
 256:Core/Src/navigation.c ****                 if (exits_passed < 255) exits_passed++;
 257:Core/Src/navigation.c ****                 break;
 258:Core/Src/navigation.c ****             }
 259:Core/Src/navigation.c ****             /* Only count rseg's end node as a bypassed exit if the NEXT segment stays on the ring 
 260:Core/Src/navigation.c ****             bool next_stays_on_ring = (k + 1 < route->segment_count) &&
 261:Core/Src/navigation.c ****                                       ((route->segments[k + 1].start_node_flags & FLAG_ROUNDABOUT) 
 262:Core/Src/navigation.c ****                                       ((route->segments[k + 1].end_node_flags   & FLAG_ROUNDABOUT) 
 263:Core/Src/navigation.c ****             if (next_stays_on_ring && rseg->out_degree >= 2 && exits_passed < 254) {
 264:Core/Src/navigation.c ****                 exits_passed++;
ARM GAS  /tmp/ccO2PifX.s 			page 32


 265:Core/Src/navigation.c ****             }
 266:Core/Src/navigation.c ****             k++;
 267:Core/Src/navigation.c ****         }
 268:Core/Src/navigation.c **** 
 269:Core/Src/navigation.c ****         if (exits_passed == 0) exits_passed = 1;
 270:Core/Src/navigation.c ****         int32_t exit_seg = (k < route->segment_count) ? k : (route->segment_count - 1);
 271:Core/Src/navigation.c **** 
 272:Core/Src/navigation.c ****         if (out_exit_num)     *out_exit_num = exits_passed;
 273:Core/Src/navigation.c ****         if (out_next_seg_idx) *out_next_seg_idx = exit_seg;
 274:Core/Src/navigation.c ****         if (out_angle_deg)    *out_angle_deg = compute_turn_angle_deg(route, seg_idx, exit_seg);
 275:Core/Src/navigation.c ****         return NAV_ROUNDABOUT;
 276:Core/Src/navigation.c ****     }
 277:Core/Src/navigation.c **** 
 278:Core/Src/navigation.c ****     /* 2. Standard Intersection / Fork / Turn Angle Evaluation */
 279:Core/Src/navigation.c ****     int16_t angle = compute_turn_angle_deg(route, seg_idx, seg_idx + 1);
 280:Core/Src/navigation.c ****     if (out_angle_deg) *out_angle_deg = angle;
 281:Core/Src/navigation.c **** 
 282:Core/Src/navigation.c ****     int16_t abs_angle = (angle < 0) ? -angle : angle;
 283:Core/Src/navigation.c ****     bool same_street  = (curr_seg->street_id != 0 && curr_seg->street_id == next_seg->street_id);
 284:Core/Src/navigation.c ****     bool street_changed = (next_seg->street_id != 0 && curr_seg->street_id != next_seg->street_id);
 285:Core/Src/navigation.c ****     bool is_intersection = (curr_seg->out_degree >= 2);
 286:Core/Src/navigation.c **** 
 287:Core/Src/navigation.c ****     /* A. Sharp Left / Sharp Right (Hard Turn > 135 degrees) */
 288:Core/Src/navigation.c ****     if (abs_angle > 135) {
 289:Core/Src/navigation.c ****         return (angle > 0) ? NAV_SHARP_LEFT : NAV_SHARP_RIGHT;
 290:Core/Src/navigation.c ****     }
 291:Core/Src/navigation.c **** 
 292:Core/Src/navigation.c ****     /* B. Turn Left / Turn Right (45 to 135 degrees) */
 293:Core/Src/navigation.c ****     if (abs_angle >= 45) {
 294:Core/Src/navigation.c ****         /* If staying on the exact same street with no branching choice (out_degree < 2),
 295:Core/Src/navigation.c ****          * ignore gentle road bends (< 65 deg), only alert on real intersection turns. */
 296:Core/Src/navigation.c ****         if (same_street && !is_intersection && abs_angle < 65) {
 297:Core/Src/navigation.c ****             return NAV_NONE;
 298:Core/Src/navigation.c ****         }
 299:Core/Src/navigation.c ****         return (angle > 0) ? NAV_TURN_LEFT : NAV_TURN_RIGHT;
 300:Core/Src/navigation.c ****     }
 301:Core/Src/navigation.c **** 
 302:Core/Src/navigation.c ****     /* C. Keep Left / Keep Right (Fork relative to alternative forward branch, or shallow street ch
 303:Core/Src/navigation.c ****     if (curr_seg->fork_dir != 0) {
 304:Core/Src/navigation.c ****         /* If staying on the same named road and going nearly dead straight (< 10 deg) past a minor
 305:Core/Src/navigation.c ****          * only trigger Keep Left/Right when the road itself splits (>= 10 deg) or changes street n
 306:Core/Src/navigation.c ****         if (street_changed || abs_angle >= 10) {
 307:Core/Src/navigation.c ****             return (curr_seg->fork_dir > 0) ? NAV_KEEP_LEFT : NAV_KEEP_RIGHT;
 308:Core/Src/navigation.c ****         }
 309:Core/Src/navigation.c ****     } else if (abs_angle >= 15 && street_changed) {
 310:Core/Src/navigation.c ****         return (angle > 0) ? NAV_KEEP_LEFT : NAV_KEEP_RIGHT;
 311:Core/Src/navigation.c ****     }
 312:Core/Src/navigation.c **** 
 313:Core/Src/navigation.c ****     /* D. Continue Straight (< 15 degrees onto a new street name at an intersection) */
 314:Core/Src/navigation.c ****     if (street_changed && is_intersection) {
 315:Core/Src/navigation.c ****         return NAV_CONTINUE_STRAIGHT;
 316:Core/Src/navigation.c ****     }
 317:Core/Src/navigation.c **** 
 318:Core/Src/navigation.c ****     return NAV_NONE;
 319:Core/Src/navigation.c **** }
