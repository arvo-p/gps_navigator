 462:Core/Src/navigation.c ****  * 3. "Lego" On-Demand Instruction String Builder
 463:Core/Src/navigation.c ****  *============================================================================*/
 464:Core/Src/navigation.c **** 
 465:Core/Src/navigation.c **** const char* nav_action_label(NavAction action) {
 466:Core/Src/navigation.c ****     switch (action) {
 467:Core/Src/navigation.c ****         case NAV_CONTINUE_STRAIGHT: return "Continue Straight";
 468:Core/Src/navigation.c ****         case NAV_KEEP_LEFT:         return "Keep Left";
 469:Core/Src/navigation.c ****         case NAV_KEEP_RIGHT:        return "Keep Right";
 470:Core/Src/navigation.c ****         case NAV_TURN_LEFT:         return "Turn Left";
 471:Core/Src/navigation.c ****         case NAV_TURN_RIGHT:        return "Turn Right";
 472:Core/Src/navigation.c ****         case NAV_SHARP_LEFT:        return "Sharp Left";
ARM GAS  /tmp/ccO2PifX.s 			page 42


 473:Core/Src/navigation.c ****         case NAV_SHARP_RIGHT:       return "Sharp Right";
 474:Core/Src/navigation.c ****         case NAV_ROUNDABOUT:        return "Roundabout";
 475:Core/Src/navigation.c ****         case NAV_ARRIVE:            return "Arrive at destination";
 476:Core/Src/navigation.c ****         default:                    return "Continue";
 477:Core/Src/navigation.c ****     }
 478:Core/Src/navigation.c **** }
