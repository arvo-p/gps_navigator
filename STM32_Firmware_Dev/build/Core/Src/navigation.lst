 371:Core/Src/navigation.c **** 
 372:Core/Src/navigation.c **** bool nav_update(NavState *nav, const RouteResult *route, const Geocoder *geo, GeoCoord gps_pos) {
 373:Core/Src/navigation.c ****     if (!nav || !route || !route->found || route->segment_count <= 0) {
 374:Core/Src/navigation.c ****         return false;
 375:Core/Src/navigation.c ****     }
 376:Core/Src/navigation.c **** 
 377:Core/Src/navigation.c ****     if (nav->current_seg_idx < 0 || nav->current_seg_idx >= route->segment_count) {
 378:Core/Src/navigation.c ****         nav->current_seg_idx = 0;
 379:Core/Src/navigation.c ****     }
 380:Core/Src/navigation.c **** 
 381:Core/Src/navigation.c ****     /* 1. Find closest segment to gps_pos (using curve geometry points so long curved roads
 382:Core/Src/navigation.c ****      *    never cause false-positive off-track detections) */
 383:Core/Src/navigation.c ****     uint32_t best_dist_m = 0xFFFFFFFFU;
 384:Core/Src/navigation.c ****     uint32_t best_rem_m  = 0;
 385:Core/Src/navigation.c ****     int32_t  best_seg    = nav->current_seg_idx;
 386:Core/Src/navigation.c **** 
 387:Core/Src/navigation.c ****     int32_t search_start = (nav->current_seg_idx > 2) ? (nav->current_seg_idx - 2) : 0;
 388:Core/Src/navigation.c ****     for (int32_t i = search_start; i < route->segment_count; ++i) {
 389:Core/Src/navigation.c ****         uint32_t rem_m = 0;
 390:Core/Src/navigation.c ****         uint32_t d = point_to_route_seg_dist_and_rem_m(route, i, gps_pos, &rem_m);
 391:Core/Src/navigation.c ****         if (d < best_dist_m || (d == best_dist_m && best_rem_m == 0 && rem_m > 0)) {
 392:Core/Src/navigation.c ****             best_dist_m = d;
 393:Core/Src/navigation.c ****             best_rem_m  = rem_m;
 394:Core/Src/navigation.c ****             best_seg    = i;
 395:Core/Src/navigation.c ****         }
 396:Core/Src/navigation.c ****         /* Stop scanning far ahead once we are well past a close match */
 397:Core/Src/navigation.c ****         if (best_dist_m < 30U && i > best_seg + 8) {
 398:Core/Src/navigation.c ****             break;
 399:Core/Src/navigation.c ****         }
 400:Core/Src/navigation.c ****     }
 401:Core/Src/navigation.c **** 
 402:Core/Src/navigation.c ****     nav->current_seg_idx   = best_seg;
 403:Core/Src/navigation.c ****     nav->dist_from_route_m = best_dist_m;
 404:Core/Src/navigation.c ****     uint32_t off_thresh_m  = (route->routing_profile == PROFILE_STROLLER)
 405:Core/Src/navigation.c ****                              ? NAV_OFF_TRACK_PED_M
 406:Core/Src/navigation.c ****                              : NAV_OFF_TRACK_CAR_M;
 407:Core/Src/navigation.c ****     nav->off_track         = (best_dist_m > off_thresh_m);
 408:Core/Src/navigation.c **** 
 409:Core/Src/navigation.c ****     /* 2. Scan forward from best_seg accumulating distance until the next real maneuver */
 410:Core/Src/navigation.c ****     uint32_t accum_dist_m = best_rem_m;
 411:Core/Src/navigation.c ****     NavAction action      = NAV_ARRIVE;
 412:Core/Src/navigation.c ****     int16_t   angle_deg   = 0;
 413:Core/Src/navigation.c ****     uint8_t   exit_num    = 0;
 414:Core/Src/navigation.c ****     int32_t   next_seg    = route->segment_count - 1;
 415:Core/Src/navigation.c **** 
ARM GAS  /tmp/ccO2PifX.s 			page 41


 416:Core/Src/navigation.c ****     for (int32_t s = best_seg; s < route->segment_count; ++s) {
 417:Core/Src/navigation.c ****         if (s > best_seg) {
 418:Core/Src/navigation.c ****             accum_dist_m += route->segments[s].length_m;
 419:Core/Src/navigation.c ****         }
 420:Core/Src/navigation.c **** 
 421:Core/Src/navigation.c ****         NavAction act = nav_classify_transition(route, s, &angle_deg, &exit_num, &next_seg);
 422:Core/Src/navigation.c ****         if (act != NAV_NONE) {
 423:Core/Src/navigation.c ****             action = act;
 424:Core/Src/navigation.c ****             break;
 425:Core/Src/navigation.c ****         }
 426:Core/Src/navigation.c ****     }
 427:Core/Src/navigation.c **** 
 428:Core/Src/navigation.c ****     uint32_t target_street_id = 0;
 429:Core/Src/navigation.c ****     if (action != NAV_ARRIVE && next_seg >= 0 && next_seg < route->segment_count) {
 430:Core/Src/navigation.c ****         target_street_id = route->segments[next_seg].street_id;
 431:Core/Src/navigation.c ****     } else if (action == NAV_ARRIVE && route->segment_count > 0) {
 432:Core/Src/navigation.c ****         target_street_id = route->segments[route->segment_count - 1].street_id;
 433:Core/Src/navigation.c ****     }
 434:Core/Src/navigation.c **** 
 435:Core/Src/navigation.c ****     /* Quantize distance to 5 m steps (matching 2 m GPS accuracy) */
 436:Core/Src/navigation.c ****     uint32_t dist_5m = ((accum_dist_m + 2U) / 5U) * 5U;
 437:Core/Src/navigation.c **** 
 438:Core/Src/navigation.c ****     nav->next_step.action           = action;
 439:Core/Src/navigation.c ****     nav->next_step.exit_num         = exit_num;
 440:Core/Src/navigation.c ****     nav->next_step.angle_deg        = angle_deg;
 441:Core/Src/navigation.c ****     nav->next_step.dist_m           = dist_5m;
 442:Core/Src/navigation.c ****     nav->next_step.next_street_id   = target_street_id;
 443:Core/Src/navigation.c ****     nav->next_step.maneuver_seg_idx = next_seg;
 444:Core/Src/navigation.c **** 
 445:Core/Src/navigation.c ****     /* 3. Update 1-entry street name cache ONLY when target_street_id changes */
 446:Core/Src/navigation.c ****     if (target_street_id == 0) {
 447:Core/Src/navigation.c ****         nav->cached_street_id = 0;
 448:Core/Src/navigation.c ****         nav->cached_street_name[0] = '\0';
 449:Core/Src/navigation.c ****     } else if (target_street_id != nav->cached_street_id) {
 450:Core/Src/navigation.c ****         nav->cached_street_id = target_street_id;
 451:Core/Src/navigation.c ****         nav->cached_street_name[0] = '\0';
 452:Core/Src/navigation.c ****         if (geo) {
 453:Core/Src/navigation.c ****             geocoder_get_street_name(geo, target_street_id,
 454:Core/Src/navigation.c ****                                      nav->cached_street_name, sizeof(nav->cached_street_name));
 455:Core/Src/navigation.c ****         }
 456:Core/Src/navigation.c ****     }
 457:Core/Src/navigation.c **** 
 458:Core/Src/navigation.c ****     return true;
 459:Core/Src/navigation.c **** }
 460:Core/Src/navigation.c **** 
