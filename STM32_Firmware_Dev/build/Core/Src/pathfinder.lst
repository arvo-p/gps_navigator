  58:Core/Src/pathfinder.c **** static inline uint32_t make_node_key(int32_t slot, uint32_t local_idx) {
  59:Core/Src/pathfinder.c ****     return (((uint32_t)slot & 0x0F) << 20) | (local_idx & 0x000FFFFF);
  60:Core/Src/pathfinder.c **** }
  61:Core/Src/pathfinder.c **** 
  62:Core/Src/pathfinder.c **** static inline int32_t key_to_slot(uint32_t key) {
  63:Core/Src/pathfinder.c ****     return (int32_t)((key >> 20) & 0x0F);
  64:Core/Src/pathfinder.c **** }
  65:Core/Src/pathfinder.c **** 
  66:Core/Src/pathfinder.c **** static inline uint32_t key_to_idx(uint32_t key) {
  67:Core/Src/pathfinder.c ****     return (key & 0x000FFFFF);
  68:Core/Src/pathfinder.c **** }
  69:Core/Src/pathfinder.c **** 
  70:Core/Src/pathfinder.c **** static inline bool edge_allowed_for_profile(const EdgeRecord *edge, RoutingProfile profile) {
  71:Core/Src/pathfinder.c ****     if (edge->edge_flags == 0) {
  72:Core/Src/pathfinder.c ****         /* Legacy binary format (before edge_flags were populated): allow in both modes */
  73:Core/Src/pathfinder.c ****         return true;
  74:Core/Src/pathfinder.c ****     }
  75:Core/Src/pathfinder.c ****     uint16_t req = (profile == PROFILE_STROLLER) ? EDGE_STROLLER_ALLOWED : EDGE_CAR_ALLOWED;
  76:Core/Src/pathfinder.c ****     return (edge->edge_flags & req) != 0;
  77:Core/Src/pathfinder.c **** }
