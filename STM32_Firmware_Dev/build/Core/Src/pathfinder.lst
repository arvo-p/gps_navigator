  90:Core/Src/pathfinder.c **** static inline uint16_t edge_travel_time_sec(const EdgeRecord *edge, RoutingProfile profile) {
  91:Core/Src/pathfinder.c ****     if (profile == PROFILE_STROLLER) {
  92:Core/Src/pathfinder.c ****         /* Actual walking time at 1.25 m/s (4.5 km/h) */
  93:Core/Src/pathfinder.c ****         uint32_t sec = ((uint32_t)edge->length_m * 4) / 5;
  94:Core/Src/pathfinder.c ****         if (sec < 1) sec = 1;
  95:Core/Src/pathfinder.c ****         if (sec > 65535) sec = 65535;
  96:Core/Src/pathfinder.c ****         return (uint16_t)sec;
  97:Core/Src/pathfinder.c ****     }
  98:Core/Src/pathfinder.c ****     return edge->cost_sec;
  99:Core/Src/pathfinder.c **** }
 100:Core/Src/pathfinder.c **** 
 101:Core/Src/pathfinder.c **** static inline uint32_t heuristic_for_profile(GeoCoord a, GeoCoord b, RoutingProfile profile, bool i
 102:Core/Src/pathfinder.c ****     uint32_t d = geo_distance_m(a, b);
 103:Core/Src/pathfinder.c ****     if (profile == PROFILE_STROLLER) {
 104:Core/Src/pathfinder.c ****         return (d * 4) / 5;
ARM GAS  /tmp/ccgO5vYG.s 			page 5


 105:Core/Src/pathfinder.c ****     }
 106:Core/Src/pathfinder.c ****     return d / (is_backbone ? 33 : 25);
 107:Core/Src/pathfinder.c **** }
