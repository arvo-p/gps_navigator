   1:Core/Src/pathfinder.c **** /**
   2:Core/Src/pathfinder.c ****  * @file pathfinder.c
   3:Core/Src/pathfinder.c ****  * @brief Hybrid A* pathfinding engine implementation
   4:Core/Src/pathfinder.c ****  *        (Embedded STM32 adaptation using FatFs & shared external SDRAM/PSRAM workspace).
   5:Core/Src/pathfinder.c ****  *
   6:Core/Src/pathfinder.c ****  * Mode A: Local Multi-Tile A* for short trips (< 15 km or adjacent tiles).
   7:Core/Src/pathfinder.c ****  * Mode B: Hierarchical 3-Phase A* (Local -> Backbone Highway -> Local) for long trips.
   8:Core/Src/pathfinder.c ****  *
   9:Core/Src/pathfinder.c ****  * NOTE: 100% static allocation. Zero malloc, free, or realloc. Embedded safe.
  10:Core/Src/pathfinder.c ****  */
  11:Core/Src/pathfinder.c **** 
  12:Core/Src/pathfinder.c **** #include "pathfinder.h"
  13:Core/Src/pathfinder.c **** #include "astar_heap.h"
