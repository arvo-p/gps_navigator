  17:Core/Src/pathfinder.c **** 
  18:Core/Src/pathfinder.c **** #define MAX_SESSION_TILES TILE_GRAPH_CACHE_MAX_LOCAL
  19:Core/Src/pathfinder.c **** #define INF_COST 0x3FFFFFFF
  20:Core/Src/pathfinder.c **** 
  21:Core/Src/pathfinder.c **** /* Pre-allocated static workspace for A* search in external SDRAM (.sdram).
  22:Core/Src/pathfinder.c ****  * Local A* and Backbone A* run sequentially in separate phases, so they share
  23:Core/Src/pathfinder.c ****  * the same union workspace.
  24:Core/Src/pathfinder.c ****  */
  25:Core/Src/pathfinder.c **** #define EXT_RAM_BSS __attribute__((section(".sdram")))
  26:Core/Src/pathfinder.c **** static union {
  27:Core/Src/pathfinder.c ****     struct {
  28:Core/Src/pathfinder.c ****         uint32_t g_scores[MAX_SESSION_TILES][TILE_MAX_LOCAL_NODES];
  29:Core/Src/pathfinder.c ****         uint32_t came_from_keys[MAX_SESSION_TILES][TILE_MAX_LOCAL_NODES];
  30:Core/Src/pathfinder.c ****         uint32_t came_from_edges[MAX_SESSION_TILES][TILE_MAX_LOCAL_NODES];
