 773:Core/Src/pathfinder.c **** bool pathfinder_reroute_to_existing(Pathfinder *pf, GeoCoord current_pos,
 774:Core/Src/pathfinder.c ****                                     int32_t current_seg_idx, RouteResult *io_route) {
 775:Core/Src/pathfinder.c ****     if (!pf || !io_route || !io_route->found || io_route->segment_count <= 0) {
 776:Core/Src/pathfinder.c ****         return false;
 777:Core/Src/pathfinder.c ****     }
 778:Core/Src/pathfinder.c **** 
 779:Core/Src/pathfinder.c ****     if (current_seg_idx < 0) current_seg_idx = 0;
 780:Core/Src/pathfinder.c ****     if (current_seg_idx >= io_route->segment_count) {
 781:Core/Src/pathfinder.c ****         current_seg_idx = io_route->segment_count - 1;
 782:Core/Src/pathfinder.c ****     }
 783:Core/Src/pathfinder.c **** 
 784:Core/Src/pathfinder.c ****     /* Final destination in case full fallback reroute is needed */
 785:Core/Src/pathfinder.c ****     const RouteSegment *last_seg = &io_route->segments[io_route->segment_count - 1];
 786:Core/Src/pathfinder.c ****     GeoCoord final_goal = geo_coord_make(last_seg->end_lat_e7, last_seg->end_lon_e7);
 787:Core/Src/pathfinder.c **** 
 788:Core/Src/pathfinder.c ****     /* 1. Collect candidate rejoin nodes from a segment window around current_seg_idx */
 789:Core/Src/pathfinder.c ****     int32_t s_start = (current_seg_idx > 2) ? (current_seg_idx - 2) : 0;
 790:Core/Src/pathfinder.c ****     int32_t s_end   = current_seg_idx + 30;
 791:Core/Src/pathfinder.c ****     if (s_end >= io_route->segment_count) {
 792:Core/Src/pathfinder.c ****         s_end = io_route->segment_count - 1;
 793:Core/Src/pathfinder.c ****     }
 794:Core/Src/pathfinder.c **** 
 795:Core/Src/pathfinder.c ****     int32_t cand_count = 0;
 796:Core/Src/pathfinder.c **** 
 797:Core/Src/pathfinder.c ****     for (int32_t s = s_start; s <= s_end && cand_count < MAX_REROUTE_CANDIDATES; ++s) {
 798:Core/Src/pathfinder.c ****         const RouteSegment *seg = &io_route->segments[s];
 799:Core/Src/pathfinder.c **** 
 800:Core/Src/pathfinder.c ****         /* Add segment start node (splicing before segment s) */
 801:Core/Src/pathfinder.c ****         bool dup_start = false;
 802:Core/Src/pathfinder.c ****         for (int32_t c = 0; c < cand_count; ++c) {
 803:Core/Src/pathfinder.c ****             if (s_reroute_candidates[c].lat_e7 == seg->start_lat_e7 &&
 804:Core/Src/pathfinder.c ****                 s_reroute_candidates[c].lon_e7 == seg->start_lon_e7) {
 805:Core/Src/pathfinder.c ****                 dup_start = true;
 806:Core/Src/pathfinder.c ****                 break;
 807:Core/Src/pathfinder.c ****             }
 808:Core/Src/pathfinder.c ****         }
 809:Core/Src/pathfinder.c ****         if (!dup_start && cand_count < MAX_REROUTE_CANDIDATES) {
 810:Core/Src/pathfinder.c ****             s_reroute_candidates[cand_count].lat_e7 = seg->start_lat_e7;
 811:Core/Src/pathfinder.c ****             s_reroute_candidates[cand_count].lon_e7 = seg->start_lon_e7;
 812:Core/Src/pathfinder.c ****             s_reroute_candidates[cand_count].rejoin_seg_idx = s;
 813:Core/Src/pathfinder.c ****             cand_count++;
 814:Core/Src/pathfinder.c ****         }
 815:Core/Src/pathfinder.c **** 
 816:Core/Src/pathfinder.c ****         /* Add segment end node (splicing before segment s + 1) */
 817:Core/Src/pathfinder.c ****         bool dup_end = false;
 818:Core/Src/pathfinder.c ****         for (int32_t c = 0; c < cand_count; ++c) {
 819:Core/Src/pathfinder.c ****             if (s_reroute_candidates[c].lat_e7 == seg->end_lat_e7 &&
 820:Core/Src/pathfinder.c ****                 s_reroute_candidates[c].lon_e7 == seg->end_lon_e7) {
