 153:Core/Src/lvgl_port_example.c **** /*----------------------------------------------------------------------------
 154:Core/Src/lvgl_port_example.c ****  * 1. Display Flush Callback (DMA2D RGB565 -> ARGB8888 in SDRAM)
 155:Core/Src/lvgl_port_example.c ****  *----------------------------------------------------------------------------*/
 156:Core/Src/lvgl_port_example.c **** static void my_disp_flush_cb(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map)
 157:Core/Src/lvgl_port_example.c **** {
 158:Core/Src/lvgl_port_example.c ****   int32_t width  = lv_area_get_width(area);
 159:Core/Src/lvgl_port_example.c ****   int32_t height = lv_area_get_height(area);
 160:Core/Src/lvgl_port_example.c **** 
 161:Core/Src/lvgl_port_example.c ****   uint32_t dst_addr = LCD_FRAME_BUFFER + 4U * (area->y1 * MY_DISP_HOR_RES + area->x1);
 162:Core/Src/lvgl_port_example.c **** 
 163:Core/Src/lvgl_port_example.c ****   DMA2D->CR      = 0x00010000UL;                         /* Memory-to-Memory with PFC */
 164:Core/Src/lvgl_port_example.c ****   DMA2D->FGMAR   = (uint32_t)px_map;
 165:Core/Src/lvgl_port_example.c ****   DMA2D->OMAR    = dst_addr;
 166:Core/Src/lvgl_port_example.c ****   DMA2D->FGOR    = 0;
 167:Core/Src/lvgl_port_example.c ****   DMA2D->OOR     = MY_DISP_HOR_RES - width;
 168:Core/Src/lvgl_port_example.c ****   DMA2D->FGPFCCR = LTDC_PIXEL_FORMAT_RGB565;
 169:Core/Src/lvgl_port_example.c ****   DMA2D->OPFCCR  = LTDC_PIXEL_FORMAT_ARGB8888;
 170:Core/Src/lvgl_port_example.c ****   DMA2D->NLR     = (uint32_t)((width << 16) | (uint16_t)height);
 171:Core/Src/lvgl_port_example.c ****   DMA2D->CR     |= DMA2D_CR_START;
 172:Core/Src/lvgl_port_example.c **** 
 173:Core/Src/lvgl_port_example.c ****   while (DMA2D->CR & DMA2D_CR_START) {}
 174:Core/Src/lvgl_port_example.c **** 
 175:Core/Src/lvgl_port_example.c ****   lv_display_flush_ready(disp);
 176:Core/Src/lvgl_port_example.c **** }
 177:Core/Src/lvgl_port_example.c **** 
