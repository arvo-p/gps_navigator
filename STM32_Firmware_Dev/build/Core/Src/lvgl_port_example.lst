 927:Core/Src/lvgl_port_example.c ****     {
 928:Core/Src/lvgl_port_example.c ****       fix->time_valid = true;
 929:Core/Src/lvgl_port_example.c ****     }
 930:Core/Src/lvgl_port_example.c **** 
 931:Core/Src/lvgl_port_example.c ****     (void)GPS_ParseUtcDate(f_date, &fix->utc_day, &fix->utc_month, &fix->utc_year);
 932:Core/Src/lvgl_port_example.c **** 
 933:Core/Src/lvgl_port_example.c ****     if (*f_status == 'A')
 934:Core/Src/lvgl_port_example.c ****     {
 935:Core/Src/lvgl_port_example.c ****       int32_t lat_e7 = 0;
 936:Core/Src/lvgl_port_example.c ****       int32_t lon_e7 = 0;
 937:Core/Src/lvgl_port_example.c ****       if (GPS_ParseNmeaCoordE7(f_lat, *f_ns, &lat_e7) &&
 938:Core/Src/lvgl_port_example.c ****           GPS_ParseNmeaCoordE7(f_lon, *f_ew, &lon_e7))
 939:Core/Src/lvgl_port_example.c ****       {
