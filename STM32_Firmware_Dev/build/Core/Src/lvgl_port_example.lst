 507:Core/Src/lvgl_port_example.c ****       int32_t cur_y = (MY_DISP_VER_RES - 1) - (int32_t)ts.Y;
 508:Core/Src/lvgl_port_example.c **** 
 509:Core/Src/lvgl_port_example.c ****       if (!dragging)
 510:Core/Src/lvgl_port_example.c ****       {
 511:Core/Src/lvgl_port_example.c ****         dragging     = true;
 512:Core/Src/lvgl_port_example.c ****         last_touch_x = cur_x;
 513:Core/Src/lvgl_port_example.c ****         last_touch_y = cur_y;
 514:Core/Src/lvgl_port_example.c ****       }
 515:Core/Src/lvgl_port_example.c ****       else
 516:Core/Src/lvgl_port_example.c ****       {
 517:Core/Src/lvgl_port_example.c ****         int32_t dx = cur_x - last_touch_x;
 518:Core/Src/lvgl_port_example.c ****         int32_t dy = cur_y - last_touch_y;
 519:Core/Src/lvgl_port_example.c **** 
 520:Core/Src/lvgl_port_example.c ****         if (dx != 0 || dy != 0)
 521:Core/Src/lvgl_port_example.c ****         {
 522:Core/Src/lvgl_port_example.c ****           last_touch_x = cur_x;
 523:Core/Src/lvgl_port_example.c ****           last_touch_y = cur_y;
 524:Core/Src/lvgl_port_example.c **** 
 525:Core/Src/lvgl_port_example.c ****           InputEvent_t evt = {
 526:Core/Src/lvgl_port_example.c ****             .dx         = (int16_t)dx,
 527:Core/Src/lvgl_port_example.c ****             .dy         = (int16_t)dy,
 528:Core/Src/lvgl_port_example.c ****             .touch_down = true,
 529:Core/Src/lvgl_port_example.c ****             .accel_mg   = {0, 0, 1000},
 530:Core/Src/lvgl_port_example.c ****             .stationary = false,
 531:Core/Src/lvgl_port_example.c ****           };
 532:Core/Src/lvgl_port_example.c ****           xQueueSend(s_q_input_evt, &evt, 0);
 533:Core/Src/lvgl_port_example.c ****         }
 534:Core/Src/lvgl_port_example.c ****       }
 535:Core/Src/lvgl_port_example.c ****     }
 536:Core/Src/lvgl_port_example.c ****     else
 537:Core/Src/lvgl_port_example.c ****     {
ARM GAS  /tmp/cc3RdFuP.s 			page 23


