 500:Core/Src/lvgl_port_example.c **** 
 501:Core/Src/lvgl_port_example.c ****     /* Future Accelerometer Hook:
 502:Core/Src/lvgl_port_example.c ****      * Read I2C/SPI IMU here -> populate accel_mg[0..2] & stationary flag.
 503:Core/Src/lvgl_port_example.c ****      */
 504:Core/Src/lvgl_port_example.c ****     if (ts.TouchDetected)
 505:Core/Src/lvgl_port_example.c ****     {
