 486:Core/Src/lvgl_port_example.c ****  * TASK 1: Sensor_Input_Task (Priority: AboveNormal)
 487:Core/Src/lvgl_port_example.c ****  * Polls Touchscreen (and future Accelerometer) at ~66 Hz and sends deltas.
 488:Core/Src/lvgl_port_example.c ****  *============================================================================*/
 489:Core/Src/lvgl_port_example.c **** static void Sensor_Input_Task(void *argument)
 490:Core/Src/lvgl_port_example.c **** {
 491:Core/Src/lvgl_port_example.c ****   (void)argument;
 492:Core/Src/lvgl_port_example.c ****   bool    dragging     = false;
 493:Core/Src/lvgl_port_example.c ****   int32_t last_touch_x = 0;
 494:Core/Src/lvgl_port_example.c ****   int32_t last_touch_y = 0;
 495:Core/Src/lvgl_port_example.c **** 
 496:Core/Src/lvgl_port_example.c ****   for (;;)
 497:Core/Src/lvgl_port_example.c ****   {
