   3:Core/Src/lvgl_port_example.c ****   * @file    Core/Src/lvgl_port_example.c
   4:Core/Src/lvgl_port_example.c ****   * @brief   FreeRTOS 5-Task GPS Map & Navigation Port for STM32F429I-Discovery:
   5:Core/Src/lvgl_port_example.c ****   *            1. Sensor_Input_Task (Touchscreen + Accelerometer hook, Prio 3)
   6:Core/Src/lvgl_port_example.c ****   *            2. GPS_UART_Task     (NMEA/UBX fix publisher, Prio 3)
   7:Core/Src/lvgl_port_example.c ****   *            3. UI_LVGL_Task      (Camera, non-blocking SDRAM tile blit, LVGL, Prio 2)
   8:Core/Src/lvgl_port_example.c ****   *            4. Tile_Loader_Task  (Async microSD .pak tile streamer, Prio 1)
   9:Core/Src/lvgl_port_example.c ****   *            5. Pathfinder_Task   (Background Hybrid A* routing, Prio 0)
  10:Core/Src/lvgl_port_example.c ****   ******************************************************************************
  11:Core/Src/lvgl_port_example.c ****   */
