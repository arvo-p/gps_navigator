 502:Core/Src/lvgl_port_example.c **** /*============================================================================
 503:Core/Src/lvgl_port_example.c ****  * TASK 1: Sensor_Input_Task (Priority: AboveNormal)
 504:Core/Src/lvgl_port_example.c ****  * Polls Touchscreen (and future Accelerometer) at ~66 Hz and sends deltas.
 505:Core/Src/lvgl_port_example.c ****  *============================================================================*/
 506:Core/Src/lvgl_port_example.c **** static void Sensor_Input_Task(void *argument)
 507:Core/Src/lvgl_port_example.c **** {
 508:Core/Src/lvgl_port_example.c ****   (void)argument;
 509:Core/Src/lvgl_port_example.c ****   bool    dragging     = false;
 510:Core/Src/lvgl_port_example.c ****   int32_t last_touch_x = 0;
 511:Core/Src/lvgl_port_example.c ****   int32_t last_touch_y = 0;
 512:Core/Src/lvgl_port_example.c **** 
 513:Core/Src/lvgl_port_example.c ****   for (;;)
 514:Core/Src/lvgl_port_example.c ****   {
 515:Core/Src/lvgl_port_example.c ****     TS_StateTypeDef ts;
 516:Core/Src/lvgl_port_example.c ****     BSP_TS_GetState(&ts);
 517:Core/Src/lvgl_port_example.c **** 
 518:Core/Src/lvgl_port_example.c ****     /* Future Accelerometer Hook:
 519:Core/Src/lvgl_port_example.c ****      * Read I2C/SPI IMU here -> populate accel_mg[0..2] & stationary flag.
 520:Core/Src/lvgl_port_example.c ****      */
 521:Core/Src/lvgl_port_example.c ****     if (ts.TouchDetected)
 522:Core/Src/lvgl_port_example.c ****     {
 523:Core/Src/lvgl_port_example.c ****       int32_t cur_x = (int32_t)ts.X;
 524:Core/Src/lvgl_port_example.c ****       int32_t cur_y = (MY_DISP_VER_RES - 1) - (int32_t)ts.Y;
 525:Core/Src/lvgl_port_example.c **** 
 526:Core/Src/lvgl_port_example.c ****       if (!dragging)
 527:Core/Src/lvgl_port_example.c ****       {
 528:Core/Src/lvgl_port_example.c ****         dragging     = true;
 529:Core/Src/lvgl_port_example.c ****         last_touch_x = cur_x;
 530:Core/Src/lvgl_port_example.c ****         last_touch_y = cur_y;
 531:Core/Src/lvgl_port_example.c ****       }
 532:Core/Src/lvgl_port_example.c ****       else
 533:Core/Src/lvgl_port_example.c ****       {
 534:Core/Src/lvgl_port_example.c ****         int32_t dx = cur_x - last_touch_x;
 535:Core/Src/lvgl_port_example.c ****         int32_t dy = cur_y - last_touch_y;
 536:Core/Src/lvgl_port_example.c **** 
 537:Core/Src/lvgl_port_example.c ****         if (dx != 0 || dy != 0)
 538:Core/Src/lvgl_port_example.c ****         {
 539:Core/Src/lvgl_port_example.c ****           last_touch_x = cur_x;
 540:Core/Src/lvgl_port_example.c ****           last_touch_y = cur_y;
 541:Core/Src/lvgl_port_example.c **** 
 542:Core/Src/lvgl_port_example.c ****           InputEvent_t evt = {
 543:Core/Src/lvgl_port_example.c ****             .dx         = (int16_t)dx,
 544:Core/Src/lvgl_port_example.c ****             .dy         = (int16_t)dy,
 545:Core/Src/lvgl_port_example.c ****             .touch_down = true,
 546:Core/Src/lvgl_port_example.c ****             .accel_mg   = {0, 0, 1000},
ARM GAS  /tmp/cchqAdiv.s 			page 15


 547:Core/Src/lvgl_port_example.c ****             .stationary = false,
 548:Core/Src/lvgl_port_example.c ****           };
 549:Core/Src/lvgl_port_example.c ****           xQueueSend(s_q_input_evt, &evt, 0);
 550:Core/Src/lvgl_port_example.c ****         }
 551:Core/Src/lvgl_port_example.c ****       }
 552:Core/Src/lvgl_port_example.c ****     }
 553:Core/Src/lvgl_port_example.c ****     else
 554:Core/Src/lvgl_port_example.c ****     {
 555:Core/Src/lvgl_port_example.c ****       dragging = false;
 556:Core/Src/lvgl_port_example.c ****     }
 557:Core/Src/lvgl_port_example.c **** 
 558:Core/Src/lvgl_port_example.c ****     vTaskDelay(pdMS_TO_TICKS(15));
 559:Core/Src/lvgl_port_example.c ****   }
 560:Core/Src/lvgl_port_example.c **** }
 561:Core/Src/lvgl_port_example.c **** 
 562:Core/Src/lvgl_port_example.c **** /*============================================================================
 563:Core/Src/lvgl_port_example.c ****  * TASK 2: GPS_UART_Task (Priority: AboveNormal)
 564:Core/Src/lvgl_port_example.c ****  * Receives UART NMEA frames via GPS_UART_INSTANCE (configured in main.h)
 565:Core/Src/lvgl_port_example.c ****  * using GPS_DMA_RX_STREAM circular buffer + IDLE IRQ, parses UTC time and
 566:Core/Src/lvgl_port_example.c ****  * WGS84 coordinates, and publishes the latest GpsFix_t.
 567:Core/Src/lvgl_port_example.c ****  *============================================================================*/
 568:Core/Src/lvgl_port_example.c **** void GPS_UART_IRQHandler(void)
 569:Core/Src/lvgl_port_example.c **** {
 570:Core/Src/lvgl_port_example.c ****   uint32_t sr = GPS_UART_INSTANCE->SR;
