 314:Core/Src/lvgl_port_example.c **** /*----------------------------------------------------------------------------
 315:Core/Src/lvgl_port_example.c ****  * 5. Non-Blocking Tile Cache Lookup (Queues Async Request on Miss)
 316:Core/Src/lvgl_port_example.c ****  *----------------------------------------------------------------------------*/
 317:Core/Src/lvgl_port_example.c **** static const TileCacheSlot *Request_Or_Get_Tile_Async(int32_t tx, int32_t ty)
 318:Core/Src/lvgl_port_example.c **** {
 319:Core/Src/lvgl_port_example.c ****   if (!s_pak_ready)
 320:Core/Src/lvgl_port_example.c ****   {
 321:Core/Src/lvgl_port_example.c ****     return NULL;
 322:Core/Src/lvgl_port_example.c ****   }
 323:Core/Src/lvgl_port_example.c **** 
 324:Core/Src/lvgl_port_example.c ****   s_cache_clock++;
 325:Core/Src/lvgl_port_example.c **** 
 326:Core/Src/lvgl_port_example.c ****   /* 1. Check if tile (tx, ty) is already in the cache (READY or LOADING) */
 327:Core/Src/lvgl_port_example.c ****   for (int i = 0; i < TILE_CACHE_SLOTS; i++)
 328:Core/Src/lvgl_port_example.c ****   {
 329:Core/Src/lvgl_port_example.c ****     if (s_tile_cache[i].state != TILE_SLOT_EMPTY &&
 330:Core/Src/lvgl_port_example.c ****         s_tile_cache[i].tx == tx &&
 331:Core/Src/lvgl_port_example.c ****         s_tile_cache[i].ty == ty)
 332:Core/Src/lvgl_port_example.c ****     {
 333:Core/Src/lvgl_port_example.c ****       s_tile_cache[i].lru_tick = s_cache_clock;
 334:Core/Src/lvgl_port_example.c ****       return &s_tile_cache[i];
 335:Core/Src/lvgl_port_example.c ****     }
 336:Core/Src/lvgl_port_example.c ****   }
 337:Core/Src/lvgl_port_example.c **** 
 338:Core/Src/lvgl_port_example.c ****   /* 2. Cache miss: pick an EMPTY slot or the oldest READY slot (never evict LOADING) */
 339:Core/Src/lvgl_port_example.c ****   int victim = -1;
 340:Core/Src/lvgl_port_example.c ****   uint32_t min_tick = 0xFFFFFFFFUL;
 341:Core/Src/lvgl_port_example.c **** 
 342:Core/Src/lvgl_port_example.c ****   for (int i = 0; i < TILE_CACHE_SLOTS; i++)
 343:Core/Src/lvgl_port_example.c ****   {
 344:Core/Src/lvgl_port_example.c ****     if (s_tile_cache[i].state == TILE_SLOT_EMPTY)
 345:Core/Src/lvgl_port_example.c ****     {
 346:Core/Src/lvgl_port_example.c ****       victim = i;
 347:Core/Src/lvgl_port_example.c ****       break;
 348:Core/Src/lvgl_port_example.c ****     }
 349:Core/Src/lvgl_port_example.c ****     if (s_tile_cache[i].state == TILE_SLOT_READY && s_tile_cache[i].lru_tick < min_tick)
 350:Core/Src/lvgl_port_example.c ****     {
 351:Core/Src/lvgl_port_example.c ****       min_tick = s_tile_cache[i].lru_tick;
 352:Core/Src/lvgl_port_example.c ****       victim   = i;
 353:Core/Src/lvgl_port_example.c ****     }
 354:Core/Src/lvgl_port_example.c ****   }
 355:Core/Src/lvgl_port_example.c **** 
 356:Core/Src/lvgl_port_example.c ****   if (victim < 0)
 357:Core/Src/lvgl_port_example.c ****   {
 358:Core/Src/lvgl_port_example.c ****     return NULL; /* All 9 slots are currently in-flight */
 359:Core/Src/lvgl_port_example.c ****   }
 360:Core/Src/lvgl_port_example.c **** 
 361:Core/Src/lvgl_port_example.c ****   /* 3. Reserve slot as LOADING and enqueue async read request for Tile_Loader_Task */
 362:Core/Src/lvgl_port_example.c ****   TileCacheSlot *slot = &s_tile_cache[victim];
 363:Core/Src/lvgl_port_example.c ****   slot->tx       = tx;
 364:Core/Src/lvgl_port_example.c ****   slot->ty       = ty;
 365:Core/Src/lvgl_port_example.c ****   slot->lru_tick = s_cache_clock;
 366:Core/Src/lvgl_port_example.c ****   slot->has_data = false;
 367:Core/Src/lvgl_port_example.c ****   slot->state    = TILE_SLOT_LOADING;
ARM GAS  /tmp/cc3RdFuP.s 			page 9


 368:Core/Src/lvgl_port_example.c **** 
 369:Core/Src/lvgl_port_example.c ****   TileRequest_t req = {
 370:Core/Src/lvgl_port_example.c ****     .slot_idx = (uint8_t)victim,
 371:Core/Src/lvgl_port_example.c ****     .tx       = tx,
 372:Core/Src/lvgl_port_example.c ****     .ty       = ty,
 373:Core/Src/lvgl_port_example.c ****   };
 374:Core/Src/lvgl_port_example.c **** 
 375:Core/Src/lvgl_port_example.c ****   if (xQueueSend(s_q_tile_req, &req, 0) != pdPASS)
 376:Core/Src/lvgl_port_example.c ****   {
 377:Core/Src/lvgl_port_example.c ****     slot->state = TILE_SLOT_EMPTY;
 378:Core/Src/lvgl_port_example.c ****     return NULL;
 379:Core/Src/lvgl_port_example.c ****   }
 380:Core/Src/lvgl_port_example.c **** 
 381:Core/Src/lvgl_port_example.c ****   return slot;
 382:Core/Src/lvgl_port_example.c **** }
