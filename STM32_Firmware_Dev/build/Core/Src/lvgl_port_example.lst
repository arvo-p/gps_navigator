1071:Core/Src/lvgl_port_example.c ****  * TASK 3: Tile_Loader_Task (Priority: BelowNormal)
1072:Core/Src/lvgl_port_example.c ****  * Owns microSD .pak streaming under s_mutex_sd so UI never blocks on SD I/O.
1073:Core/Src/lvgl_port_example.c ****  *============================================================================*/
1074:Core/Src/lvgl_port_example.c **** static void Tile_Loader_Task(void *argument)
1075:Core/Src/lvgl_port_example.c **** {
1076:Core/Src/lvgl_port_example.c ****   (void)argument;
1077:Core/Src/lvgl_port_example.c **** 
1078:Core/Src/lvgl_port_example.c ****   /* 1. Mount SD & open tiles_z14.pak once (retrying every 1s if card not inserted) */
1079:Core/Src/lvgl_port_example.c ****   while (!s_pak_ready)
1080:Core/Src/lvgl_port_example.c ****   {
1081:Core/Src/lvgl_port_example.c ****     xSemaphoreTake(s_mutex_sd, portMAX_DELAY);
1082:Core/Src/lvgl_port_example.c ****     FRESULT res = f_mount(&s_fatfs, "", 1);
1083:Core/Src/lvgl_port_example.c ****     if (res == FR_OK)
1084:Core/Src/lvgl_port_example.c ****     {
1085:Core/Src/lvgl_port_example.c ****       if (Init_Tile_Pak_Locked(PATH_TILES_Z14, &s_pak_z14, &s_hdr_z14,
1086:Core/Src/lvgl_port_example.c ****                                s_palette_rgb565, s_clmt_z14, 64U))
1087:Core/Src/lvgl_port_example.c ****       {
1088:Core/Src/lvgl_port_example.c ****         s_pak_ready = true;
1089:Core/Src/lvgl_port_example.c ****       }
1090:Core/Src/lvgl_port_example.c ****     }
1091:Core/Src/lvgl_port_example.c ****     xSemaphoreGive(s_mutex_sd);
1092:Core/Src/lvgl_port_example.c **** 
1093:Core/Src/lvgl_port_example.c ****     if (s_pak_ready)
1094:Core/Src/lvgl_port_example.c ****     {
1095:Core/Src/lvgl_port_example.c ****       xTaskNotify(s_ui_task_hdl, NOTIFY_SD_MOUNTED, eSetBits);
1096:Core/Src/lvgl_port_example.c ****     }
1097:Core/Src/lvgl_port_example.c ****     else
1098:Core/Src/lvgl_port_example.c ****     {
1099:Core/Src/lvgl_port_example.c ****       xTaskNotify(s_ui_task_hdl, NOTIFY_SD_ERROR, eSetBits);
1100:Core/Src/lvgl_port_example.c ****       vTaskDelay(pdMS_TO_TICKS(1000));
1101:Core/Src/lvgl_port_example.c ****     }
