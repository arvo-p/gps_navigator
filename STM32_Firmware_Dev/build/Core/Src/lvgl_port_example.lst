 434:Core/Src/lvgl_port_example.c **** static uint32_t Render_Visible_Tiles_To_MapFB(void)
 435:Core/Src/lvgl_port_example.c **** {
 436:Core/Src/lvgl_port_example.c ****   memset(s_map_fb, 0xDF, sizeof(s_map_fb));
 437:Core/Src/lvgl_port_example.c **** 
 438:Core/Src/lvgl_port_example.c ****   uint32_t ready_count = 0;
 439:Core/Src/lvgl_port_example.c **** 
 440:Core/Src/lvgl_port_example.c ****   for (int32_t i = 0; i < s_visible_tiles.count; i++)
 441:Core/Src/lvgl_port_example.c ****   {
 442:Core/Src/lvgl_port_example.c ****     const VisibleTile *vt     = &s_visible_tiles.tiles[i];
 443:Core/Src/lvgl_port_example.c ****     const TileCacheSlot *slot = Request_Or_Get_Tile_Async(vt->tile.x, vt->tile.y);
 444:Core/Src/lvgl_port_example.c **** 
 445:Core/Src/lvgl_port_example.c ****     int32_t dst_x0 = vt->screen_x;
 446:Core/Src/lvgl_port_example.c ****     int32_t dst_y0 = vt->screen_y;
 447:Core/Src/lvgl_port_example.c ****     int32_t dst_x1 = dst_x0 + TILE_PX_SIZE;
 448:Core/Src/lvgl_port_example.c ****     int32_t dst_y1 = dst_y0 + TILE_PX_SIZE;
 449:Core/Src/lvgl_port_example.c **** 
 450:Core/Src/lvgl_port_example.c ****     int32_t clip_x0 = (dst_x0 < 0) ? 0 : dst_x0;
 451:Core/Src/lvgl_port_example.c ****     int32_t clip_y0 = (dst_y0 < 0) ? 0 : dst_y0;
 452:Core/Src/lvgl_port_example.c ****     int32_t clip_x1 = (dst_x1 > MY_DISP_HOR_RES) ? MY_DISP_HOR_RES : dst_x1;
 453:Core/Src/lvgl_port_example.c ****     int32_t clip_y1 = (dst_y1 > MY_DISP_VER_RES) ? MY_DISP_VER_RES : dst_y1;
 454:Core/Src/lvgl_port_example.c **** 
 455:Core/Src/lvgl_port_example.c ****     if (slot != NULL && slot->state == TILE_SLOT_READY)
 456:Core/Src/lvgl_port_example.c ****     {
 457:Core/Src/lvgl_port_example.c ****       if (slot->has_data)
 458:Core/Src/lvgl_port_example.c ****       {
 459:Core/Src/lvgl_port_example.c ****         ready_count++;
 460:Core/Src/lvgl_port_example.c ****       }
 461:Core/Src/lvgl_port_example.c **** 
 462:Core/Src/lvgl_port_example.c ****       for (int32_t sy = clip_y0; sy < clip_y1; sy++)
 463:Core/Src/lvgl_port_example.c ****       {
 464:Core/Src/lvgl_port_example.c ****         int32_t ty             = sy - dst_y0;
 465:Core/Src/lvgl_port_example.c ****         const uint8_t *src_row = &slot->pixels[ty * TILE_PX_SIZE];
 466:Core/Src/lvgl_port_example.c ****         uint16_t *dst_row      = &s_map_fb[sy * MY_DISP_HOR_RES];
 467:Core/Src/lvgl_port_example.c **** 
 468:Core/Src/lvgl_port_example.c ****         for (int32_t sx = clip_x0; sx < clip_x1; sx++)
 469:Core/Src/lvgl_port_example.c ****         {
 470:Core/Src/lvgl_port_example.c ****           int32_t tx = sx - dst_x0;
 471:Core/Src/lvgl_port_example.c ****           dst_row[sx] = s_palette_rgb565[src_row[tx]];
 472:Core/Src/lvgl_port_example.c ****         }
 473:Core/Src/lvgl_port_example.c ****       }
 474:Core/Src/lvgl_port_example.c ****     }
 475:Core/Src/lvgl_port_example.c ****     else
 476:Core/Src/lvgl_port_example.c ****     {
 477:Core/Src/lvgl_port_example.c ****       /* Tile is streaming in the background -> draw subtle grid border */
 478:Core/Src/lvgl_port_example.c ****       for (int32_t sy = clip_y0; sy < clip_y1; sy++)
 479:Core/Src/lvgl_port_example.c ****       {
 480:Core/Src/lvgl_port_example.c ****         int32_t ty        = sy - dst_y0;
 481:Core/Src/lvgl_port_example.c ****         uint16_t *dst_row = &s_map_fb[sy * MY_DISP_HOR_RES];
 482:Core/Src/lvgl_port_example.c ****         for (int32_t sx = clip_x0; sx < clip_x1; sx++)
 483:Core/Src/lvgl_port_example.c ****         {
 484:Core/Src/lvgl_port_example.c ****           int32_t tx = sx - dst_x0;
 485:Core/Src/lvgl_port_example.c ****           if ((tx & 31) == 0 || (ty & 31) == 0)
 486:Core/Src/lvgl_port_example.c ****           {
 487:Core/Src/lvgl_port_example.c ****             dst_row[sx] = 0xCE59U;
 488:Core/Src/lvgl_port_example.c ****           }
 489:Core/Src/lvgl_port_example.c ****         }
