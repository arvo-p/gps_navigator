 331:Core/Src/lvgl_port_example.c **** /*----------------------------------------------------------------------------
 332:Core/Src/lvgl_port_example.c ****  * 5. Non-Blocking Tile Cache Lookup (Queues Async Request on Miss)
 333:Core/Src/lvgl_port_example.c ****  *----------------------------------------------------------------------------*/
 334:Core/Src/lvgl_port_example.c **** static const TileCacheSlot *Request_Or_Get_Tile_Async(int32_t tx, int32_t ty)
 335:Core/Src/lvgl_port_example.c **** {
 336:Core/Src/lvgl_port_example.c ****   if (!s_pak_ready)
 337:Core/Src/lvgl_port_example.c ****   {
 338:Core/Src/lvgl_port_example.c ****     return NULL;
 339:Core/Src/lvgl_port_example.c ****   }
 340:Core/Src/lvgl_port_example.c **** 
 341:Core/Src/lvgl_port_example.c ****   s_cache_clock++;
 342:Core/Src/lvgl_port_example.c **** 
 343:Core/Src/lvgl_port_example.c ****   /* 1. Check if tile (tx, ty) is already in the cache (READY or LOADING) */
 344:Core/Src/lvgl_port_example.c ****   for (int i = 0; i < TILE_CACHE_SLOTS; i++)
 345:Core/Src/lvgl_port_example.c ****   {
 346:Core/Src/lvgl_port_example.c ****     if (s_tile_cache[i].state != TILE_SLOT_EMPTY &&
 347:Core/Src/lvgl_port_example.c ****         s_tile_cache[i].tx == tx &&
 348:Core/Src/lvgl_port_example.c ****         s_tile_cache[i].ty == ty)
 349:Core/Src/lvgl_port_example.c ****     {
 350:Core/Src/lvgl_port_example.c ****       s_tile_cache[i].lru_tick = s_cache_clock;
 351:Core/Src/lvgl_port_example.c ****       return &s_tile_cache[i];
 352:Core/Src/lvgl_port_example.c ****     }
 353:Core/Src/lvgl_port_example.c ****   }
 354:Core/Src/lvgl_port_example.c **** 
 355:Core/Src/lvgl_port_example.c ****   /* 2. Cache miss: pick an EMPTY slot or the oldest READY slot (never evict LOADING) */
 356:Core/Src/lvgl_port_example.c ****   int victim = -1;
 357:Core/Src/lvgl_port_example.c ****   uint32_t min_tick = 0xFFFFFFFFUL;
 358:Core/Src/lvgl_port_example.c **** 
 359:Core/Src/lvgl_port_example.c ****   for (int i = 0; i < TILE_CACHE_SLOTS; i++)
 360:Core/Src/lvgl_port_example.c ****   {
 361:Core/Src/lvgl_port_example.c ****     if (s_tile_cache[i].state == TILE_SLOT_EMPTY)
 362:Core/Src/lvgl_port_example.c ****     {
 363:Core/Src/lvgl_port_example.c ****       victim = i;
 364:Core/Src/lvgl_port_example.c ****       break;
 365:Core/Src/lvgl_port_example.c ****     }
 366:Core/Src/lvgl_port_example.c ****     if (s_tile_cache[i].state == TILE_SLOT_READY && s_tile_cache[i].lru_tick < min_tick)
 367:Core/Src/lvgl_port_example.c ****     {
ARM GAS  /tmp/cchqAdiv.s 			page 9


 368:Core/Src/lvgl_port_example.c ****       min_tick = s_tile_cache[i].lru_tick;
 369:Core/Src/lvgl_port_example.c ****       victim   = i;
 370:Core/Src/lvgl_port_example.c ****     }
 371:Core/Src/lvgl_port_example.c ****   }
 372:Core/Src/lvgl_port_example.c **** 
 373:Core/Src/lvgl_port_example.c ****   if (victim < 0)
 374:Core/Src/lvgl_port_example.c ****   {
 375:Core/Src/lvgl_port_example.c ****     return NULL; /* All 9 slots are currently in-flight */
 376:Core/Src/lvgl_port_example.c ****   }
 377:Core/Src/lvgl_port_example.c **** 
 378:Core/Src/lvgl_port_example.c ****   /* 3. Reserve slot as LOADING and enqueue async read request for Tile_Loader_Task */
 379:Core/Src/lvgl_port_example.c ****   TileCacheSlot *slot = &s_tile_cache[victim];
 380:Core/Src/lvgl_port_example.c ****   slot->tx       = tx;
 381:Core/Src/lvgl_port_example.c ****   slot->ty       = ty;
 382:Core/Src/lvgl_port_example.c ****   slot->lru_tick = s_cache_clock;
 383:Core/Src/lvgl_port_example.c ****   slot->has_data = false;
 384:Core/Src/lvgl_port_example.c ****   slot->state    = TILE_SLOT_LOADING;
 385:Core/Src/lvgl_port_example.c **** 
 386:Core/Src/lvgl_port_example.c ****   TileRequest_t req = {
 387:Core/Src/lvgl_port_example.c ****     .slot_idx = (uint8_t)victim,
 388:Core/Src/lvgl_port_example.c ****     .tx       = tx,
 389:Core/Src/lvgl_port_example.c ****     .ty       = ty,
 390:Core/Src/lvgl_port_example.c ****   };
 391:Core/Src/lvgl_port_example.c **** 
 392:Core/Src/lvgl_port_example.c ****   if (xQueueSend(s_q_tile_req, &req, 0) != pdPASS)
 393:Core/Src/lvgl_port_example.c ****   {
 394:Core/Src/lvgl_port_example.c ****     slot->state = TILE_SLOT_EMPTY;
 395:Core/Src/lvgl_port_example.c ****     return NULL;
 396:Core/Src/lvgl_port_example.c ****   }
 397:Core/Src/lvgl_port_example.c **** 
 398:Core/Src/lvgl_port_example.c ****   return slot;
 399:Core/Src/lvgl_port_example.c **** }
 400:Core/Src/lvgl_port_example.c **** 
