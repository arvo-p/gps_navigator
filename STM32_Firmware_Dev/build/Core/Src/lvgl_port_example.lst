 595:Core/Src/lvgl_port_example.c ****       vTaskNotifyGiveFromISR(s_gps_task_hdl, &xHigherPriorityTaskWoken);
 596:Core/Src/lvgl_port_example.c ****       portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
 597:Core/Src/lvgl_port_example.c ****     }
