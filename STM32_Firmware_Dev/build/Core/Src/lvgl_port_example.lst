 572:Core/Src/lvgl_port_example.c ****   {
 573:Core/Src/lvgl_port_example.c ****     /* Reading SR followed by DR clears IDLE, ORE, FE, and NE flags */
 574:Core/Src/lvgl_port_example.c ****     (void)GPS_UART_INSTANCE->DR;
 575:Core/Src/lvgl_port_example.c **** 
 576:Core/Src/lvgl_port_example.c ****     if ((sr & USART_SR_IDLE) && (s_gps_task_hdl != NULL))
 577:Core/Src/lvgl_port_example.c ****     {
 578:Core/Src/lvgl_port_example.c ****       BaseType_t xHigherPriorityTaskWoken = pdFALSE;
 579:Core/Src/lvgl_port_example.c ****       vTaskNotifyGiveFromISR(s_gps_task_hdl, &xHigherPriorityTaskWoken);
 580:Core/Src/lvgl_port_example.c ****       portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
 581:Core/Src/lvgl_port_example.c ****     }
 582:Core/Src/lvgl_port_example.c ****   }
 583:Core/Src/lvgl_port_example.c **** }
 584:Core/Src/lvgl_port_example.c **** 
