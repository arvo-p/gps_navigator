 698:Core/Src/lvgl_port_example.c **** /**
 699:Core/Src/lvgl_port_example.c ****   * @brief  Select active GNSS constellations on ATGM336H-5N ($PCAS04).
 700:Core/Src/lvgl_port_example.c ****   * @param  mode: ATGM336H_MODE_GPS_GLONASS (5 -> "$PCAS04,5*1C\r\n"), etc.
 701:Core/Src/lvgl_port_example.c ****   */
 702:Core/Src/lvgl_port_example.c **** void GPS_ATGM336H_SetConstellation(uint8_t mode)
 703:Core/Src/lvgl_port_example.c **** {
 704:Core/Src/lvgl_port_example.c ****   char cmd[16];
 705:Core/Src/lvgl_port_example.c ****   (void)snprintf(cmd, sizeof(cmd), "PCAS04,%u", (unsigned)mode);
 706:Core/Src/lvgl_port_example.c ****   GPS_SendCasicCmd(cmd);
 707:Core/Src/lvgl_port_example.c **** }
 708:Core/Src/lvgl_port_example.c **** 
 709:Core/Src/lvgl_port_example.c **** /**
 710:Core/Src/lvgl_port_example.c ****   * @brief  Put ATGM336H-5N into low-power standby/sleep mode ($PCAS12).
 711:Core/Src/lvgl_port_example.c ****   * @param  standby_sec: Standby duration in seconds (1..65535).
 712:Core/Src/lvgl_port_example.c ****   *                      Pass 0 to use maximum duration (65535 s).
 713:Core/Src/lvgl_port_example.c ****   * @note   If the ATGM336H-5N hardware ON_OFF pin (Pin 5) is wired to a GPIO,
 714:Core/Src/lvgl_port_example.c ****   *         driving ON_OFF LOW will also place the module in <10 uA deep shutdown.
 715:Core/Src/lvgl_port_example.c ****   */
 716:Core/Src/lvgl_port_example.c **** void GPS_ATGM336H_EnterSleep(uint16_t standby_sec)
 717:Core/Src/lvgl_port_example.c **** {
 718:Core/Src/lvgl_port_example.c ****   uint16_t sec = (standby_sec == 0U) ? 65535U : standby_sec;
 719:Core/Src/lvgl_port_example.c ****   char cmd[24];
 720:Core/Src/lvgl_port_example.c ****   (void)snprintf(cmd, sizeof(cmd), "PCAS12,%u", (unsigned)sec);
 721:Core/Src/lvgl_port_example.c ****   GPS_SendCasicCmd(cmd);
 722:Core/Src/lvgl_port_example.c **** }
 723:Core/Src/lvgl_port_example.c **** 
 724:Core/Src/lvgl_port_example.c **** /**
 725:Core/Src/lvgl_port_example.c ****   * @brief  Wake ATGM336H-5N from standby/sleep mode ($PCAS10,0 hot start)
 726:Core/Src/lvgl_port_example.c ****   *         and restore GPS + GLONASS constellation mode ($PCAS04,5).
 727:Core/Src/lvgl_port_example.c ****   */
 728:Core/Src/lvgl_port_example.c **** void GPS_ATGM336H_Wakeup(void)
 729:Core/Src/lvgl_port_example.c **** {
 730:Core/Src/lvgl_port_example.c ****   const uint8_t wake_pulse = 0xFFU;
 731:Core/Src/lvgl_port_example.c ****   GPS_UART_SendBytes(&wake_pulse, 1U);
 732:Core/Src/lvgl_port_example.c ****   vTaskDelay(pdMS_TO_TICKS(20));
 733:Core/Src/lvgl_port_example.c **** 
 734:Core/Src/lvgl_port_example.c ****   /* Hot start ($PCAS10,0*1C) and re-select GPS + GLONASS ($PCAS04,5*1C) */
 735:Core/Src/lvgl_port_example.c ****   GPS_SendCasicCmd("PCAS10,0");
 736:Core/Src/lvgl_port_example.c ****   vTaskDelay(pdMS_TO_TICKS(50));
 737:Core/Src/lvgl_port_example.c ****   GPS_ATGM336H_SetConstellation(ATGM336H_MODE_GPS_GLONASS);
 738:Core/Src/lvgl_port_example.c **** }
