 493:Core/Src/lvgl_port_example.c **** 
 494:Core/Src/lvgl_port_example.c ****   /* Project GPS position onto the camera viewport */
 495:Core/Src/lvgl_port_example.c ****   int32_t gps_sx = 0, gps_sy = 0;
 496:Core/Src/lvgl_port_example.c ****   map_camera_latlon_to_screen(&s_camera, s_gps_pos, &gps_sx, &gps_sy);
 497:Core/Src/lvgl_port_example.c ****   Draw_GPS_Marker(gps_sx, gps_sy);
