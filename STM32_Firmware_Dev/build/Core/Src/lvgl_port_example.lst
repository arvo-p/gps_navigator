 941:Core/Src/lvgl_port_example.c ****         uint32_t kn_x100 = GPS_ParseDecimalX100(f_spd);
 942:Core/Src/lvgl_port_example.c ****         fix->speed_kmh   = (uint16_t)((kn_x100 * 1852U + 50000U) / 100000U);
 943:Core/Src/lvgl_port_example.c ****         fix->heading_deg = (uint16_t)((GPS_ParseDecimalX100(f_cog) + 50U) / 100U) % 360U;
 944:Core/Src/lvgl_port_example.c ****         fix->valid       = true;
 945:Core/Src/lvgl_port_example.c ****       }
 946:Core/Src/lvgl_port_example.c ****     }
 947:Core/Src/lvgl_port_example.c ****     else if (*f_status == 'V')
 948:Core/Src/lvgl_port_example.c ****     {
