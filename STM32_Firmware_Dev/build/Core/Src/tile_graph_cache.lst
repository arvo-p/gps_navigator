  71:Core/Src/tile_graph_cache.c ****         FSIZE_t e_size = f_size(&fil);
  72:Core/Src/tile_graph_cache.c ****         if (e_size > 0 && (e_size % sizeof(EdgeRecord)) == 0) {
  73:Core/Src/tile_graph_cache.c ****             uint32_t e_count = (uint32_t)(e_size / sizeof(EdgeRecord));
  74:Core/Src/tile_graph_cache.c ****             if (e_count <= g->max_edges) {
  75:Core/Src/tile_graph_cache.c ****                 uint32_t e_bytes = e_count * (uint32_t)sizeof(EdgeRecord);
  76:Core/Src/tile_graph_cache.c ****                 if (f_read(&fil, g->edges, e_bytes, &br) == FR_OK && br == e_bytes) {
  77:Core/Src/tile_graph_cache.c ****                     g->edge_count = e_count;
  78:Core/Src/tile_graph_cache.c ****                 }
  79:Core/Src/tile_graph_cache.c ****             }
  80:Core/Src/tile_graph_cache.c ****         }
  81:Core/Src/tile_graph_cache.c ****         f_close(&fil);
  82:Core/Src/tile_graph_cache.c ****     }
  83:Core/Src/tile_graph_cache.c **** 
  84:Core/Src/tile_graph_cache.c ****     /* 3. Store Geometry file path for on-demand curve loading */
  85:Core/Src/tile_graph_cache.c ****     strncpy(g->geom_path, geom_path, sizeof(g->geom_path) - 1);
  86:Core/Src/tile_graph_cache.c ****     g->geom_path[sizeof(g->geom_path) - 1] = '\0';
  87:Core/Src/tile_graph_cache.c **** 
  88:Core/Src/tile_graph_cache.c ****     g->loaded = true;
  89:Core/Src/tile_graph_cache.c ****     return true;
  90:Core/Src/tile_graph_cache.c **** }
