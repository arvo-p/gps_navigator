  54:Core/Src/tile_graph_cache.c **** 
  55:Core/Src/tile_graph_cache.c ****     uint32_t count = (uint32_t)(n_size / sizeof(NodeRecord));
  56:Core/Src/tile_graph_cache.c ****     if (count > g->max_nodes) {
  57:Core/Src/tile_graph_cache.c ****         f_close(&fil);
  58:Core/Src/tile_graph_cache.c ****         return false;
  59:Core/Src/tile_graph_cache.c ****     }
  60:Core/Src/tile_graph_cache.c **** 
  61:Core/Src/tile_graph_cache.c ****     uint32_t bytes_to_read = count * (uint32_t)sizeof(NodeRecord);
  62:Core/Src/tile_graph_cache.c ****     if (f_read(&fil, g->nodes, bytes_to_read, &br) != FR_OK || br != bytes_to_read) {
  63:Core/Src/tile_graph_cache.c ****         f_close(&fil);
