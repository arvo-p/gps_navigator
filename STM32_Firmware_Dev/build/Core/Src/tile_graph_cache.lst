 127:Core/Src/tile_graph_cache.c **** TileGraph* tile_graph_cache_get_tile(TileGraphCache *cache, int32_t grid_lat, int32_t grid_lon) {
 128:Core/Src/tile_graph_cache.c ****     if (!cache) return NULL;
 129:Core/Src/tile_graph_cache.c **** 
 130:Core/Src/tile_graph_cache.c ****     cache->access_clock++;
 131:Core/Src/tile_graph_cache.c **** 
 132:Core/Src/tile_graph_cache.c ****     /* If backbone currently occupies the shared SDRAM union, invalidate it before loading local ti
 133:Core/Src/tile_graph_cache.c ****     if (cache->backbone_loaded) {
 134:Core/Src/tile_graph_cache.c ****         free_graph(&cache->backbone);
 135:Core/Src/tile_graph_cache.c ****         cache->backbone_loaded = false;
 136:Core/Src/tile_graph_cache.c ****         cache->backbone_profile = -1;
 137:Core/Src/tile_graph_cache.c ****     }
 138:Core/Src/tile_graph_cache.c **** 
 139:Core/Src/tile_graph_cache.c ****     /* 1. Check if already cached */
 140:Core/Src/tile_graph_cache.c ****     for (int32_t i = 0; i < cache->local_capacity; ++i) {
 141:Core/Src/tile_graph_cache.c ****         TileGraph *slot = &cache->local_slots[i];
 142:Core/Src/tile_graph_cache.c ****         if (slot->loaded && slot->grid_lat == grid_lat && slot->grid_lon == grid_lon) {
 143:Core/Src/tile_graph_cache.c ****             slot->lru_counter = cache->access_clock;
 144:Core/Src/tile_graph_cache.c ****             return slot;
 145:Core/Src/tile_graph_cache.c ****         }
 146:Core/Src/tile_graph_cache.c ****     }
 147:Core/Src/tile_graph_cache.c **** 
 148:Core/Src/tile_graph_cache.c ****     /* 2. Format file paths */
 149:Core/Src/tile_graph_cache.c ****     char nodes_path[TILE_GRAPH_PATH_MAX];
 150:Core/Src/tile_graph_cache.c ****     char edges_path[TILE_GRAPH_PATH_MAX];
 151:Core/Src/tile_graph_cache.c ****     char geom_path[TILE_GRAPH_PATH_MAX];
 152:Core/Src/tile_graph_cache.c **** 
 153:Core/Src/tile_graph_cache.c ****     snprintf(nodes_path, sizeof(nodes_path), "%s/local_%03ld_%03ld_nodes.bin", cache->base_dir, (lo
 154:Core/Src/tile_graph_cache.c ****     snprintf(edges_path, sizeof(edges_path), "%s/local_%03ld_%03ld_edges.bin", cache->base_dir, (lo
 155:Core/Src/tile_graph_cache.c ****     snprintf(geom_path,  sizeof(geom_path),  "%s/local_%03ld_%03ld_geom.bin",  cache->base_dir, (lo
 156:Core/Src/tile_graph_cache.c **** 
 157:Core/Src/tile_graph_cache.c ****     /* 3. Find LRU slot that is NOT pinned */
 158:Core/Src/tile_graph_cache.c ****     int32_t lru_idx = -1;
 159:Core/Src/tile_graph_cache.c ****     uint32_t min_lru = 0xFFFFFFFF;
 160:Core/Src/tile_graph_cache.c ****     for (int32_t i = 0; i < cache->local_capacity; ++i) {
 161:Core/Src/tile_graph_cache.c ****         if (!cache->local_slots[i].loaded) {
 162:Core/Src/tile_graph_cache.c ****             lru_idx = i;
 163:Core/Src/tile_graph_cache.c ****             break;
 164:Core/Src/tile_graph_cache.c ****         }
 165:Core/Src/tile_graph_cache.c ****         if (cache->local_slots[i].pin_count == 0 && cache->local_slots[i].lru_counter < min_lru) {
 166:Core/Src/tile_graph_cache.c ****             min_lru = cache->local_slots[i].lru_counter;
 167:Core/Src/tile_graph_cache.c ****             lru_idx = i;
ARM GAS  /tmp/ccZ8GFOs.s 			page 5


 168:Core/Src/tile_graph_cache.c ****         }
 169:Core/Src/tile_graph_cache.c ****     }
 170:Core/Src/tile_graph_cache.c **** 
 171:Core/Src/tile_graph_cache.c ****     if (lru_idx < 0) {
 172:Core/Src/tile_graph_cache.c ****         return NULL;
 173:Core/Src/tile_graph_cache.c ****     }
 174:Core/Src/tile_graph_cache.c **** 
 175:Core/Src/tile_graph_cache.c ****     TileGraph *slot = &cache->local_slots[lru_idx];
 176:Core/Src/tile_graph_cache.c ****     if (!load_graph_files(slot, nodes_path, edges_path, geom_path)) {
 177:Core/Src/tile_graph_cache.c ****         return NULL;
 178:Core/Src/tile_graph_cache.c ****     }
 179:Core/Src/tile_graph_cache.c **** 
