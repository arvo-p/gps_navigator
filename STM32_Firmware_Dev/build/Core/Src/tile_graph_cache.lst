  92:Core/Src/tile_graph_cache.c **** bool tile_graph_cache_init(TileGraphCache *cache, const char *base_dir, int32_t local_capacity) {
  93:Core/Src/tile_graph_cache.c ****     if (!cache) return false;
  94:Core/Src/tile_graph_cache.c **** 
  95:Core/Src/tile_graph_cache.c ****     memset(cache, 0, sizeof(TileGraphCache));
  96:Core/Src/tile_graph_cache.c ****     if (base_dir && base_dir[0] != '\0') {
  97:Core/Src/tile_graph_cache.c ****         strncpy(cache->base_dir, base_dir, sizeof(cache->base_dir) - 1);
  98:Core/Src/tile_graph_cache.c ****     } else {
  99:Core/Src/tile_graph_cache.c ****         strcpy(cache->base_dir, "binary_map_data");
 100:Core/Src/tile_graph_cache.c ****     }
 101:Core/Src/tile_graph_cache.c **** 
 102:Core/Src/tile_graph_cache.c ****     cache->local_capacity = (local_capacity > 0 && local_capacity <= TILE_GRAPH_CACHE_MAX_LOCAL)
 103:Core/Src/tile_graph_cache.c ****                             ? local_capacity : TILE_GRAPH_CACHE_MAX_LOCAL;
 104:Core/Src/tile_graph_cache.c ****     cache->access_clock = 1;
 105:Core/Src/tile_graph_cache.c **** 
 106:Core/Src/tile_graph_cache.c ****     for (int32_t i = 0; i < TILE_GRAPH_CACHE_MAX_LOCAL; ++i) {
 107:Core/Src/tile_graph_cache.c ****         cache->local_slots[i].nodes = s_graph_pool.local.nodes[i];
 108:Core/Src/tile_graph_cache.c ****         cache->local_slots[i].max_nodes = TILE_MAX_LOCAL_NODES;
 109:Core/Src/tile_graph_cache.c ****         cache->local_slots[i].edges = s_graph_pool.local.edges[i];
 110:Core/Src/tile_graph_cache.c ****         cache->local_slots[i].max_edges = TILE_MAX_LOCAL_EDGES;
