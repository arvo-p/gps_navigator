  12:Core/Src/tile_graph_cache.c **** /* Pre-allocated static graph buffers in external SDRAM (.sdram).
  13:Core/Src/tile_graph_cache.c ****  * Because Local A* (Phase 1 / Phase 3) and Backbone A* (Phase 2) execute
  14:Core/Src/tile_graph_cache.c ****  * sequentially in separate phases, local_slots and backbone share the same
  15:Core/Src/tile_graph_cache.c ****  * 5.52 MB external RAM union so both fit inside an 8 MB SDRAM/PSRAM chip.
  16:Core/Src/tile_graph_cache.c ****  */
  17:Core/Src/tile_graph_cache.c **** #define EXT_RAM_BSS __attribute__((section(".sdram")))
  18:Core/Src/tile_graph_cache.c **** 
  19:Core/Src/tile_graph_cache.c **** static union {
  20:Core/Src/tile_graph_cache.c ****     struct {
  21:Core/Src/tile_graph_cache.c ****         NodeRecord nodes[TILE_GRAPH_CACHE_MAX_LOCAL][TILE_MAX_LOCAL_NODES];
  22:Core/Src/tile_graph_cache.c ****         EdgeRecord edges[TILE_GRAPH_CACHE_MAX_LOCAL][TILE_MAX_LOCAL_EDGES];
  23:Core/Src/tile_graph_cache.c ****     } local;
  24:Core/Src/tile_graph_cache.c ****     struct {
  25:Core/Src/tile_graph_cache.c ****         NodeRecord nodes[TILE_MAX_BACKBONE_NODES];
  26:Core/Src/tile_graph_cache.c ****         EdgeRecord edges[TILE_MAX_BACKBONE_EDGES];
  27:Core/Src/tile_graph_cache.c ****     } bb;
  28:Core/Src/tile_graph_cache.c **** } s_graph_pool EXT_RAM_BSS;
