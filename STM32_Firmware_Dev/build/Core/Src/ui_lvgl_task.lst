  31:Core/Src/ui_lvgl_task.c ****  * 1. Non-Blocking Tile Cache Lookup (Queues Async Request on Miss)
  32:Core/Src/ui_lvgl_task.c ****  *----------------------------------------------------------------------------*/
  33:Core/Src/ui_lvgl_task.c **** static const TileCacheSlot *Request_Or_Get_Tile_Async(int32_t tx, int32_t ty)
  34:Core/Src/ui_lvgl_task.c **** {
  35:Core/Src/ui_lvgl_task.c ****   if (!g_pak_ready)
  36:Core/Src/ui_lvgl_task.c ****   {
  37:Core/Src/ui_lvgl_task.c ****     return NULL;
  38:Core/Src/ui_lvgl_task.c ****   }
  39:Core/Src/ui_lvgl_task.c **** 
  40:Core/Src/ui_lvgl_task.c ****   g_cache_clock++;
  41:Core/Src/ui_lvgl_task.c **** 
  42:Core/Src/ui_lvgl_task.c ****   /* 1. Check if tile (tx, ty) is already in the cache (READY or LOADING) */
  43:Core/Src/ui_lvgl_task.c ****   for (int i = 0; i < TILE_CACHE_SLOTS; i++)
  44:Core/Src/ui_lvgl_task.c ****   {
  45:Core/Src/ui_lvgl_task.c ****     if (g_tile_cache[i].state != TILE_SLOT_EMPTY &&
  46:Core/Src/ui_lvgl_task.c ****         g_tile_cache[i].tx == tx &&
  47:Core/Src/ui_lvgl_task.c ****         g_tile_cache[i].ty == ty)
  48:Core/Src/ui_lvgl_task.c ****     {
  49:Core/Src/ui_lvgl_task.c ****       g_tile_cache[i].lru_tick = g_cache_clock;
  50:Core/Src/ui_lvgl_task.c ****       return &g_tile_cache[i];
  51:Core/Src/ui_lvgl_task.c ****     }
  52:Core/Src/ui_lvgl_task.c ****   }
  53:Core/Src/ui_lvgl_task.c **** 
  54:Core/Src/ui_lvgl_task.c ****   /* 2. Cache miss: pick an EMPTY slot or the oldest READY slot (never evict LOADING) */
  55:Core/Src/ui_lvgl_task.c ****   int victim = -1;
  56:Core/Src/ui_lvgl_task.c ****   uint32_t min_tick = 0xFFFFFFFFUL;
  57:Core/Src/ui_lvgl_task.c **** 
  58:Core/Src/ui_lvgl_task.c ****   for (int i = 0; i < TILE_CACHE_SLOTS; i++)
  59:Core/Src/ui_lvgl_task.c ****   {
  60:Core/Src/ui_lvgl_task.c ****     if (g_tile_cache[i].state == TILE_SLOT_EMPTY)
  61:Core/Src/ui_lvgl_task.c ****     {
  62:Core/Src/ui_lvgl_task.c ****       victim = i;
  63:Core/Src/ui_lvgl_task.c ****       break;
  64:Core/Src/ui_lvgl_task.c ****     }
  65:Core/Src/ui_lvgl_task.c ****     if (g_tile_cache[i].state == TILE_SLOT_READY && g_tile_cache[i].lru_tick < min_tick)
  66:Core/Src/ui_lvgl_task.c ****     {
  67:Core/Src/ui_lvgl_task.c ****       min_tick = g_tile_cache[i].lru_tick;
  68:Core/Src/ui_lvgl_task.c ****       victim   = i;
  69:Core/Src/ui_lvgl_task.c ****     }
  70:Core/Src/ui_lvgl_task.c ****   }
  71:Core/Src/ui_lvgl_task.c **** 
  72:Core/Src/ui_lvgl_task.c ****   if (victim < 0)
  73:Core/Src/ui_lvgl_task.c ****   {
  74:Core/Src/ui_lvgl_task.c ****     return NULL; /* All 9 slots are currently in-flight */
  75:Core/Src/ui_lvgl_task.c ****   }
  76:Core/Src/ui_lvgl_task.c **** 
  77:Core/Src/ui_lvgl_task.c ****   /* 3. Reserve slot as LOADING and enqueue async read request for Tile_Loader_Task */
  78:Core/Src/ui_lvgl_task.c ****   TileCacheSlot *slot = &g_tile_cache[victim];
  79:Core/Src/ui_lvgl_task.c ****   slot->tx       = tx;
  80:Core/Src/ui_lvgl_task.c ****   slot->ty       = ty;
  81:Core/Src/ui_lvgl_task.c ****   slot->lru_tick = g_cache_clock;
  82:Core/Src/ui_lvgl_task.c ****   slot->has_data = false;
  83:Core/Src/ui_lvgl_task.c ****   slot->state    = TILE_SLOT_LOADING;
  84:Core/Src/ui_lvgl_task.c **** 
  85:Core/Src/ui_lvgl_task.c ****   TileRequest_t req = {
  86:Core/Src/ui_lvgl_task.c ****     .slot_idx = (uint8_t)victim,
  87:Core/Src/ui_lvgl_task.c ****     .tx       = tx,
ARM GAS  /tmp/ccuGYnyw.s 			page 3


  88:Core/Src/ui_lvgl_task.c ****     .ty       = ty,
  89:Core/Src/ui_lvgl_task.c ****   };
  90:Core/Src/ui_lvgl_task.c **** 
  91:Core/Src/ui_lvgl_task.c ****   if (xQueueSend(g_q_tile_req, &req, 0) != pdPASS)
  92:Core/Src/ui_lvgl_task.c ****   {
  93:Core/Src/ui_lvgl_task.c ****     slot->state = TILE_SLOT_EMPTY;
  94:Core/Src/ui_lvgl_task.c ****     return NULL;
  95:Core/Src/ui_lvgl_task.c ****   }
  96:Core/Src/ui_lvgl_task.c **** 
  97:Core/Src/ui_lvgl_task.c ****   return slot;
  98:Core/Src/ui_lvgl_task.c **** }
  99:Core/Src/ui_lvgl_task.c **** 
