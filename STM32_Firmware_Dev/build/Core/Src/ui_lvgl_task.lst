 166:Core/Src/ui_lvgl_task.c **** 
 167:Core/Src/ui_lvgl_task.c **** static void Draw_Route_On_MapFB(void)
 168:Core/Src/ui_lvgl_task.c **** {
 169:Core/Src/ui_lvgl_task.c ****   if (!g_current_route.found || g_current_route.geom_point_count < 2)
 170:Core/Src/ui_lvgl_task.c ****   {
 171:Core/Src/ui_lvgl_task.c ****     return;
 172:Core/Src/ui_lvgl_task.c ****   }
 173:Core/Src/ui_lvgl_task.c **** 
 174:Core/Src/ui_lvgl_task.c ****   /* Bright cyan (0x07FF) for Car, bright green (0x07E0) for Hiking/Stroller */
 175:Core/Src/ui_lvgl_task.c ****   const uint16_t route_col = (g_current_route.routing_profile == (int)PROFILE_STROLLER)
 176:Core/Src/ui_lvgl_task.c ****                              ? 0x07E0U : 0x07FFU;
 177:Core/Src/ui_lvgl_task.c **** 
 178:Core/Src/ui_lvgl_task.c ****   int32_t prev_sx = 0, prev_sy = 0;
 179:Core/Src/ui_lvgl_task.c ****   GeoCoord p0 = geo_coord_make(g_current_route.geom_points[0].lat_scaled,
 180:Core/Src/ui_lvgl_task.c ****                                g_current_route.geom_points[0].lon_scaled);
 181:Core/Src/ui_lvgl_task.c ****   map_camera_latlon_to_screen(&g_camera, p0, &prev_sx, &prev_sy);
 182:Core/Src/ui_lvgl_task.c **** 
 183:Core/Src/ui_lvgl_task.c ****   for (int32_t i = 1; i < g_current_route.geom_point_count; i++)
 184:Core/Src/ui_lvgl_task.c ****   {
 185:Core/Src/ui_lvgl_task.c ****     int32_t cur_sx = 0, cur_sy = 0;
 186:Core/Src/ui_lvgl_task.c ****     GeoCoord pt = geo_coord_make(g_current_route.geom_points[i].lat_scaled,
 187:Core/Src/ui_lvgl_task.c ****                                  g_current_route.geom_points[i].lon_scaled);
 188:Core/Src/ui_lvgl_task.c ****     map_camera_latlon_to_screen(&g_camera, pt, &cur_sx, &cur_sy);
 189:Core/Src/ui_lvgl_task.c ****     Draw_Thick_Line_Clipped(prev_sx, prev_sy, cur_sx, cur_sy, route_col);
 190:Core/Src/ui_lvgl_task.c ****     prev_sx = cur_sx;
 191:Core/Src/ui_lvgl_task.c ****     prev_sy = cur_sy;
 192:Core/Src/ui_lvgl_task.c ****   }
 193:Core/Src/ui_lvgl_task.c **** 
 194:Core/Src/ui_lvgl_task.c ****   /* Draw Start (Green) and Goal (Magenta) pins */
 195:Core/Src/ui_lvgl_task.c ****   int32_t start_sx = 0, start_sy = 0;
 196:Core/Src/ui_lvgl_task.c ****   map_camera_latlon_to_screen(&g_camera, p0, &start_sx, &start_sy);
 197:Core/Src/ui_lvgl_task.c ****   Draw_Pin_Marker(start_sx, start_sy, 0x07E0U);
 198:Core/Src/ui_lvgl_task.c ****   Draw_Pin_Marker(prev_sx, prev_sy, 0xF81FU);
 199:Core/Src/ui_lvgl_task.c **** }
