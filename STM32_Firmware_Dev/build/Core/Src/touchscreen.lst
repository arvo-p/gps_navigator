 135:Core/Src/touchscreen.c ****               BSP_LCD_SetTextColor(LCD_COLOR_GREEN); 
 136:Core/Src/touchscreen.c ****               BSP_LCD_FillCircle(CIRCLE_XPOS(4), CIRCLE_YPOS(3), CIRCLE_RADIUS);
 137:Core/Src/touchscreen.c ****               state |= 8;
