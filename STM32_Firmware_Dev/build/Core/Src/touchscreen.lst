 158:Core/Src/touchscreen.c **** /**
 159:Core/Src/touchscreen.c ****   * @brief  Display TS Demo Hint
 160:Core/Src/touchscreen.c ****   * @param  None
 161:Core/Src/touchscreen.c ****   * @retval None
 162:Core/Src/touchscreen.c ****   */
 163:Core/Src/touchscreen.c **** static void Touchscreen_SetHint(void)
 164:Core/Src/touchscreen.c **** {
 165:Core/Src/touchscreen.c ****   /* Clear the LCD */ 
 166:Core/Src/touchscreen.c ****   BSP_LCD_Clear(LCD_COLOR_WHITE);
 167:Core/Src/touchscreen.c ****   
 168:Core/Src/touchscreen.c ****   /* Set Touchscreen Demo description */
 169:Core/Src/touchscreen.c ****   BSP_LCD_SetTextColor(LCD_COLOR_BLUE);
 170:Core/Src/touchscreen.c ****   BSP_LCD_FillRect(0, 0, BSP_LCD_GetXSize(), 80);
 171:Core/Src/touchscreen.c ****   BSP_LCD_SetTextColor(LCD_COLOR_WHITE);
 172:Core/Src/touchscreen.c ****   BSP_LCD_SetBackColor(LCD_COLOR_BLUE); 
 173:Core/Src/touchscreen.c ****   BSP_LCD_SetFont(&Font24);
 174:Core/Src/touchscreen.c ****   BSP_LCD_DisplayStringAt(0, 0, (uint8_t*)"Touchscreen", CENTER_MODE);
 175:Core/Src/touchscreen.c ****   BSP_LCD_SetFont(&Font12);
 176:Core/Src/touchscreen.c ****   BSP_LCD_DisplayStringAt(0, 30, (uint8_t*)"Please use the Touchscreen to", CENTER_MODE);
 177:Core/Src/touchscreen.c ****   BSP_LCD_DisplayStringAt(0, 45, (uint8_t*)"activate the colored circle", CENTER_MODE);
 178:Core/Src/touchscreen.c ****   BSP_LCD_DisplayStringAt(0, 60, (uint8_t*)"inside the rectangle", CENTER_MODE);
 179:Core/Src/touchscreen.c ****   
 180:Core/Src/touchscreen.c ****   /* Set the LCD Text Color */
 181:Core/Src/touchscreen.c ****   BSP_LCD_SetTextColor(LCD_COLOR_BLUE);  
 182:Core/Src/touchscreen.c ****   BSP_LCD_DrawRect(10, 90, BSP_LCD_GetXSize() - 20, BSP_LCD_GetYSize()- 100);
 183:Core/Src/touchscreen.c ****   BSP_LCD_DrawRect(11, 91, BSP_LCD_GetXSize() - 22, BSP_LCD_GetYSize()- 102); 
 184:Core/Src/touchscreen.c **** }
