  88:Core/Src/touchscreen.c ****         
  89:Core/Src/touchscreen.c ****         if((TS_State.TouchDetected) && 
  90:Core/Src/touchscreen.c ****            (y > (CIRCLE_YPOS(1) - CIRCLE_RADIUS))&&
  91:Core/Src/touchscreen.c ****              (y < (CIRCLE_YPOS(1) + CIRCLE_RADIUS)))
  92:Core/Src/touchscreen.c ****         {
  93:Core/Src/touchscreen.c ****           
  94:Core/Src/touchscreen.c ****           if((x > (CIRCLE_XPOS(1) - CIRCLE_RADIUS))&&
