 149:Core/Src/touchscreen.c ****           }
 150:Core/Src/touchscreen.c ****         }   
 151:Core/Src/touchscreen.c ****       }
 152:Core/Src/touchscreen.c ****     }
 153:Core/Src/touchscreen.c ****     
 154:Core/Src/touchscreen.c ****     HAL_Delay(100);
 155:Core/Src/touchscreen.c ****   }
