  50:Core/Src/touchscreen.c ****   * @retval None
  51:Core/Src/touchscreen.c ****   */
  52:Core/Src/touchscreen.c **** void Touchscreen_demo(void)
  53:Core/Src/touchscreen.c **** { 
  54:Core/Src/touchscreen.c ****   uint8_t status = 0;
  55:Core/Src/touchscreen.c ****   uint16_t x,y;
  56:Core/Src/touchscreen.c ****   uint8_t state = 0;
  57:Core/Src/touchscreen.c ****   
  58:Core/Src/touchscreen.c ****   if(IsCalibrationDone() == 0)
  59:Core/Src/touchscreen.c ****   {
  60:Core/Src/touchscreen.c ****     Touchscreen_Calibration();
  61:Core/Src/touchscreen.c ****   }
  62:Core/Src/touchscreen.c ****   
  63:Core/Src/touchscreen.c ****   Touchscreen_SetHint();
  64:Core/Src/touchscreen.c ****   
  65:Core/Src/touchscreen.c ****   status = BSP_TS_Init(BSP_LCD_GetXSize(), BSP_LCD_GetYSize());
  66:Core/Src/touchscreen.c ****   
  67:Core/Src/touchscreen.c ****   if (status != TS_OK)
  68:Core/Src/touchscreen.c ****   {
  69:Core/Src/touchscreen.c ****     BSP_LCD_SetBackColor(LCD_COLOR_WHITE); 
  70:Core/Src/touchscreen.c ****     BSP_LCD_SetTextColor(LCD_COLOR_RED);
  71:Core/Src/touchscreen.c ****     BSP_LCD_DisplayStringAt(0, BSP_LCD_GetYSize()- 95, (uint8_t*)"ERROR", CENTER_MODE);
  72:Core/Src/touchscreen.c ****     BSP_LCD_DisplayStringAt(0, BSP_LCD_GetYSize()- 80, (uint8_t*)"Touchscreen cannot be initialized
  73:Core/Src/touchscreen.c ****   }
  74:Core/Src/touchscreen.c ****   else
  75:Core/Src/touchscreen.c ****   {
  76:Core/Src/touchscreen.c ****     Touchscreen_DrawBackground(state);
  77:Core/Src/touchscreen.c ****   }
  78:Core/Src/touchscreen.c ****   
  79:Core/Src/touchscreen.c ****   while (1)
  80:Core/Src/touchscreen.c ****   {
  81:Core/Src/touchscreen.c ****     if (status == TS_OK)
  82:Core/Src/touchscreen.c ****     {
  83:Core/Src/touchscreen.c ****       BSP_TS_GetState(&TS_State);
  84:Core/Src/touchscreen.c ****       
  85:Core/Src/touchscreen.c ****       if (TS_State.TouchDetected) {
  86:Core/Src/touchscreen.c ****         x = Calibration_GetX(TS_State.X);
  87:Core/Src/touchscreen.c ****         y = Calibration_GetY(TS_State.Y);
