  46:Core/Src/ts_calibration.c **** /**
  47:Core/Src/ts_calibration.c ****   * @brief  Performs the TS calibration
  48:Core/Src/ts_calibration.c ****   * @param  None
  49:Core/Src/ts_calibration.c ****   * @retval None
  50:Core/Src/ts_calibration.c ****   */
  51:Core/Src/ts_calibration.c **** void Touchscreen_Calibration(void)
  52:Core/Src/ts_calibration.c **** { 
  53:Core/Src/ts_calibration.c ****   uint8_t status = 0;
  54:Core/Src/ts_calibration.c ****   uint8_t i = 0;
  55:Core/Src/ts_calibration.c ****   
  56:Core/Src/ts_calibration.c ****   TouchscreenCalibration_SetHint();
  57:Core/Src/ts_calibration.c ****   
  58:Core/Src/ts_calibration.c ****   status = BSP_TS_Init(BSP_LCD_GetXSize(), BSP_LCD_GetYSize());
  59:Core/Src/ts_calibration.c ****   
  60:Core/Src/ts_calibration.c ****   if (status != TS_OK)
  61:Core/Src/ts_calibration.c ****   {
  62:Core/Src/ts_calibration.c ****     BSP_LCD_SetBackColor(LCD_COLOR_WHITE); 
  63:Core/Src/ts_calibration.c ****     BSP_LCD_SetTextColor(LCD_COLOR_RED);
  64:Core/Src/ts_calibration.c ****     BSP_LCD_DisplayStringAt(0, BSP_LCD_GetYSize()- 95, (uint8_t*)"ERROR", CENTER_MODE);
  65:Core/Src/ts_calibration.c ****     BSP_LCD_DisplayStringAt(0, BSP_LCD_GetYSize()- 80, (uint8_t*)"Touchscreen cannot be initialized
  66:Core/Src/ts_calibration.c ****   }
ARM GAS  /tmp/ccvUaxw5.s 			page 3


  67:Core/Src/ts_calibration.c ****   
  68:Core/Src/ts_calibration.c ****   while (1)
  69:Core/Src/ts_calibration.c ****   {
  70:Core/Src/ts_calibration.c ****     if (status == TS_OK)
  71:Core/Src/ts_calibration.c ****     {
  72:Core/Src/ts_calibration.c ****       aLogX[0] = 15;
  73:Core/Src/ts_calibration.c ****       aLogY[0] = 15;
  74:Core/Src/ts_calibration.c ****       aLogX[1] = BSP_LCD_GetXSize() - 15;
  75:Core/Src/ts_calibration.c ****       aLogY[1] = BSP_LCD_GetYSize() - 15;
  76:Core/Src/ts_calibration.c ****       
  77:Core/Src/ts_calibration.c ****       for (i = 0; i < 2; i++) 
  78:Core/Src/ts_calibration.c ****       {
  79:Core/Src/ts_calibration.c ****         GetPhysValues(aLogX[i], aLogY[i], &aPhysX[i], &aPhysY[i]);
  80:Core/Src/ts_calibration.c ****       }
  81:Core/Src/ts_calibration.c ****       A1 = (1000 * ( aLogX[1] - aLogX[0]))/ ( aPhysX[1] - aPhysX[0]); 
  82:Core/Src/ts_calibration.c ****       B1 = (1000 * aLogX[0]) - A1 * aPhysX[0]; 
  83:Core/Src/ts_calibration.c ****       
  84:Core/Src/ts_calibration.c ****       A2 = (1000 * ( aLogY[1] - aLogY[0]))/ ( aPhysY[1] - aPhysY[0]); 
  85:Core/Src/ts_calibration.c ****       B2 = (1000 * aLogY[0]) - A2 * aPhysY[0]; 
  86:Core/Src/ts_calibration.c ****       
  87:Core/Src/ts_calibration.c ****       Calibration_Done = 1;
  88:Core/Src/ts_calibration.c ****       return;
  89:Core/Src/ts_calibration.c ****     }
  90:Core/Src/ts_calibration.c ****     
  91:Core/Src/ts_calibration.c ****     HAL_Delay(5);
  92:Core/Src/ts_calibration.c ****   }
  93:Core/Src/ts_calibration.c **** }
