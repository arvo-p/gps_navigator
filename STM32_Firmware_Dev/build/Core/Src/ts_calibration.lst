 123:Core/Src/ts_calibration.c **** static void GetPhysValues(int16_t LogX, int16_t LogY, int16_t * pPhysX, int16_t * pPhysY) 
 124:Core/Src/ts_calibration.c **** {
 125:Core/Src/ts_calibration.c ****   /* Draw the ring */
 126:Core/Src/ts_calibration.c ****   BSP_LCD_SetTextColor(LCD_COLOR_BLACK);
 127:Core/Src/ts_calibration.c ****   BSP_LCD_FillCircle(LogX, LogY, 5);
 128:Core/Src/ts_calibration.c ****   BSP_LCD_SetTextColor(LCD_COLOR_WHITE);
 129:Core/Src/ts_calibration.c ****   BSP_LCD_FillCircle(LogX, LogY, 2);
 130:Core/Src/ts_calibration.c ****   
 131:Core/Src/ts_calibration.c ****   /* Wait until touch is pressed */
 132:Core/Src/ts_calibration.c ****   WaitForPressedState(1);
 133:Core/Src/ts_calibration.c ****   
 134:Core/Src/ts_calibration.c ****   BSP_TS_GetState(&TS_State);
 135:Core/Src/ts_calibration.c ****   *pPhysX = TS_State.X;
 136:Core/Src/ts_calibration.c ****   *pPhysY = TS_State.Y; 
 137:Core/Src/ts_calibration.c ****   
 138:Core/Src/ts_calibration.c ****   /* Wait until touch is released */
 139:Core/Src/ts_calibration.c ****   WaitForPressedState(0);
 140:Core/Src/ts_calibration.c ****   BSP_LCD_SetTextColor(LCD_COLOR_WHITE);
 141:Core/Src/ts_calibration.c ****   BSP_LCD_FillCircle(LogX, LogY, 5);
 142:Core/Src/ts_calibration.c **** }
