 168:Core/Src/gps_uart_task.c **** 
 169:Core/Src/gps_uart_task.c **** /**
 170:Core/Src/gps_uart_task.c ****   * @brief  Put ATGM336H-5N into low-power standby/sleep mode ($PCAS12).
 171:Core/Src/gps_uart_task.c ****   * @param  standby_sec: Standby duration in seconds (1..65535).
 172:Core/Src/gps_uart_task.c ****   *                      Pass 0 to use maximum duration (65535 s).
 173:Core/Src/gps_uart_task.c ****   */
 174:Core/Src/gps_uart_task.c **** void GPS_ATGM336H_EnterSleep(uint16_t standby_sec)
 175:Core/Src/gps_uart_task.c **** {
ARM GAS  /tmp/cc6rMduK.s 			page 8


 176:Core/Src/gps_uart_task.c ****   uint16_t sec = (standby_sec == 0U) ? 65535U : standby_sec;
 177:Core/Src/gps_uart_task.c ****   char cmd[24];
 178:Core/Src/gps_uart_task.c ****   (void)snprintf(cmd, sizeof(cmd), "PCAS12,%u", (unsigned)sec);
 179:Core/Src/gps_uart_task.c ****   GPS_SendCasicCmd(cmd);
 180:Core/Src/gps_uart_task.c **** }
 181:Core/Src/gps_uart_task.c **** 
 182:Core/Src/gps_uart_task.c **** /**
 183:Core/Src/gps_uart_task.c ****   * @brief  Wake ATGM336H-5N from standby/sleep mode ($PCAS10,0 hot start)
 184:Core/Src/gps_uart_task.c ****   *         and restore GPS + GLONASS constellation mode ($PCAS04,5).
 185:Core/Src/gps_uart_task.c ****   */
 186:Core/Src/gps_uart_task.c **** void GPS_ATGM336H_Wakeup(void)
 187:Core/Src/gps_uart_task.c **** {
 188:Core/Src/gps_uart_task.c ****   const uint8_t wake_pulse = 0xFFU;
 189:Core/Src/gps_uart_task.c ****   GPS_UART_SendBytes(&wake_pulse, 1U);
 190:Core/Src/gps_uart_task.c ****   vTaskDelay(pdMS_TO_TICKS(20));
 191:Core/Src/gps_uart_task.c **** 
 192:Core/Src/gps_uart_task.c ****   /* Hot start ($PCAS10,0*1C) and re-select GPS + GLONASS ($PCAS04,5*1C) */
 193:Core/Src/gps_uart_task.c ****   GPS_SendCasicCmd("PCAS10,0");
 194:Core/Src/gps_uart_task.c ****   vTaskDelay(pdMS_TO_TICKS(50));
 195:Core/Src/gps_uart_task.c ****   GPS_ATGM336H_SetConstellation(ATGM336H_MODE_GPS_GLONASS);
 196:Core/Src/gps_uart_task.c **** }
