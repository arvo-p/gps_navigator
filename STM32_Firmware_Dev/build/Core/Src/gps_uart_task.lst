   1:Core/Src/gps_uart_task.c **** /**
   2:Core/Src/gps_uart_task.c ****   ******************************************************************************
   3:Core/Src/gps_uart_task.c ****   * @file    Core/Src/gps_uart_task.c
   4:Core/Src/gps_uart_task.c ****   * @brief   TASK 2: GPS_UART_Task (Priority: AboveNormal)
   5:Core/Src/gps_uart_task.c ****   *          Receives UART NMEA frames via GPS_UART_INSTANCE (configured in main.h)
   6:Core/Src/gps_uart_task.c ****   *          using GPS_DMA_RX_STREAM circular buffer + IDLE IRQ, sends ATGM336H-5N
   7:Core/Src/gps_uart_task.c ****   *          CASIC commands, parses UTC time & WGS84 coordinates, and publishes
   8:Core/Src/gps_uart_task.c ****   *          the latest GpsFix_t to UI_LVGL_Task.
   9:Core/Src/gps_uart_task.c ****   ******************************************************************************
  10:Core/Src/gps_uart_task.c ****   */
