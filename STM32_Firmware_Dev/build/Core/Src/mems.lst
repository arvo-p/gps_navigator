  42:Core/Src/mems.c **** #define CIRCLE_LEFT_Y_POS (310-110)
  43:Core/Src/mems.c **** 
  44:Core/Src/mems.c **** #define CIRCLE_RIGHT_X_POS (4*(BSP_LCD_GetXSize()/5))
  45:Core/Src/mems.c **** #define CIRCLE_RIGHT_Y_POS CIRCLE_LEFT_Y_POS
  46:Core/Src/mems.c **** 
  47:Core/Src/mems.c **** #define CIRCLE_CENTRAL_X_POS CIRCLE_UP_X_POS
  48:Core/Src/mems.c **** #define CIRCLE_CENTRAL_Y_POS CIRCLE_LEFT_Y_POS
  49:Core/Src/mems.c **** 
