  64:Core/Src/mems.c **** /**
  65:Core/Src/mems.c ****   * @brief  MEMS demo
  66:Core/Src/mems.c ****   * @param  None
  67:Core/Src/mems.c ****   * @retval None
  68:Core/Src/mems.c ****   */
  69:Core/Src/mems.c **** void MEMS_demo(void)
  70:Core/Src/mems.c **** {
  71:Core/Src/mems.c ****   MEMS_SetHint();
  72:Core/Src/mems.c ****   
  73:Core/Src/mems.c ****   if (BSP_GYRO_Init() != GYRO_OK)
  74:Core/Src/mems.c ****   {
  75:Core/Src/mems.c ****     BSP_LCD_SetBackColor(LCD_COLOR_WHITE); 
  76:Core/Src/mems.c ****     BSP_LCD_SetTextColor(LCD_COLOR_RED);
  77:Core/Src/mems.c ****     BSP_LCD_DisplayStringAt(0, BSP_LCD_GetYSize()- 95, (uint8_t*)"ERROR", CENTER_MODE);
  78:Core/Src/mems.c ****     BSP_LCD_DisplayStringAt(0, BSP_LCD_GetYSize()- 80, (uint8_t*)"MEMS cannot be initialized", CENT
  79:Core/Src/mems.c ****   }
  80:Core/Src/mems.c ****   else
  81:Core/Src/mems.c ****   {
  82:Core/Src/mems.c ****     Gyroscope_DrawBackground(state);
  83:Core/Src/mems.c ****   }
  84:Core/Src/mems.c ****   
  85:Core/Src/mems.c ****   BSP_GYRO_Reset();
  86:Core/Src/mems.c ****   
  87:Core/Src/mems.c ****   while (1)
  88:Core/Src/mems.c ****   {	
  89:Core/Src/mems.c ****     /* Read Gyro Angular data */
  90:Core/Src/mems.c ****     BSP_GYRO_GetXYZ(Buffer);
  91:Core/Src/mems.c ****     
  92:Core/Src/mems.c ****     /* Update autoreload and capture compare registers value */
  93:Core/Src/mems.c ****     Xval = ABS((Buffer[0]));
  94:Core/Src/mems.c ****     Yval = ABS((Buffer[1])); 
  95:Core/Src/mems.c ****     Zval = ABS((Buffer[2])); 
  96:Core/Src/mems.c ****     
  97:Core/Src/mems.c ****     if((Xval>Yval) && (Xval>Zval))
  98:Core/Src/mems.c ****     {
  99:Core/Src/mems.c ****       if(Buffer[0] > 10000.0f)
 100:Core/Src/mems.c ****       { 
 101:Core/Src/mems.c ****         if((state & 1) == 0)
 102:Core/Src/mems.c ****         {
 103:Core/Src/mems.c ****           Gyroscope_DrawBackground(1);			
 104:Core/Src/mems.c ****           state |= 1;
 105:Core/Src/mems.c ****           HAL_Delay(1000);
 106:Core/Src/mems.c ****         }        
 107:Core/Src/mems.c ****       }
 108:Core/Src/mems.c ****       else if(Buffer[0] < -10000.0f)
 109:Core/Src/mems.c ****       { 
 110:Core/Src/mems.c ****         if((state & 2) == 0)
 111:Core/Src/mems.c ****         {          
 112:Core/Src/mems.c ****           Gyroscope_DrawBackground(2);            
 113:Core/Src/mems.c ****           state |= 2;
 114:Core/Src/mems.c ****           HAL_Delay(1000);
 115:Core/Src/mems.c ****         }           
 116:Core/Src/mems.c ****       }      
 117:Core/Src/mems.c ****     }
 118:Core/Src/mems.c ****     else if ((Yval>Xval) && (Yval>Zval))
 119:Core/Src/mems.c ****     {
 120:Core/Src/mems.c ****       if(Buffer[1] < -10000.0f)
ARM GAS  /tmp/cc6bkUl0.s 			page 4


 121:Core/Src/mems.c ****       {
 122:Core/Src/mems.c ****         if((state & 4) == 0)
 123:Core/Src/mems.c ****         {                     
 124:Core/Src/mems.c ****           Gyroscope_DrawBackground(4);            
 125:Core/Src/mems.c ****           state |= 4;
 126:Core/Src/mems.c ****           HAL_Delay(1000);
 127:Core/Src/mems.c ****         }   
 128:Core/Src/mems.c ****       }
 129:Core/Src/mems.c ****       else if(Buffer[1] > 10000.0f)
 130:Core/Src/mems.c ****       {
 131:Core/Src/mems.c ****         if((state & 8) == 0)
 132:Core/Src/mems.c ****         {          
 133:Core/Src/mems.c ****           Gyroscope_DrawBackground(8);            
 134:Core/Src/mems.c ****           state |= 8;
 135:Core/Src/mems.c ****           HAL_Delay(1000);
 136:Core/Src/mems.c ****         }
 137:Core/Src/mems.c ****       }     
 138:Core/Src/mems.c ****     } 
 139:Core/Src/mems.c ****     else if ((Zval>Xval) && (Zval>Yval))
 140:Core/Src/mems.c ****     {
 141:Core/Src/mems.c ****       if(Buffer[2] < -10000.0f)
 142:Core/Src/mems.c ****       {
 143:Core/Src/mems.c ****         if((state & 16) == 0)
 144:Core/Src/mems.c ****         {                     
 145:Core/Src/mems.c ****           Gyroscope_DrawBackground(16);            
 146:Core/Src/mems.c ****           state |= 16;
 147:Core/Src/mems.c ****           HAL_Delay(1000);
 148:Core/Src/mems.c ****         }   
 149:Core/Src/mems.c ****       }		 
 150:Core/Src/mems.c ****       else if(Buffer[2] > 10000.0f)
 151:Core/Src/mems.c ****       {
 152:Core/Src/mems.c ****         if((state & 32) == 0)
 153:Core/Src/mems.c ****         {          
 154:Core/Src/mems.c ****           Gyroscope_DrawBackground(32);            
 155:Core/Src/mems.c ****           state |= 32;
 156:Core/Src/mems.c ****           HAL_Delay(1000);			
 157:Core/Src/mems.c ****         }
 158:Core/Src/mems.c ****       }  	
 159:Core/Src/mems.c ****     } 
 160:Core/Src/mems.c ****     if (state != 0x3F)	
 161:Core/Src/mems.c ****     {
 162:Core/Src/mems.c ****     }
 163:Core/Src/mems.c ****     else if (CheckForUserInput() > 0)
 164:Core/Src/mems.c ****     { 
 165:Core/Src/mems.c ****       state = 0;    
 166:Core/Src/mems.c ****       return;
 167:Core/Src/mems.c ****     }
 168:Core/Src/mems.c ****   }
 169:Core/Src/mems.c **** }
