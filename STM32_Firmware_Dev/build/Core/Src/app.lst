  28:Core/Src/app.c **** QueueHandle_t     g_q_tile_req    = NULL;
  29:Core/Src/app.c **** QueueHandle_t     g_q_route_req   = NULL;
  30:Core/Src/app.c **** SemaphoreHandle_t g_mutex_sd      = NULL;
  31:Core/Src/app.c **** TaskHandle_t      g_ui_task_hdl   = NULL;
