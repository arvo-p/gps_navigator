  52:Core/Src/app.c **** /*----------------------------------------------------------------------------
  53:Core/Src/app.c ****  * 1. Display Flush Callback (DMA2D RGB565 -> ARGB8888 in SDRAM)
  54:Core/Src/app.c ****  *----------------------------------------------------------------------------*/
  55:Core/Src/app.c **** static void my_disp_flush_cb(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map)
  56:Core/Src/app.c **** {
  57:Core/Src/app.c ****   int32_t width  = lv_area_get_width(area);
  58:Core/Src/app.c ****   int32_t height = lv_area_get_height(area);
  59:Core/Src/app.c **** 
  60:Core/Src/app.c ****   uint32_t dst_addr = DISP_FRAME_BUFFER_ADDR + 4U * (area->y1 * MY_DISP_HOR_RES + area->x1);
  61:Core/Src/app.c **** 
  62:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->CR      = 0x00010000UL; /* Memory-to-Memory with PFC */
  63:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->FGMAR   = (uint32_t)px_map;
  64:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->OMAR    = dst_addr;
  65:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->FGOR    = 0;
  66:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->OOR     = MY_DISP_HOR_RES - width;
  67:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->FGPFCCR = LTDC_PIXEL_FORMAT_RGB565;
  68:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->OPFCCR  = LTDC_PIXEL_FORMAT_ARGB8888;
  69:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->NLR     = (uint32_t)((width << 16) | (uint16_t)height);
  70:Core/Src/app.c ****   DISP_DMA2D_INSTANCE->CR     |= DMA2D_CR_START;
  71:Core/Src/app.c **** 
  72:Core/Src/app.c ****   while (DISP_DMA2D_INSTANCE->CR & DMA2D_CR_START) {}
  73:Core/Src/app.c **** 
  74:Core/Src/app.c ****   lv_display_flush_ready(disp);
  75:Core/Src/app.c **** }
  76:Core/Src/app.c **** 
