   2:Core/Src/app.c ****   ******************************************************************************
   3:Core/Src/app.c ****   * @file    Core/Src/app.c
   4:Core/Src/app.c ****   * @brief   FreeRTOS 5-Task GPS Map & Navigation Application Orchestrator:
   5:Core/Src/app.c ****   *            1. Sensor_Input_Task (Core/Src/sensor_input_task.c, Prio 3)
   6:Core/Src/app.c ****   *            2. GPS_UART_Task     (Core/Src/gps_uart_task.c,     Prio 3)
   7:Core/Src/app.c ****   *            3. UI_LVGL_Task      (Core/Src/ui_lvgl_task.c,      Prio 2)
   8:Core/Src/app.c ****   *            4. Tile_Loader_Task  (Core/Src/tile_loader_task.c,  Prio 1)
   9:Core/Src/app.c ****   *            5. Pathfinder_Task   (Core/Src/pathfinder_task.c,   Prio 0)
