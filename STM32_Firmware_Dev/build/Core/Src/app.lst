   7:Core/Src/app.c ****   *            3. UI_LVGL_Task      (Core/Src/ui_lvgl_task.c,      Prio 2)
   8:Core/Src/app.c ****   *            4. Tile_Loader_Task  (Core/Src/tile_loader_task.c,  Prio 1)
   9:Core/Src/app.c ****   *            5. Pathfinder_Task   (Core/Src/pathfinder_task.c,   Prio 0)
  10:Core/Src/app.c ****   ******************************************************************************
  11:Core/Src/app.c ****   */
  12:Core/Src/app.c **** 
