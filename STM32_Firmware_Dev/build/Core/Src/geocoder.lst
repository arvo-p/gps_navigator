 282:Core/Src/geocoder.c **** bool geocoder_init(Geocoder *geo, TileGraphCache *cache, const char *base_dir) {
 283:Core/Src/geocoder.c ****     if (!geo) return false;
 284:Core/Src/geocoder.c ****     memset(geo, 0, sizeof(Geocoder));
 285:Core/Src/geocoder.c ****     geo->graph_cache = cache;
 286:Core/Src/geocoder.c **** 
 287:Core/Src/geocoder.c ****     const char *dir = (base_dir && base_dir[0] != '\0') ? base_dir : "binaries";
 288:Core/Src/geocoder.c **** 
 289:Core/Src/geocoder.c ****     snprintf(geo->names_idx_path, sizeof(geo->names_idx_path), "%s/names.idx", dir);
 290:Core/Src/geocoder.c ****     snprintf(geo->names_str_path, sizeof(geo->names_str_path), "%s/names.str", dir);
 291:Core/Src/geocoder.c ****     snprintf(geo->towns_idx_path, sizeof(geo->towns_idx_path), "%s/towns.idx", dir);
 292:Core/Src/geocoder.c ****     snprintf(geo->towns_str_path, sizeof(geo->towns_str_path), "%s/towns.str", dir);
 293:Core/Src/geocoder.c **** 
 294:Core/Src/geocoder.c ****     /* Attempt to read counts now if SD is already mounted; otherwise deferred to first query */
 295:Core/Src/geocoder.c ****     (void)geocoder_ensure_counts(geo);
 296:Core/Src/geocoder.c ****     return true;
 297:Core/Src/geocoder.c **** }
 298:Core/Src/geocoder.c **** 
 299:Core/Src/geocoder.c **** bool geocoder_get_street_name(const Geocoder *geo, uint32_t street_id, char *out_name, size_t out_s
 300:Core/Src/geocoder.c ****     if (!geo || !out_name || out_size == 0) return false;
 301:Core/Src/geocoder.c ****     out_name[0] = '\0';
 302:Core/Src/geocoder.c **** 
 303:Core/Src/geocoder.c ****     if (!geocoder_ensure_counts((Geocoder *)geo)) return false;
 304:Core/Src/geocoder.c **** 
 305:Core/Src/geocoder.c ****     if (street_id == 0 || street_id > geo->street_count) {
 306:Core/Src/geocoder.c ****         return false;
 307:Core/Src/geocoder.c ****     }
 308:Core/Src/geocoder.c **** 
 309:Core/Src/geocoder.c ****     if (f_open(&s_f_a, geo->names_idx_path, FA_READ) != FR_OK) return false;
 310:Core/Src/geocoder.c **** 
 311:Core/Src/geocoder.c ****     NameIndexRecord rec;
 312:Core/Src/geocoder.c ****     uint32_t idx = street_id - 1U;
 313:Core/Src/geocoder.c ****     UINT br = 0;
 314:Core/Src/geocoder.c ****     if (f_lseek(&s_f_a, (FSIZE_t)idx * sizeof(NameIndexRecord)) != FR_OK ||
 315:Core/Src/geocoder.c ****         f_read(&s_f_a, &rec, sizeof(NameIndexRecord), &br) != FR_OK ||
 316:Core/Src/geocoder.c ****         br != sizeof(NameIndexRecord)) {
 317:Core/Src/geocoder.c ****         f_close(&s_f_a);
 318:Core/Src/geocoder.c ****         return false;
 319:Core/Src/geocoder.c ****     }
 320:Core/Src/geocoder.c ****     f_close(&s_f_a);
 321:Core/Src/geocoder.c **** 
 322:Core/Src/geocoder.c ****     if (f_open(&s_f_b, geo->names_str_path, FA_READ) != FR_OK) return false;
 323:Core/Src/geocoder.c ****     bool ok = read_null_term_string(&s_f_b, rec.str_offset, out_name, out_size);
 324:Core/Src/geocoder.c ****     f_close(&s_f_b);
 325:Core/Src/geocoder.c ****     return ok;
 326:Core/Src/geocoder.c **** }
