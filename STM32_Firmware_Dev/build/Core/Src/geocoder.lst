 386:Core/Src/geocoder.c **** /**
ARM GAS  /tmp/cca3RsFl.s 			page 39


 387:Core/Src/geocoder.c ****  * @brief Find a town by name in towns.idx / towns.str.
 388:Core/Src/geocoder.c ****  *        Prefers exact normalized match, then prefix match, then substring match.
 389:Core/Src/geocoder.c ****  *        If multiple towns match at the same tier, picks the one closest to ref_coord.
 390:Core/Src/geocoder.c ****  */
 391:Core/Src/geocoder.c **** static bool find_town_by_name(const Geocoder *geo, const char *town_query, GeoCoord ref_coord,
 392:Core/Src/geocoder.c ****                               GeoCoord *out_town_coord, char *out_town_name, size_t name_size) {
 393:Core/Src/geocoder.c ****     if (!geo || !town_query) return false;
 394:Core/Src/geocoder.c ****     (void)geocoder_ensure_counts((Geocoder *)geo);
 395:Core/Src/geocoder.c ****     if (geo->town_count == 0) return false;
 396:Core/Src/geocoder.c **** 
 397:Core/Src/geocoder.c ****     char norm_query[GEOCODER_NAME_MAX];
 398:Core/Src/geocoder.c ****     geocoder_normalize_name(town_query, norm_query, sizeof(norm_query));
 399:Core/Src/geocoder.c ****     if (norm_query[0] == '\0') return false;
 400:Core/Src/geocoder.c ****     size_t q_len = strlen(norm_query);
 401:Core/Src/geocoder.c **** 
 402:Core/Src/geocoder.c ****     if (f_open(&s_f_a, geo->towns_idx_path, FA_READ) != FR_OK) return false;
 403:Core/Src/geocoder.c ****     if (f_open(&s_f_b, geo->towns_str_path, FA_READ) != FR_OK) {
 404:Core/Src/geocoder.c ****         f_close(&s_f_a);
 405:Core/Src/geocoder.c ****         return false;
 406:Core/Src/geocoder.c ****     }
 407:Core/Src/geocoder.c **** 
 408:Core/Src/geocoder.c ****     int best_tier = 99; /* 1 = exact, 2 = prefix, 3 = substring */
 409:Core/Src/geocoder.c ****     uint32_t best_dist = 0xFFFFFFFFU;
 410:Core/Src/geocoder.c ****     TownIndexRecord best_rec;
 411:Core/Src/geocoder.c ****     char best_raw[GEOCODER_NAME_MAX] = {0};
 412:Core/Src/geocoder.c **** 
 413:Core/Src/geocoder.c ****     for (uint32_t i = 0; i < geo->town_count; ++i) {
 414:Core/Src/geocoder.c ****         TownIndexRecord rec;
 415:Core/Src/geocoder.c ****         UINT br = 0;
 416:Core/Src/geocoder.c ****         if (f_read(&s_f_a, &rec, sizeof(TownIndexRecord), &br) != FR_OK ||
 417:Core/Src/geocoder.c ****             br != sizeof(TownIndexRecord)) {
 418:Core/Src/geocoder.c ****             break;
 419:Core/Src/geocoder.c ****         }
 420:Core/Src/geocoder.c **** 
 421:Core/Src/geocoder.c ****         char raw_name[GEOCODER_NAME_MAX];
 422:Core/Src/geocoder.c ****         if (!read_null_term_string(&s_f_b, (uint32_t)rec.str_offset, raw_name, sizeof(raw_name))) {
 423:Core/Src/geocoder.c ****             continue;
 424:Core/Src/geocoder.c ****         }
 425:Core/Src/geocoder.c **** 
 426:Core/Src/geocoder.c ****         char norm_town[GEOCODER_NAME_MAX];
 427:Core/Src/geocoder.c ****         geocoder_normalize_name(raw_name, norm_town, sizeof(norm_town));
 428:Core/Src/geocoder.c **** 
 429:Core/Src/geocoder.c ****         int tier = 99;
 430:Core/Src/geocoder.c ****         if (strcmp(norm_town, norm_query) == 0) {
 431:Core/Src/geocoder.c ****             tier = 1;
 432:Core/Src/geocoder.c ****         } else if (strncmp(norm_town, norm_query, q_len) == 0) {
 433:Core/Src/geocoder.c ****             tier = 2;
 434:Core/Src/geocoder.c ****         } else if (strstr(norm_town, norm_query) != NULL) {
 435:Core/Src/geocoder.c ****             tier = 3;
 436:Core/Src/geocoder.c ****         }
 437:Core/Src/geocoder.c **** 
 438:Core/Src/geocoder.c ****         if (tier < 99) {
 439:Core/Src/geocoder.c ****             uint32_t d = calc_dist_m(ref_coord.lat_e7, ref_coord.lon_e7, rec.lat_scaled, rec.lon_sc
 440:Core/Src/geocoder.c ****             if (tier < best_tier || (tier == best_tier && d < best_dist)) {
 441:Core/Src/geocoder.c ****                 best_tier = tier;
 442:Core/Src/geocoder.c ****                 best_dist = d;
 443:Core/Src/geocoder.c ****                 best_rec = rec;
ARM GAS  /tmp/cca3RsFl.s 			page 40


 444:Core/Src/geocoder.c ****                 snprintf(best_raw, sizeof(best_raw), "%s", raw_name);
 445:Core/Src/geocoder.c ****             }
 446:Core/Src/geocoder.c ****         }
 447:Core/Src/geocoder.c ****     }
 448:Core/Src/geocoder.c **** 
 449:Core/Src/geocoder.c ****     f_close(&s_f_a);
 450:Core/Src/geocoder.c ****     f_close(&s_f_b);
 451:Core/Src/geocoder.c **** 
 452:Core/Src/geocoder.c ****     if (best_tier == 99) return false;
 453:Core/Src/geocoder.c **** 
 454:Core/Src/geocoder.c ****     if (out_town_coord) {
 455:Core/Src/geocoder.c ****         out_town_coord->lat_e7 = best_rec.lat_scaled;
 456:Core/Src/geocoder.c ****         out_town_coord->lon_e7 = best_rec.lon_scaled;
 457:Core/Src/geocoder.c ****     }
 458:Core/Src/geocoder.c ****     if (out_town_name && name_size > 0) {
 459:Core/Src/geocoder.c ****         snprintf(out_town_name, name_size, "%s", best_raw);
 460:Core/Src/geocoder.c ****     }
 461:Core/Src/geocoder.c ****     return true;
 462:Core/Src/geocoder.c **** }
