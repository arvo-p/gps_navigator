 467:Core/Src/geocoder.c **** 
 468:Core/Src/geocoder.c **** /**
 469:Core/Src/geocoder.c ****  * @brief Collect candidate 1-based street_ids matching norm_street_query.
 470:Core/Src/geocoder.c ****  *        Step 1: O(log N) binary search in names.idx for exact or prefix matches.
 471:Core/Src/geocoder.c ****  *        Step 2: Substring fallback scan if neither exact nor prefix matched.
 472:Core/Src/geocoder.c ****  */
 473:Core/Src/geocoder.c **** static int32_t find_candidate_street_ids(const Geocoder *geo, const char *norm_query,
 474:Core/Src/geocoder.c ****                                          uint32_t *out_ids, int32_t max_ids) {
 475:Core/Src/geocoder.c ****     if (!geo || !norm_query || norm_query[0] == '\0') return 0;
 476:Core/Src/geocoder.c ****     if (!geocoder_ensure_counts((Geocoder *)geo) || geo->street_count == 0) return 0;
