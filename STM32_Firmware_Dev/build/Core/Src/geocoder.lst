 205:Core/Src/geocoder.c **** void geocoder_normalize_name(const char *input, char *out_buf, size_t out_size) {
 206:Core/Src/geocoder.c ****     if (!out_buf || out_size == 0) return;
 207:Core/Src/geocoder.c ****     out_buf[0] = '\0';
 208:Core/Src/geocoder.c ****     if (!input) return;
 209:Core/Src/geocoder.c **** 
 210:Core/Src/geocoder.c ****     const unsigned char *p = (const unsigned char *)input;
 211:Core/Src/geocoder.c ****     size_t idx = 0;
 212:Core/Src/geocoder.c ****     bool prev_space = true; /* Trim leading whitespace */
 213:Core/Src/geocoder.c **** 
 214:Core/Src/geocoder.c ****     while (*p != '\0' && idx + 1 < out_size) {
 215:Core/Src/geocoder.c ****         uint32_t cp = next_utf8_codepoint(&p);
 216:Core/Src/geocoder.c ****         char c = unicode_to_base_ascii(cp);
 217:Core/Src/geocoder.c ****         if (c == 0) continue;
 218:Core/Src/geocoder.c **** 
ARM GAS  /tmp/cca3RsFl.s 			page 29


 219:Core/Src/geocoder.c ****         if (c == ' ') {
 220:Core/Src/geocoder.c ****             if (!prev_space) {
 221:Core/Src/geocoder.c ****                 out_buf[idx++] = ' ';
 222:Core/Src/geocoder.c ****                 prev_space = true;
 223:Core/Src/geocoder.c ****             }
 224:Core/Src/geocoder.c ****         } else {
 225:Core/Src/geocoder.c ****             out_buf[idx++] = c;
 226:Core/Src/geocoder.c ****             prev_space = false;
 227:Core/Src/geocoder.c ****         }
 228:Core/Src/geocoder.c ****     }
 229:Core/Src/geocoder.c **** 
 230:Core/Src/geocoder.c ****     /* Strip trailing space */
 231:Core/Src/geocoder.c ****     if (idx > 0 && out_buf[idx - 1] == ' ') {
 232:Core/Src/geocoder.c ****         idx--;
 233:Core/Src/geocoder.c ****     }
 234:Core/Src/geocoder.c ****     out_buf[idx] = '\0';
 235:Core/Src/geocoder.c **** }
