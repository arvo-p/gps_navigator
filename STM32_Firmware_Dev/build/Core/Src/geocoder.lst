 332:Core/Src/geocoder.c **** bool geocoder_find_nearest_town(const Geocoder *geo, GeoCoord coord,
 333:Core/Src/geocoder.c ****                                 char *out_name, size_t out_size,
 334:Core/Src/geocoder.c ****                                 GeoCoord *out_coord, uint32_t *out_dist_m) {
 335:Core/Src/geocoder.c ****     if (!geo) return false;
 336:Core/Src/geocoder.c ****     (void)geocoder_ensure_counts((Geocoder *)geo);
 337:Core/Src/geocoder.c ****     if (geo->town_count == 0) return false;
 338:Core/Src/geocoder.c **** 
 339:Core/Src/geocoder.c ****     if (f_open(&s_f_a, geo->towns_idx_path, FA_READ) != FR_OK) return false;
 340:Core/Src/geocoder.c **** 
 341:Core/Src/geocoder.c ****     TownIndexRecord best_rec = {0};
 342:Core/Src/geocoder.c ****     uint32_t best_dist = 0xFFFFFFFFU;
 343:Core/Src/geocoder.c ****     bool found = false;
 344:Core/Src/geocoder.c **** 
 345:Core/Src/geocoder.c ****     uint32_t remaining = geo->town_count;
 346:Core/Src/geocoder.c ****     while (remaining > 0) {
 347:Core/Src/geocoder.c ****         uint32_t chunk = (remaining > 64U) ? 64U : remaining;
 348:Core/Src/geocoder.c ****         UINT br = 0;
 349:Core/Src/geocoder.c ****         if (f_read(&s_f_a, s_town_buf, (UINT)(chunk * sizeof(TownIndexRecord)), &br) != FR_OK ||
 350:Core/Src/geocoder.c ****             br != chunk * sizeof(TownIndexRecord)) {
 351:Core/Src/geocoder.c ****             break;
 352:Core/Src/geocoder.c ****         }
 353:Core/Src/geocoder.c ****         for (uint32_t i = 0; i < chunk; ++i) {
 354:Core/Src/geocoder.c ****             uint32_t d = calc_dist_m(coord.lat_e7, coord.lon_e7,
 355:Core/Src/geocoder.c ****                                      s_town_buf[i].lat_scaled, s_town_buf[i].lon_scaled);
 356:Core/Src/geocoder.c ****             if (d < best_dist) {
 357:Core/Src/geocoder.c ****                 best_dist = d;
 358:Core/Src/geocoder.c ****                 best_rec = s_town_buf[i];
 359:Core/Src/geocoder.c ****                 found = true;
 360:Core/Src/geocoder.c ****             }
 361:Core/Src/geocoder.c ****         }
 362:Core/Src/geocoder.c ****         remaining -= chunk;
 363:Core/Src/geocoder.c ****     }
 364:Core/Src/geocoder.c ****     f_close(&s_f_a);
 365:Core/Src/geocoder.c **** 
 366:Core/Src/geocoder.c ****     if (!found) return false;
 367:Core/Src/geocoder.c **** 
 368:Core/Src/geocoder.c ****     if (out_coord) {
 369:Core/Src/geocoder.c ****         out_coord->lat_e7 = best_rec.lat_scaled;
 370:Core/Src/geocoder.c ****         out_coord->lon_e7 = best_rec.lon_scaled;
 371:Core/Src/geocoder.c ****     }
 372:Core/Src/geocoder.c ****     if (out_dist_m) {
 373:Core/Src/geocoder.c ****         *out_dist_m = best_dist;
 374:Core/Src/geocoder.c ****     }
 375:Core/Src/geocoder.c ****     if (out_name && out_size > 0) {
 376:Core/Src/geocoder.c ****         if (f_open(&s_f_b, geo->towns_str_path, FA_READ) == FR_OK) {
 377:Core/Src/geocoder.c ****             read_null_term_string(&s_f_b, (uint32_t)best_rec.str_offset, out_name, out_size);
 378:Core/Src/geocoder.c ****             f_close(&s_f_b);
 379:Core/Src/geocoder.c ****         } else {
 380:Core/Src/geocoder.c ****             out_name[0] = '\0';
 381:Core/Src/geocoder.c ****         }
 382:Core/Src/geocoder.c ****     }
 383:Core/Src/geocoder.c ****     return true;
 384:Core/Src/geocoder.c **** }
