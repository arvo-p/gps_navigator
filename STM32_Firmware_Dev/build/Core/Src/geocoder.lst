 241:Core/Src/geocoder.c **** static bool read_null_term_string(FIL *f_str, uint32_t offset, char *out_buf, size_t out_size) {
 242:Core/Src/geocoder.c ****     if (!f_str || !out_buf || out_size == 0) return false;
 243:Core/Src/geocoder.c ****     if (f_lseek(f_str, (FSIZE_t)offset) != FR_OK) {
 244:Core/Src/geocoder.c ****         out_buf[0] = '\0';
 245:Core/Src/geocoder.c ****         return false;
 246:Core/Src/geocoder.c ****     }
 247:Core/Src/geocoder.c ****     UINT br = 0;
 248:Core/Src/geocoder.c ****     if (f_read(f_str, out_buf, (UINT)(out_size - 1), &br) != FR_OK || br == 0) {
 249:Core/Src/geocoder.c ****         out_buf[0] = '\0';
 250:Core/Src/geocoder.c ****         return false;
 251:Core/Src/geocoder.c ****     }
 252:Core/Src/geocoder.c ****     out_buf[br] = '\0';
 253:Core/Src/geocoder.c ****     return true;
 254:Core/Src/geocoder.c **** }
