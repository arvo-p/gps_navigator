  24:Utilities/Log/lcd_log.c ****   * in the root directory of this software component.
  25:Utilities/Log/lcd_log.c ****   * If no LICENSE file comes with this software, it is provided AS-IS.
  26:Utilities/Log/lcd_log.c ****   *
  27:Utilities/Log/lcd_log.c ****   ******************************************************************************
  28:Utilities/Log/lcd_log.c ****   */
