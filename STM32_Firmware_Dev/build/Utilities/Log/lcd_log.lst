   1:Utilities/Log/lcd_log.c **** /**
   2:Utilities/Log/lcd_log.c ****   ******************************************************************************
   3:Utilities/Log/lcd_log.c ****   * @file    lcd_log.c
   4:Utilities/Log/lcd_log.c ****   * @author  MCD Application Team
   5:Utilities/Log/lcd_log.c ****   * @brief   This file provides all the LCD Log firmware functions.
   6:Utilities/Log/lcd_log.c ****   *          
   7:Utilities/Log/lcd_log.c ****   *          The LCD Log module allows to automatically set a header and footer
   8:Utilities/Log/lcd_log.c ****   *          on any application using the LCD display and allows to dump user,
   9:Utilities/Log/lcd_log.c ****   *          debug and error messages by using the following macros: LCD_ErrLog(),
  10:Utilities/Log/lcd_log.c ****   *          LCD_UsrLog() and LCD_DbgLog().
  11:Utilities/Log/lcd_log.c ****   *         
  12:Utilities/Log/lcd_log.c ****   *          It supports also the scroll feature by embedding an internal software
  13:Utilities/Log/lcd_log.c ****   *          cache for display. This feature allows to dump message sequentially
  14:Utilities/Log/lcd_log.c ****   *          on the display even if the number of displayed lines is bigger than
  15:Utilities/Log/lcd_log.c ****   *          the total number of line allowed by the display.
  16:Utilities/Log/lcd_log.c ****   *      
  17:Utilities/Log/lcd_log.c ****   ******************************************************************************
  18:Utilities/Log/lcd_log.c ****   * @attention
  19:Utilities/Log/lcd_log.c ****   *
  20:Utilities/Log/lcd_log.c ****   * Copyright (c) 2016 STMicroelectronics.
  21:Utilities/Log/lcd_log.c ****   * All rights reserved.
  22:Utilities/Log/lcd_log.c ****   *
